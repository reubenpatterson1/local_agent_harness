#!/usr/bin/env python3
"""qwen-agent -- interactive tool-calling REPL for a locally-served Qwen model.

Single-file, standard-library-only. bash, run_python, generate_image, and any
write that would overwrite an existing file require explicit human approval;
search, read_file, fetch_url, and creating a new file are auto-approved and
traced with an [auto] line. Web lookups go through search, which queries a local
SearXNG instance. An exact repeat of a call that already failed in the same
turn is refused without running.
See docs/specs/2026-08-21-qwen-agent-tool-harness-design.md,
docs/specs/2026-08-21-qwen-agent-tiered-approval-design.md, and
docs/specs/2026-08-21-qwen-agent-search-grounding-design.md.
Also supports a one-shot programmatic mode: --user-prompt TEXT runs a single turn
and prints one JSON object to stdout (see
docs/specs/2026-08-21-qwen-agent-oneshot-api-design.md). In that mode,
--system-prompt TEXT optionally appends to the built-in system message.
"""

import argparse
import ast
import datetime
import html.parser
import json
import operator
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path

# ---------------------------------------------------------------------------
# Section 5: constants
# ---------------------------------------------------------------------------

DEFAULT_BASE_URL = "http://127.0.0.1:8177/v1"
DEFAULT_MODEL = "qwen38-6bit"
DEFAULT_WORKSPACE = "~/qwen-agent-workspace"
DEFAULT_MAX_TOKENS = 1536
DEFAULT_REQ_TIMEOUT = 600
DEFAULT_TOOL_TIMEOUT = 30
DEFAULT_MAX_ROUNDS = 10
RESULT_CHAR_LIMIT = 4000       # characters, applied to every tool result string
FETCH_BYTE_LIMIT = 2_000_000  # bytes read from the socket before hard stop
FETCH_USER_AGENT = "qwen-agent/1.0"

# Self-contained layout: this script lives at <root>/bin/qwen-agent, and the docs
# and searxng config it points the human at live beside it under <root>. realpath()
# resolves the ~/.local/bin/qwen-agent symlink to the real checkout, so every path
# printed in an error message is one that actually exists on this host. No path here
# may point at a removable volume: the harness must not depend on an external drive.
# That invariant stays grep-checkable precisely because this comment names no such path.
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
TOOL_HARNESS_SPEC = os.path.join(
    REPO_ROOT, "docs", "specs", "2026-08-21-qwen-agent-tool-harness-design.md")
SEARXNG_DIR = os.path.join(REPO_ROOT, "searxng")

WRITE_PREVIEW_LINES = 40       # lines of write_file content shown at the prompt
RULE = "-" * 60                # confirmation-prompt separator

# Tiered approval (see docs/specs/2026-08-21-qwen-agent-tiered-approval-design.md).
# Membership is by TOOL NAME ONLY. Never add bash or run_python here, and never
# add a content/keyword test for them anywhere: an injected instruction can avoid
# any trigger word while still being harmful. See that spec's Section 3.2.
AUTO_APPROVE_TOOLS = ("generate_image", "search", "fetch_url", "read_file", "delegate_to_skill", "calculate")
TRACE_KEY_CHARS = 200      # clip length for the key argument on [auto]/[duplicate] lines
TRACE_OUTCOME_CHARS = 160  # clip length for the outcome summary on the [auto] line

SKILL_SUBPROCESS_TIMEOUT = 900   # seconds; hard ceiling on one delegate_to_skill call
IMAGE_GEN_TIMEOUT = 600    # seconds; human-gated; kept short so an approved call cannot stall the REPL indefinitely -- generation should be fast once the model is cached locally, see generate_image's tool description
GENERATED_IMAGES_SUBDIR = "generated"   # workspace-relative output directory for generate_image

SKILL_TOOL_NAMES = {
    "investigator": ("search", "fetch_url", "read_file", "calculate", "delegate_to_skill"),
    "analyst":      ("search", "fetch_url", "read_file", "calculate"),
    "planner":      ("search", "fetch_url", "read_file"),
}
# INVARIANT: every name above is a member of AUTO_APPROVE_TOOLS. No skill
# subprocess can therefore ever reach the confirmation prompt. Do not add bash,
# write_file, or run_python here -- they are gated tools, a skill subprocess has
# no interactive stdin (see exec_delegate_to_skill), and the whole design of this
# feature depends on the tier of a delegated call being decidable statically.

# Which skill names delegate_to_skill's own enum permits, keyed by the CURRENT
# process's skill context (None == top level / unrestricted).
DELEGATE_TARGETS = {
    None:            ("investigator", "analyst", "planner"),
    "investigator":  ("analyst",),
}

SKILL_THINK_TEMP_DEFAULTS = {
    "investigator": {"think": True,  "temperature": 0.7},
    "planner":      {"think": True,  "temperature": 0.7},
    "analyst":      {"think": False, "temperature": 0.2},
}

# Search grounding (see docs/specs/2026-08-21-qwen-agent-search-grounding-design.md).
# SEARXNG_BASE_URL must match the published port in searxng/docker-compose.yml,
# resolved at runtime as SEARXNG_DIR. No trailing slash.
SEARXNG_BASE_URL = "http://127.0.0.1:8888"
# Check B posts the whole TOOLS array (~3-4k tokens) and waits for one token, so this
# budget must cover a cold-start prefill plus first-request graph warmup on a 27B
# 6-bit model. Raised from 60 after a measured 9.8 s warm startup left too little
# headroom. Note that no timeout can rescue a deadlocked engine -- see the
# TimeoutError branch in preflight() for what that failure looks like and why.
PREFLIGHT_PROBE_TIMEOUT = 90    # seconds, Check B tool-calling probe
SEARXNG_PROBE_TIMEOUT = 3       # seconds, non-fatal startup reachability probe
SEARCH_DEFAULT_RESULTS = 5      # results rendered when max_results is omitted
SEARCH_MAX_RESULTS = 8          # hard ceiling; see Section 4.5 for why it is 8
SEARCH_TITLE_CHARS = 100        # per-result title clip
SEARCH_URL_CHARS = 160          # per-result URL clip
SEARCH_SNIPPET_CHARS = 160      # per-result snippet clip
SEARCH_QUERY_ECHO_CHARS = 120   # clip for the query echoed in the result header
SEARCH_BYTE_LIMIT = 4_000_000   # bytes read from the SearXNG socket before hard stop

# Distinct-attempt circuit breaker and repeat reminders (same spec, Sections 5 and 7).
FAILED_CALL_CAP = 4             # distinct failed calls to ONE tool allowed per turn
REMINDER_THRESHOLDS = (3, 5, 7) # same-tool consecutive-call counts that inject a reminder

# Set by main() after startup; used throughout as the sole confinement base.
WORKSPACE = None

ONESHOT_SCHEMA = "qwen-agent.oneshot.v1"   # value of the JSON envelope's "schema" field
EXIT_ABNORMAL = 3                          # one-shot: turn ended with no final answer

DECISION_SCHEMA = "qwen-agent.decision.v1"   # value of each decision-log line's "schema" field
DECISION_LOG_NAME = "tool_decisions.log"     # workspace-relative JSON Lines tool-decision log

# True only in --prompt mode. Redirects the confirmation UI to stderr so stdout
# carries nothing but the JSON envelope. Never true in the REPL.
ONESHOT = False

# Set by main() from --skill. Recorded in the decision log so that lines written
# by a delegate_to_skill subprocess are distinguishable from the parent's.
SKILL_CONTEXT = None


def _ui():
    """Stream the confirmation UI is drawn on: stdout in the REPL, stderr in --prompt mode."""
    return sys.stderr if ONESHOT else sys.stdout


def _prompt_line(text):
    """Write an inline prompt to the UI stream and read one line from stdin.

    REPL mode keeps input() verbatim so readline editing and the existing stdout
    prompt behaviour are unchanged. One-shot mode writes to stderr and reads with
    sys.stdin.readline(), which never writes to stdout.
    Raises EOFError on end of input, matching input().
    """
    if not ONESHOT:
        return input(text)
    sys.stderr.write(text)
    sys.stderr.flush()
    line = sys.stdin.readline()
    if line == "":
        raise EOFError
    return line.rstrip("\n")


def _auth_headers(args_ns):
    """Authorization header dict if --api-key is set, else empty."""
    if args_ns.api_key:
        return {"Authorization": "Bearer %s" % args_ns.api_key}
    return {}


