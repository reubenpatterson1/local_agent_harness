#!/bin/bash
# action-train-vlm -- run an action LoRA training with the VLM stopped (training reuses
# its memory), then ALWAYS bring the VLM back. The movie-ui Actions tab's Train button
# runs this; bin/action train's story-server gate stays a safety net.
#
# Usage: action-train-vlm <python> <name>
# The VLM is restarted on success, failure, OR cancellation (SIGINT/SIGTERM).
set -u

DIR="$(cd "$(dirname "$0")" && pwd)"
SS="$DIR/story-server"

# story-server-restore starts the VLM in its own session, so a movie-ui Cancel (which kills
# every process group of this job) cannot take the restarted server down with it. On a signal
# it returns at once (the start continues detached) so the job exits inside the cancel grace.
restart_vlm() {
  echo "action-train-vlm: restarting the VLM (story-server mlx-vision)" >&2
  "$DIR/story-server-restore" mlx-vision --wait >/dev/null 2>&1 \
    || echo "action-train-vlm: WARNING: VLM restart failed; run 'bin/story-server mlx-vision'" >&2
}
on_signal() {
  trap - EXIT INT TERM
  echo "action-train-vlm: interrupted; restarting the VLM in the background" >&2
  "$DIR/story-server-restore" mlx-vision >/dev/null 2>&1
  exit 130
}
trap restart_vlm EXIT
trap on_signal INT TERM

[ "$#" -eq 2 ] || { echo "usage: action-train-vlm <python> <name>" >&2; exit 2; }
PY="$1"; shift

echo "action-train-vlm: stopping the VLM to free memory for training"
"$SS" stop >/dev/null 2>&1 || true

"$PY" "$DIR/action" train "$@"
rc=$?
echo "action-train-vlm: training exited $rc" >&2
exit "$rc"   # the EXIT trap restarts the VLM
