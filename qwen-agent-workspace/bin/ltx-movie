#!/usr/bin/env python3
"""ltx-movie -- single end-to-end orchestrator for the narrative-to-movie
pipeline: bin/qwen-agent (story authoring), bin/ltx-story-images (panel
stills), bin/ltx-story-manifest (frame-allocation manifest), and
bin/ltx-mlx-render (render). See
docs/specs/2026-08-27-narrative-movie-pipeline-design.md for the
underlying four-phase runbook this consolidates; the ronin_return story
under generated/stories/ronin_return/ is a reference execution of that
same runbook, run by hand before this wrapper existed.

None of the three wrapped phase tools (bin/ltx-story-images,
bin/ltx-story-manifest, bin/ltx-mlx-render) nor bin/qwen-agent are
modified by this script -- each remains independently runnable and
unchanged; this script only sequences them, adds a few safety gates
around the sequence, and writes to the same output paths (story.md,
images/, manifest.json, movie.mp4, movie.log) the manual runbook already
used.

Four phases and host state:
  Phase 1 (story)    -- calls bin/qwen-agent in one-shot mode; needs the
                         27B vLLM server UP (qwen-agent talks to it).
  Phase 2 (stills)    -- calls bin/ltx-story-images; needs the same server
                         stack UP (it renders through z_image_skill).
  Phase 3 (manifest)  -- calls bin/ltx-story-manifest and then
                         bin/ltx-mlx-render --dry-run; both are offline
                         and never touch the servers.
  Phase 4 (render)    -- calls bin/ltx-mlx-render for real. Unlike the old
                         bin/ltx-story-video path, this tool does NOT take
                         the vLLM/MTPLX servers down: it never imports
                         mps_guard, never runs bin/ltx-host-prep or
                         bin/ltx-host-restore, and never touches ports
                         8177/8178. One ltx-2-mlx clip per panel, stitched
                         with ffmpeg's concat demuxer under -c copy.

Three design problems this wrapper solves, on top of the (unchanged)
phase tools:
  1. Sudo keepalive -- advisory only. bin/ltx-mlx-render (the current
     render backend) never purges the page cache and never needs a sudo
     credential, so a missing one only prints a warning at startup, not a
     hard exit. If a ticket happens to be cached, a daemon thread
     refreshes it via a non-interactive `sudo -n true` every 60s for the
     life of the process (never a password-reading invocation), in case a
     future backend needs it.
  2. Review gates -- between the cheap/offline phases (1-3) and the
     expensive GPU phase (4), the operator is shown story.md and the
     frame-allocation dry-run and asked to confirm before any GPU time is
     spent; --no-review skips these for unattended runs (which then
     requires a non-interactive stdin, checked up front).
  3. Avail-memory gate -- phase 4 will not launch bin/ltx-mlx-render
     until psutil reports at least --min-avail-gib available memory. This
     encodes the 2026-08-27 lesson (docs/specs/2026-08-27-narrative-movie-
     pipeline-design.md Section 4): a batch launched at 30.4 GiB available
     failed 14/14 at the stage-2 supply gate; idle settling alone did not
     clear it -- only quitting memory-heavy apps (Chrome/Slack/Docker) did.

--length SECONDS is an alternate way to size the movie: it derives
--panels from a single number by dividing by the clip's own playback
duration, --frames / --fps (10.04s at the defaults):
panels = round(SECONDS / (frames / fps)), with a hard error below 2
panels rather than a silent clamp. --length is mutually exclusive with
--panels. --target-seconds is no longer an input -- it is computed as
panels * frames / fps and passed to bin/ltx-story-manifest only to keep
the manifest internally consistent. Because the qwen-agent story-authoring
call's --max-tokens 4096 default only ever fit ~15 panels, both its
--max-tokens and its subprocess timeout scale with the resolved panel
count: max(4096, panels*550) tokens, max(900, panels*90)s.
"""

import argparse
import glob
import importlib.machinery
import json
import os
import re
import shlex
import subprocess
import sys
import threading
import time

WS = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

# --seed-image pre-flight (Phase 0). The long-edge cap bounds the multimodal request
# payload; the minimum edge rejects a degenerate input before a 27B call or any GPU
# time is spent on it.
SEED_DOWNSCALE_MAX_EDGE = 1024
SEED_MIN_EDGE = 64

STORY_PROMPT_TEMPLATE = """You are authoring the shot list for a short narrated movie (story-id "{story_id}").

Narrative to adapt:
{narrative}

Write the complete story to generated/stories/{story_id}/story.md using the write_file tool. The file must contain EXACTLY {panels} panel sections, numbered 1 through {panels} in order, each in exactly this format:

## Panel N — <short title>
Image: <a single still-image prompt, 70-90 words, describing the panel's visual composition, setting, lighting, and lens/shot choice>
Motion: <110-160 words in the present tense -- one flowing paragraph of 7-10 sentences in strict chronological order that opens with the shot type (exactly one of: extreme wide shot, wide shot, medium shot, medium close-up, close-up, extreme close-up), the subject's short referring phrase, and the camera viewpoint (front-facing, back-facing, side view, over-the-shoulder, top-down, low-angle or high-angle), matching the shot type and viewpoint the Image: field frames the panel with and nothing else from it, then carries the camera motion (always state it; if the camera holds, say that it remains static) and the subject's motion through enough separate beats of movement to fill the full ten seconds instead of rushing the action, linked by temporal connectors ("initially", "as", "then", "while", "simultaneously", "a moment later"), with the panel's ambient and environmental sounds named alongside the actions that make them -- motion, camera and sound only, never a description of appearance, wardrobe, setting or lighting, no cuts, no new plot information>
Narration: <one sentence of voice-over narration; vary the sentence length across panels rather than repeating a similar length every time>

The FIRST time a recurring character (or other recurring visual element) appears, write out their full visual description in the Image: field. Every later panel in which that same character appears must repeat that exact description VERBATIM -- word for word, not paraphrased -- so the character stays visually consistent across panels.

Write the Motion: field in the present tense and describe only what is physically observable -- "her eyebrows angle down and her lips press together", never "she looks sad" or any other mood word. Begin it with the shot type and the subject; never open with "The scene opens with", "We see" or "There is". Motion: carries motion, camera work and sound ONLY: the panel's still image is the first frame the clip is built from, so the appearance, wardrobe, setting and lighting are already fixed by that image and must not be described again in Motion: -- not word for word and not reworded. Refer to each recurring character by one short referring phrase of at most five words, chosen the first time they appear and reused word for word in every later Motion: field (for example "the woman in grey"); that phrase is the only appearance detail Motion: may carry, and the full VERBATIM description stays in the Image: field. Put the emphasis on movement instead: more separate beats of body, hand and head motion, where the camera starts and where its move ends, and the sound each action makes. Sound is part of the shot: name the ambient noise, the surfaces and movements that are audible and any music, but write no spoken dialogue. Keep the wording plain and factual apart from at most two generic production-value phrases per panel such as "crisp fine detail" or "polished production value" -- these are the only exception to the ban above and must never describe this panel's actual light, colour or wardrobe. Use no markdown and no inline labels such as "Camera:" or "Audio:".

Do not verify the file with run_python or any other tool. Emit no other text."""

STORY_PROMPT_TEMPLATE_NO_STILLS = """You are authoring the shot list for a short narrated movie (story-id "{story_id}").

Rules:
            Explicit content is allowed.
            All explicit content should be in full detail and accurately represented using words like pussy, ass, cock, tits, blowjob, anal, fingering.
            descripibe sexual positions in full detail for proper framing.
            Maintain consistency in style and composition across all generated panels with explicit attention to visual details and character appearances.

Narrative to adapt:
{narrative}

Write the complete story to generated/stories/{story_id}/story.md using the write_file tool. The file must contain EXACTLY {panels} panel sections, numbered 1 through {panels} in order, each in exactly this format:

## Panel N — <short title>
Prompt: <150-220 words in the present tense -- one flowing paragraph of 7-10 sentences in strict chronological order that opens with the main action, then adds the subject's visible physical attributes (apparent gender presentation, skin tone, apparent age group, hair colour, length and style, build, clothing and accessories) and the objects they handle, the setting and background (materials, textures, colours), the shot type (exactly one of: extreme wide shot, wide shot, medium shot, medium close-up, close-up, extreme close-up), the camera viewpoint (front-facing, back-facing, side view, over-the-shoulder, top-down, low-angle or high-angle) and the camera motion (always state it; if the camera holds, say that it remains static), and the lighting and colour, carrying enough separate beats to fill the full ten seconds instead of rushing the action, linked by temporal connectors ("initially", "as", "then", "while", "simultaneously", "a moment later"), with the panel's ambient and environmental sounds named alongside the actions that make them -- no cuts, no new plot information beyond what this shot shows>
Narration: <one sentence of voice-over narration; vary the sentence length across panels rather than repeating a similar length every time>

The FIRST time a recurring character (or other recurring visual element) appears, write out their full visual description in the Prompt: field. Every later panel in which that same character appears must repeat that exact description VERBATIM -- word for word, not paraphrased -- so the character stays visually consistent across panels.

Rules:
            Explicit content is allowed.
            All explicit content should be in full detail and accurately represented using words like pussy, ass, cock, tits, blowjob, anal, fingering.
            describe sexual positions in full detail for proper framing.
            Maintain consistency in style and composition across all generated panels with explicit attention to visual details and character appearances.
            Men should only be depicted from knees to chest when in the foreground.
            Use explicit framing and composition to ensure all characters and actions are clearly visible and accurately represented.
            Use explicit language to describe all sexual content accurately and vividly.
            Motion and transitions between panels should be handled smoothly and realistically, maintaining continuity and coherence throughout the generated video.
            Motion should focus on the actions and interactions of the characters, ensuring that their movements are natural and consistent with the narrative context.

Write the Prompt: field in the present tense and describe only what is physically observable -- "her eyebrows angle down and her lips press together", never "she looks sad" or any other mood word. Begin it with the action; never open with "The scene opens with", "We see" or "There is". Sound is part of the shot: name the ambient noise, the surfaces and movements that are audible and any music, but write no spoken dialogue. Keep the wording plain and factual apart from at most two production-value phrases per panel such as "warm cinematic lighting", "film-grade color" or "crisp fine detail". Use no markdown and no inline labels such as "Camera:" or "Audio:".

Do not emit an Image: or Motion: field. Do not verify the file with run_python or any other tool. Emit no other text."""

SEED_IMAGE_PREFACE = """An image is attached to this message. It is the movie's literal opening frame: Panel 1's still will NOT be rendered from your text -- the attached image IS Panel 1's still, exactly as it is.

Before you write anything, look at the attached image and describe what it actually shows. Panel 1's Image: field must be a faithful, literal description of that attached image and nothing else -- its subject, pose, framing, setting, lighting, colour palette and visual style as they really appear -- not a generative prompt, not an embellishment, and not an invention. Do not add people, objects, actions or scenery that are not visible in the attached image, and do not omit the ones that are.

Panel 1's Motion: and Narration: fields are written normally, and Panel 2 onward continue the narrative as usual -- but every later panel's Image: field must stay visually consistent with what you actually observed in the attached image: the same characters, wardrobe, setting, lighting and style. The palette, lighting and rendering style are already handled for you: the Style: line described below is appended word for word to the end of every panel's image prompt by the pipeline, before the panel is rendered. The subject's identity is NOT handled that way -- it is written into each panel's own Image: field, sized to that panel's shot distance by the three bands below. So: Do NOT copy Panel 1's Image: description into the later panels, and do not carry more identity detail than that panel's shot distance can actually resolve. Materials, colour palette, lighting character and rendering style must not be described again in any Image: field after Panel 1 -- not word for word and not reworded. Writing them a second time puts the same attribute list into the image prompt twice and crowds out the shot type, camera angle and framing that are the only things making that panel different from its neighbours. Appearance is the exception, and it works the other way round: hair, skin, face, build and wardrobe are NOT in the Style: line, so each later panel writes them itself -- but only as much of them as its own shot distance can show.

Each later panel's Image: field is 45-70 words -- shorter than the 70-90 words asked for below, which applies to Panel 1 only, because the global-look words are gone and the identity words are trimmed to what the shot distance can show -- and carries that panel's own composition plus the identity its band allows, and nothing else: the shot type, the camera viewpoint and height, where the subject sits in the frame and which way it faces, the action or pose at that instant, the distance between camera and subject, and the setting and background elements in view. Write it in that order: shot type first, then camera viewpoint, then the subject's short referring phrase, then the identity detail this shot band allows, then the action and placement, then the setting. Refer to each recurring subject by one short referring phrase of at most five words -- the same phrase the Motion: fields use, chosen the first time that subject appears and reused word for word in every later Image: and Motion: field, for example "the woman in grey" or "the red car". That phrase carries the subject's continuity; the identity words its shot band allows are written after it. A later panel has exactly three fields, in this order: Image:, Motion:, Narration: -- and no Style: line.

How much of the subject's appearance a later Image: field carries is decided by that panel's shot type and by nothing else. The rule is: write only the identity a viewer could actually resolve at that distance -- and write all of it, because the Style: line does not carry appearance and this field is the only place the subject's identity is stated. Too much identity in a distant shot is a contradiction the renderer resolves by moving the camera closer, which turns a wide shot into a portrait; too little in a near shot leaves the face unspecified, and the renderer invents a different person. The three bands are:
FAR BAND -- extreme wide shot, wide shot. At most 8 identity words after the referring phrase: overall build or height, and the dominant colour of the clothing. Nothing else. No hair texture, no hair length, no skin tone, no face, no eyes, no lips, no freckles, no markings, no fabric detail.
MID BAND -- medium shot, medium close-up. 10 to 20 identity words after the referring phrase: the garments and their colours, hair colour and length, and build. No face-feature detail -- no eye colour, no lip colour, no freckles, no skin texture.
NEAR BAND -- close-up, extreme close-up. 18 to 30 identity words after the referring phrase: skin tone, markings such as freckles or scars, eye colour, lip colour, hair colour and texture, and whatever garment is visible at the neckline. This is the only band that describes a face, and it is the band where writing too little is the bigger mistake.
The mid and near counts are ranges with a floor, not ceilings to stay under: a near-band panel that names only the referring phrase renders a stranger. The identity words come out of the same 45-70 words, not on top of them: a near-band panel has almost no setting left in frame, so the words it spends on the face are the words a far-band panel spends on the street.

Panel 1, and only Panel 1, carries one extra field, written as its LAST line, after Narration:, in exactly this form:

Style: <30-55 words on a single line describing ONLY the global look that every panel of this movie shares, taken from the attached image: the colour palette, the lighting character, the materials and surface textures of the setting, and the rendering style, medium and lens character. It must name NO person and NO subject attribute -- no hair, skin, face, eyes, lips, build, age, gender or wardrobe words -- because this line is appended unchanged to EVERY panel's image prompt, including the extreme wide shots where none of those could be resolved, and a face named in a wide shot's prompt drags the camera in.>

Write the Style: line as a plain comma-separated list of attributes with no sentence subject: it is appended word for word to the end of every panel's image prompt, so it must read correctly after any panel's Image: text. It must not mention composition, framing, shot type, camera angle, viewpoint, pose, action, or where anything sits in the frame -- those change from panel to panel and each panel's own Image: field sets them. It must not mention the subject either -- who they are, their hair, skin, face, build, age, gender or clothing -- because those change in renderability from panel to panel, and each panel's own Image: field sets them, at its band's level of detail. Emit the Style: line exactly once, in Panel 1, and never in any other panel. The pipeline reads that line from Panel 1 alone, so a Style: line written under Panel 2 or later is dead text that is never read.

This replaces the verbatim-repetition rule below for everything that is visible in the attached image: describe those elements once, in Panel 1's Image: field, put the global look -- and nothing about the subject -- into the Style: line, and do not repeat Panel 1's wording in later panels. Later panels do state the subject's appearance again, in their own words and only as much of it as their shot band allows. The verbatim-repetition rule below still applies to any NEW recurring character or visual element you introduce later that is not visible in the attached image."""

SEED_IMAGE_POSTFACE = """Two of the rules above are overridden for this movie, because an image is attached and Panel 1's still IS that image:

1. The VERBATIM-repetition rule applies only to a new recurring character or element you introduce later that is NOT visible in the attached image. For everything that IS visible in it, the global look -- colour palette, lighting character, setting materials and textures, rendering style -- goes once into Panel 1's Style: line and is never described again -- not word for word and not reworded. No Image: field after Panel 1 may carry colour-palette, lighting-character or rendering-style words. The subject's appearance is NOT in the Style: line, so every later Image: field must state it: each names its subject with the short referring phrase and then adds the identity its shot band calls for -- far band (extreme wide shot, wide shot): at most 8 identity words, build and dominant clothing colour only, no face, no hair texture, no skin tone; mid band (medium shot, medium close-up): 10 to 20 identity words, garments and their colours, hair colour and length, build, and no face-feature detail; near band (close-up, extreme close-up): 18 to 30 identity words, and it is the only band that may describe a face. The mid and near counts have a floor: a close-up that names only the referring phrase renders a different person, because nothing else in the prompt says who this is.
2. The 70-90 word length applies to Panel 1's Image: field. Every later panel's Image: field is 45-70 words: composition first, then only the identity detail its shot band allows, in this order: shot type, camera viewpoint and height, the subject's referring phrase, the band's identity words, the action and placement in frame, the setting and background.

Panel 1 has four fields, in this order: Image:, Motion:, Narration:, Style:. Every other panel has exactly three, in this order: Image:, Motion:, Narration: -- and no Style: line.

Do not verify the file with run_python or any other tool. Emit no other text."""


def build_story_prompt(narrative, story_id, panels, no_stills=False, seed_image=False):
    template = STORY_PROMPT_TEMPLATE_NO_STILLS if no_stills else STORY_PROMPT_TEMPLATE
    rendered = template.format(narrative=narrative, story_id=story_id, panels=panels)
    if seed_image and not no_stills:
        # The postface goes AFTER the rendered template on purpose. The template's
        # VERBATIM-repetition rule and its 70-90 word Image: budget are concrete and
        # imperative; a preface-only override of them sits ~1000 words upstream and lost
        # to them in the 2026-09-13 drift_red_test run, where every later panel re-typed
        # the full appearance list. Restating the two overrides last is the fix.
        return SEED_IMAGE_PREFACE + "\n\n" + rendered + "\n\n" + SEED_IMAGE_POSTFACE
    return rendered


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ltx-movie",
        description=(
            "End-to-end orchestrator for the narrative-to-movie pipeline: story "
            "authoring (bin/qwen-agent), panel stills (bin/ltx-story-images), "
            "manifest + render dry-run (bin/ltx-story-manifest, "
            "bin/ltx-mlx-render --dry-run), and render (bin/ltx-mlx-render). "
            "The three wrapped phase tools are unchanged and remain individually "
            "usable."
        ),
    )
    parser.add_argument("narrative", help="the story narrative to adapt into panels")
    parser.add_argument("--story-id", dest="story_id", required=True)
    parser.add_argument("--seed-image", dest="seed_image", default=None,
                         help="image that becomes the movie's literal opening frame: "
                              "Phase 0 attaches a downscaled copy to the Phase 1 story "
                              "prompt, and Phase 2 crops the ORIGINAL to panel_01.png. "
                              "Incompatible with --no-stills.")
    parser.add_argument("--panels", type=int, default=15,
                         help="one still AND one video clip per panel; mutually "
                              "exclusive with --length")
    parser.add_argument("--length", type=float, default=None,
                         help="total movie length in seconds; mutually exclusive with "
                              "--panels. Resolved as round(length / (frames / fps)) -- "
                              "10.04s per panel at the defaults.")
    parser.add_argument("--fps", type=int, default=24)
    parser.add_argument("--frames", type=int, default=241,
                         help="flat per-panel frame count; must satisfy (n-1)%%8==0 and "
                              "n>=9. 241 frames @ 24 fps = 10.04s per clip.")
    parser.add_argument("--image-width", dest="image_width", type=int, default=1280)
    parser.add_argument("--image-height", dest="image_height", type=int, default=704)
    parser.add_argument("--image-seed", dest="image_seed", type=int, default=0)
    parser.add_argument("--video-width", dest="video_width", type=int, default=704)
    parser.add_argument("--video-height", dest="video_height", type=int, default=448)
    parser.add_argument("--model", default="MLXBits/ltx-2.3-10eros-v1.2-dmd-mlx-q8")
    parser.add_argument("--no-low-ram", dest="no_low_ram", action="store_true",
                         default=False,
                         help="ltx-2-mlx --low-ram is ON by default on this 48 GiB host; "
                              "this opts out. --low-ram is a weight-residency change, not "
                              "an algorithmic one: it costs wall-clock and nothing else.")
    parser.add_argument("--tile-frames", dest="tile_frames", type=int, default=1,
                         help="escape hatch only: modality tiling denoises tiles "
                              "independently and blends them back, which CHANGES the "
                              "output and can produce seams.")
    parser.add_argument("--tile-spatial", dest="tile_spatial", type=int, default=1,
                         help="escape hatch only; see --tile-frames.")
    parser.add_argument("--panel-timeout", dest="panel_timeout", type=int, default=7200)
    parser.add_argument("--no-stills", dest="no_stills", action="store_true", default=False,
                         help="text-to-video mode: skip Phase 2 entirely (no anchor "
                              "stills are generated), author story.md with a collapsed "
                              "Prompt: field, and render every panel as plain "
                              "text-to-video with no conditioning image. Hard cuts "
                              "between panels; no continuity, no chaining.")
    parser.add_argument("--no-review", dest="no_review", action="store_true", default=False)
    parser.add_argument("--force-story", dest="force_story", action="store_true", default=False)
    parser.add_argument("--force", action="store_true", default=False)
    parser.add_argument("--min-avail-gib", dest="min_avail_gib", type=float, default=25.0)
    parser.add_argument("--avail-timeout", dest="avail_timeout", type=int, default=1800)
    parser.add_argument("--dry-run", dest="dry_run", action="store_true", default=False)
    return parser


def _flag_explicit(raw_argv, flag):
    return any(a == flag or a.startswith(flag + "=") for a in raw_argv)


def _resolve_length(args, raw_argv):
    """If --length was given, resolve it into args.panels (mutating args in
    place) and validate it. No-op when --length is None. Exits the process
    (code 2) on any validation failure.

    The divisor is args.frames / args.fps -- the clip's own playback
    duration, 10.0417s at the defaults -- NOT the old hardcoded 2.0s chunk.
    Without that change --length 60 would silently render a 300-second
    movie. There is no upper bound on --length any more: the concat demuxer
    streams, so the old CONCAT_FRAME_SAFETY_CAP has no successor."""
    if args.length is None:
        return

    if _flag_explicit(raw_argv, "--panels"):
        print("Error: --length is mutually exclusive with --panels", file=sys.stderr)
        sys.exit(2)

    seconds_per_panel = args.frames / args.fps
    resolved = round(args.length / seconds_per_panel)
    if resolved < 2:
        print("Error: --length %.1f at %.2fs per panel (--frames %d @ --fps %d) resolves "
              "to %d panel(s); the minimum is 2. Raise --length or pass --panels directly."
              % (args.length, seconds_per_panel, args.frames, args.fps, resolved),
              file=sys.stderr)
        sys.exit(2)

    # No max(2, ...) clamp: the check above already guarantees resolved >= 2,
    # and silently clamping would contradict the error it just declined to
    # raise.
    args.panels = resolved


def _target_seconds(args):
    """--target-seconds is no longer an input. With a flat per-panel frame
    count it is not a control any more, so it is COMPUTED and passed to
    bin/ltx-story-manifest purely to keep the manifest internally
    consistent with what actually gets rendered."""
    return args.panels * args.frames / args.fps


def _render_flags(args):
    """The bin/ltx-mlx-render flags shared by the Phase 3 dry-run and the
    Phase 4 render. Both build their command from THIS ONE helper so the
    preview can never disagree with the render it previews.

    --resume is always on: a 15-panel run is measured in hours, and without
    it any interruption costs the entire run. --resume and --force are
    orthogonal -- --force only ever means "overwrite movie.mp4"."""
    flags = ["--frames", str(args.frames),
             "--width", str(args.video_width),
             "--height", str(args.video_height),
             "--frame-rate", str(args.fps),
             "--model", args.model,
             "--tile-frames", str(args.tile_frames),
             "--tile-spatial", str(args.tile_spatial)]
    if args.no_low_ram:
        flags.append("--no-low-ram")
    flags.append("--resume")
    if args.force:
        flags.append("--force")
    return flags


def _phase4_flags(args):
    """Phase 4 = the shared flags plus the failure policy bin/ltx-movie has
    always used (skip + one retry + a 3-consecutive circuit breaker), plus
    --force when bin/ltx-movie --force was given."""
    flags = _render_flags(args) + [
        "--panel-timeout", str(args.panel_timeout),
        "--on-panel-failure", "skip",
        "--retry-failed", "1",
        "--retry-idle", "120",
        "--max-consecutive-failures", "3"]
    return flags


def _phase1_max_tokens(panels):
    # 4096 only ever fit ~15 panels (~2500 tokens); scale for larger casts. 550/panel covers the 150-220-word Prompt: / 110-160-word Motion: caption plus Image: and Narration:.
    return max(4096, panels * 550)


def _phase1_timeout(panels):
    return max(900, panels * 90)


def _story_dir(story_id):
    return os.path.join(WS, "generated", "stories", story_id)


def _story_paths(story_id):
    story_dir = _story_dir(story_id)
    return {
        "story_dir": story_dir,
        "story_md": os.path.join(story_dir, "story.md"),
        "images_dir": os.path.join(story_dir, "images"),
        "manifest_path": os.path.join(story_dir, "manifest.json"),
        "movie_path": os.path.join(story_dir, "movie.mp4"),
        "movie_log_path": os.path.join(story_dir, "movie.log"),
        "lock_path": os.path.join(story_dir, ".movie.lock"),
        "seed_downscaled": os.path.join(story_dir, "seed_downscaled.png"),
    }


# ---------------------------------------------------------------------------
# lockfile
# ---------------------------------------------------------------------------

def _pid_alive(pid):
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def _lock_state(lock_path):
    """Return ("absent", None), ("active", pid), or ("stale", pid)."""
    if not os.path.exists(lock_path):
        return ("absent", None)
    try:
        with open(lock_path) as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        return ("stale", None)
    if _pid_alive(pid):
        return ("active", pid)
    return ("stale", pid)


# ---------------------------------------------------------------------------
# story.md validation
# ---------------------------------------------------------------------------

def _validate_story_md(story_md_path, expected_panels, no_stills=False, require_style=False):
    """Load bin/ltx-story-manifest via SourceFileLoader and validate
    story_md_path against it: exactly expected_panels panels, each with a
    non-empty Image:/Motion:/Narration: field -- or, under no_stills, a
    non-empty Prompt:/Narration: field and neither Image: nor Motion:.
    Returns a list of violation strings (empty list == valid).

    require_style additionally demands a non-empty Style: field on panel 1 --
    set only for a --seed-image run, whose Phase 2 carries the reference's
    identity forward from that field.
    """
    violations = []
    manifest_tool_path = os.path.join(WS, "bin", "ltx-story-manifest")
    try:
        story_manifest = importlib.machinery.SourceFileLoader(
            "ltx_story_manifest_for_movie", manifest_tool_path
        ).load_module()
        _narrative, panels = story_manifest._parse_prompts_md(story_md_path)
    except OSError as e:
        return ["cannot read story.md: %s" % e]

    if len(panels) != expected_panels:
        violations.append(
            "expected exactly %d panels, found %d" % (expected_panels, len(panels))
        )

    for p in panels:
        num = p["number"]
        if no_stills:
            for label, key in (("Prompt", "prompt"), ("Narration", "narration")):
                if not p[key].strip():
                    violations.append("panel %d: missing/empty %s: field" % (num, label))
            if p["prompt"].strip() and (p["image"].strip() or p["motion"].strip()):
                violations.append(
                    "panel %d: has both Prompt: and Image:/Motion: fields; "
                    "--no-stills expects Prompt: only" % num
                )
        else:
            for label, key in (("Image", "image"), ("Motion", "motion"),
                               ("Narration", "narration")):
                if not p[key].strip():
                    violations.append("panel %d: missing/empty %s: field" % (num, label))

    # A seeded run's whole grounding mechanism after panel 1 is Phase 2 appending
    # panel 1's Style: text to every panel prompt. Without the field the run would
    # silently fall back to the drift-prone paraphrase-per-panel behaviour this
    # replaced, so fail loudly: story.md is kept, and one hand-edited line fixes it.
    if require_style and panels and not panels[0].get("style", "").strip():
        violations.append(
            "panel 1: missing/empty Style: field, which --seed-image requires -- add one "
            "line to panel 1 after Narration:, naming only the global look: colour palette, "
            "lighting character, setting materials and textures, and rendering style, medium "
            "and lens character (no composition or camera words, and no subject, hair, skin, "
            "face, build or wardrobe words)"
        )

    return violations


# Glue words dropped before comparing a panel's Image: text with Panel 1's Style:
# text. Deliberately minimal: the Style: line is a bare comma-separated attribute
# list, so nearly every word in it is signal, and a longer stop-list would only
# shrink an already 4-vs-15-vs-34 separation (see the docstring below).
_ECHO_STOPWORDS = frozenset(
    "and are its that the their they them this with without".split()
)

# A later panel is flagged when it recovers more than half of Panel 1's Style:
# words AND at least _ECHO_MIN_OVERLAP of them. Both conditions, so a very short
# Style: line cannot be tripped by a handful of incidental matches. Stories whose
# Style: line has fewer than _ECHO_MIN_STYLE_WORDS content words are not checked
# at all.
_ECHO_MIN_STYLE_WORDS = 12
_ECHO_MIN_OVERLAP = 12
_ECHO_FRACTION = 0.5


def _content_words(text):
    """Lowercased alphabetic words of 3+ characters, minus _ECHO_STOPWORDS."""
    return set(
        w for w in re.findall(r"[a-z]+", text.lower())
        if len(w) > 2 and w not in _ECHO_STOPWORDS
    )


def _load_story_panels(story_md_path):
    """Panel dicts from story_md_path via bin/ltx-story-manifest's parser, or []
    when the file cannot be read.

    Deliberately separate from _validate_story_md rather than a second return
    value from it: that function's return contract is "the list of FATAL
    violations" and three checks pin its signature, while this feeds an advisory
    warning that must never change a return code.
    """
    manifest_tool_path = os.path.join(WS, "bin", "ltx-story-manifest")
    try:
        story_manifest = importlib.machinery.SourceFileLoader(
            "ltx_story_manifest_for_movie", manifest_tool_path
        ).load_module()
        _narrative, panels = story_manifest._parse_prompts_md(story_md_path)
    except OSError:
        return []
    return panels


def _style_echo_warnings(panels):
    """Advisory warnings about a seeded story.md, as a list of strings ([] == clean).

    Two things are reported, neither of them fatal:

    1. A panel after the first whose Image: field re-states the appearance that
       Panel 1's Style: line already carries. Phase 2 appends the Style: text to
       every panel's image prompt mechanically, so restating it puts the same
       attribute list in the prompt twice and crowds out the shot type, camera
       angle and framing -- which is exactly how the 2026-09-13 drift_red_test
       run ended up rendering "extreme wide shot ... receding into the distance"
       as a close-up portrait. Measured on that run, later panels recovered 34-37
       of Panel 1's 42 Style: words against a threshold of 22; a compliant
       composition-only panel recovers about 4 of 29 against a threshold of 15.
       Panel 1 is exempt: it is the literal description of the reference image,
       so a near-total Style: overlap there is correct.
    2. A Style: line under any panel but the first. Harmless -- the pipeline
       reads Panel 1's alone -- but it means the prompt's once-only rule did not
       land, which is worth seeing.

    This is a warning and not a _validate_story_md violation on purpose: item 1
    is a word-overlap heuristic, violations are fatal with no override flag, and
    a false positive must not be able to strand a legitimate story behind a word
    counter.
    """
    if not panels:
        return []

    warnings = []
    style_words = _content_words(panels[0].get("style", ""))
    if len(style_words) >= _ECHO_MIN_STYLE_WORDS:
        threshold = max(_ECHO_MIN_OVERLAP,
                        int(_ECHO_FRACTION * len(style_words)) + 1)
        for p in panels[1:]:
            shared = _content_words(p.get("image", "")) & style_words
            if len(shared) >= threshold:
                warnings.append(
                    "panel %s: Image: restates %d of Panel 1's %d Style: attribute words "
                    "(%s ...) -- the Style: text is appended to every panel's image prompt "
                    "automatically, so repeating appearance here doubles it and crowds out "
                    "this panel's shot type, camera angle and framing"
                    % (p.get("number"), len(shared), len(style_words),
                       ", ".join(sorted(shared)[:8]))
                )

    stray = [str(p.get("number")) for p in panels[1:] if p.get("style", "").strip()]
    if stray:
        warnings.append(
            "panels %s: carry a Style: line; only Panel 1's is read, so these are ignored "
            "-- harmless, but it means the story prompt's once-only rule did not land"
            % ", ".join(stray)
        )

    return warnings


# Subject-attribute tokens that must not appear in Panel 1's Style: line. The
# Style: text is appended unchanged to EVERY panel's image prompt (see
# bin/ltx-story-images _compose_prompt), so a face-level word in it is asserted
# over an extreme wide shot too, and the renderer reconciles the contradiction by
# moving the camera in -- the 2026-09-13 defect this list guards. Matched through
# _content_words, so the list is lowercase, alphabetic and 3+ characters, and
# matching is case- and punctuation-insensitive. Materials, palette, lighting and
# rendering-style words are deliberately absent: those ARE Style: content.
_STYLE_BANNED_TOKENS = frozenset("""
hair haired hairs hairline bald balding bangs fringe braid braided braids bun curls
curled curly ponytail dreadlocks updo
face faced facial cheek cheeks cheekbones chin jaw jawline brow brows eyebrow eyebrows
eyelash eyelashes eye eyes nose nostrils lip lips mouth teeth freckle freckles dimples
skin skinned complexion freckled blemish blemishes pores wrinkles scar stubble beard moustache
body build built physique figure muscular slender slim stocky athletic curvy petite tall
shoulders waist hips torso arms legs hands fingers neck
woman women man men girl boy person people young elderly aged teenage
wearing wears worn dressed clothing clothes wardrobe outfit garment garments shirt blouse
dress jacket coat trousers jeans skirt sweater
""".split())


def _style_content_warnings(panels):
    """Advisory warning about Panel 1's Style: line naming subject attributes.

    Returns [] or a single-element list; never raises, never fatal.

    The Style: line is the one piece of text bin/ltx-story-images appends to every
    panel's prompt unchanged, so it is the only place in the story where a word is
    asserted over every shot distance at once. Identity is distance-dependent --
    freckles and lip colour cannot be rendered on a forty-pixel-tall subject -- so a
    Style: line naming them contradicts every wide shot in the movie, and the
    renderer resolves that by closing the distance. Measured on the 2026-09-13
    reference Style: line, 8 of its content words are subject attributes; a
    compliant global-look line (palette, lighting, materials, render style) scores
    0 of 36.

    Advisory and not a _validate_story_md violation, for the same reason as
    _style_echo_warnings: violations are fatal with no override flag, and a token
    list must never be able to strand a legitimate story behind a word match.
    """
    if not panels:
        return []
    hits = sorted(_content_words(panels[0].get("style", "")) & _STYLE_BANNED_TOKENS)
    if not hits:
        return []
    return [
        "panel 1: Style: names %d subject-level attribute word(s) (%s) -- the Style: text is "
        "appended unchanged to EVERY panel's image prompt, including the extreme wide shots "
        "where a face cannot be resolved, so appearance words here fight each wide panel's own "
        "shot type and pull the camera in; move them into the Image: fields of the panels whose "
        "shot band can actually show them"
        % (len(hits), ", ".join(hits))
    ]


# ---------------------------------------------------------------------------
# sudo keepalive
# ---------------------------------------------------------------------------

def _check_sudo_and_start_keepalive():
    """Best-effort only: bin/ltx-mlx-render (the current render backend)
    never purges the page cache and never needs a sudo credential, so a
    missing one is a warning, not a hard failure. If a ticket IS cached,
    start a daemon thread that refreshes it every 60s for the life of the
    process, in case a future backend needs it. Always returns None."""
    rc = subprocess.run(
        ["sudo", "-n", "true"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    ).returncode
    if rc != 0:
        print("WARNING: no cached sudo credential (harmless: the current "
              "render backend, bin/ltx-mlx-render, never needs one).",
              file=sys.stderr)
        return None
    _start_sudo_keepalive_thread()
    return None


def _start_sudo_keepalive_thread():
    warned = [False]

    def _loop():
        while True:
            time.sleep(60)
            # Refresh the cached credential the same way as the initial
            # check above: `sudo -n true` (non-interactive; must never
            # read a password for the whole life of the process).
            rc = subprocess.run(
                ["sudo", "-n", "true"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            ).returncode
            if rc != 0 and not warned[0]:
                warned[0] = True
                print("WARNING: sudo credential refresh failed; harmless, nothing in "
                      "the current render backend depends on it.", file=sys.stderr)

    t = threading.Thread(target=_loop, daemon=True)
    t.start()
    return t


# ---------------------------------------------------------------------------
# phase 0: seed image pre-flight
# ---------------------------------------------------------------------------

def _crop_to_fill(img, width, height):
    """Scale img to FILL width x height, then center-crop to exactly that size.

    Verbatim reproduction of bin/ltx-story-images's _resize_center_crop: one uniform
    scale factor on both axes (max of the two ratios), so nothing is stretched, and the
    crop is centred, so nothing is letterboxed. Kept as a separate copy rather than an
    import across the two files -- each phase tool remains independently runnable.
    Returns a new image; img is not modified.
    """
    from PIL import Image
    src_w, src_h = img.size
    scale = max(width / float(src_w), height / float(src_h))
    new_w = max(width, int(round(src_w * scale)))
    new_h = max(height, int(round(src_h * scale)))
    resized = img.resize((new_w, new_h), Image.Resampling.LANCZOS)
    left = (new_w - width) // 2
    top = (new_h - height) // 2
    return resized.crop((left, top, left + width, top + height))


def _downscale_seed_image(seed_path, out_path, target_width, target_height):
    """Validate seed_path and write a PNG copy cropped-to-fill target_width x
    target_height (matching Phase 2's panel_01.png framing exactly), then downscaled
    so its long edge is <= SEED_DOWNSCALE_MAX_EDGE.

    Phase 1's multimodal call must see precisely the framing that becomes panel_01.png,
    not the full original photo: bin/ltx-story-images's _write_seed_panel scale-to-fills
    and center-crops the ORIGINAL seed file to --image-width x --image-height, discarding
    content on two edges unless the source is already that exact aspect ratio. Cropping
    here first, before the long-edge downscale, keeps the model-visible copy's aspect
    ratio identical to panel_01.png's at every step -- only the absolute pixel size
    differs, to bound the multimodal request payload.

    Returns a list of violation strings (empty == ok), matching _validate_story_md's
    convention. PIL is imported here rather than at module scope: every offline test and
    every --dry-run in this file must keep working with no third-party package present.
    """
    if not os.path.isfile(seed_path):
        return ["--seed-image not found: %s" % seed_path]
    try:
        from PIL import Image
    except ImportError as e:
        return ["--seed-image needs Pillow, which is not importable: %s" % e]
    try:
        with Image.open(seed_path) as img:
            img.load()
            rgb = img.convert("RGB")
    except Exception as e:
        return ["--seed-image is not a readable image: %s: %s" % (type(e).__name__, e)]
    w, h = rgb.size
    if min(w, h) < SEED_MIN_EDGE:
        return ["--seed-image is degenerate: %dx%d (each edge must be at least %d px)"
                % (w, h, SEED_MIN_EDGE)]
    rgb = _crop_to_fill(rgb, target_width, target_height)
    long_edge = max(target_width, target_height)
    if long_edge > SEED_DOWNSCALE_MAX_EDGE:
        scale = SEED_DOWNSCALE_MAX_EDGE / float(long_edge)
        rgb = rgb.resize((max(1, int(round(target_width * scale))),
                          max(1, int(round(target_height * scale)))),
                         Image.Resampling.LANCZOS)
    try:
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        rgb.save(out_path, format="PNG")
    except OSError as e:
        return ["cannot write the downscaled seed copy to %s: %s" % (out_path, e)]
    return []


def phase0_seed(args):
    """Pre-flight --seed-image and write the downscaled PNG that Phase 1 attaches.

    Runs before the 27B call and before any GPU time: a missing, corrupt or degenerate
    seed must fail here, not halfway through a run. The downscaled copy bounds the
    multimodal payload; Phase 2 works from the ORIGINAL file, never from this copy.
    """
    paths = _story_paths(args.story_id)
    print("=== Phase 0: seed image ===")
    violations = _downscale_seed_image(args.seed_image, paths["seed_downscaled"],
                                        args.image_width, args.image_height)
    if violations:
        for v in violations:
            print("Error: %s" % v, file=sys.stderr)
        return 2
    args.seed_downscaled_path = paths["seed_downscaled"]
    print("seed image OK: %s -> %s (long edge <= %dpx, attached to the Phase 1 request)"
          % (args.seed_image, paths["seed_downscaled"], SEED_DOWNSCALE_MAX_EDGE))
    return 0


# ---------------------------------------------------------------------------
# phase 1: story
# ---------------------------------------------------------------------------

def phase1_story(args):
    paths = _story_paths(args.story_id)
    story_md = paths["story_md"]

    if os.path.exists(story_md) and not args.force_story:
        print("note: %s already exists; skipping Phase 1 (pass --force-story to regenerate)"
              % story_md)
    else:
        print("=== Phase 1: story ===")
        prompt = build_story_prompt(args.narrative, args.story_id, args.panels, args.no_stills,
                                     bool(getattr(args, "seed_image", None)))
        max_tokens = _phase1_max_tokens(args.panels)
        timeout = _phase1_timeout(args.panels)
        cmd = [sys.executable, os.path.join(WS, "bin", "qwen-agent"),
               "--workspace", WS,
               "--max-tokens", str(max_tokens), "--max-rounds", "4",
               "--request-timeout", "600"]
        if getattr(args, "seed_downscaled_path", None):
            cmd += ["--image", args.seed_downscaled_path]
        cmd += ["--user-prompt", prompt]
        print("Running (timeout %ds): %s" % (
            timeout, shlex.join(cmd[:-1] + ["--user-prompt", "<%d chars>" % len(prompt)])
        ))

        proc = subprocess.Popen(cmd, cwd=WS, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True)
        try:
            out, _ = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            proc.kill()
            out, _ = proc.communicate()
            tail = "\n".join((out or "").splitlines()[-40:])
            print("Error: qwen-agent timed out after %ds writing story.md (known hang mode: "
                  "attempting to self-verify, which the prompt forbids); log tail:\n%s"
                  % (timeout, tail), file=sys.stderr)
            return 1
        if proc.returncode != 0:
            tail = "\n".join((out or "").splitlines()[-40:])
            if os.path.isfile(story_md):
                # qwen-agent can finish writing story.md and STILL exit
                # nonzero (e.g. it hits its round/tool limit after the
                # write -- observed 2026-08-27, story sisters_sorrow: 30
                # valid panels on disk, rc != 0, and this branch killed the
                # run). The file on disk, validated below, is the evidence
                # that matters; the exit code is not. Same lesson as
                # qwen-serve-guard's restart rc: never trust an exit code
                # over a direct check of the outcome.
                print("Warning: qwen-agent exited %d but story.md exists -- "
                      "validating the file instead of failing. Log tail:\n%s"
                      % (proc.returncode, tail))
            else:
                print("Error: qwen-agent exited %d while authoring story.md\n%s"
                      % (proc.returncode, tail), file=sys.stderr)
                return 1

    require_style = bool(getattr(args, "seed_image", None)) and not args.no_stills
    violations = _validate_story_md(story_md, args.panels, args.no_stills, require_style)
    if violations:
        print("Error: story.md failed validation:", file=sys.stderr)
        for v in violations:
            print("  - %s" % v, file=sys.stderr)
        print("Hand-edit %s to fix the violations above and rerun; story.md already exists "
              "so Phase 1 will be skipped next time (pass --force-story to regenerate it "
              "instead)." % story_md, file=sys.stderr)
        return 1

    if not args.no_review:
        with open(story_md) as f:
            content = f.read()
        print("=== story.md ===")
        print(content)

    # Advisory only -- never changes the return code (see _style_echo_warnings).
    # Printed after the story dump so a human reviewing it sees these immediately
    # above the prompt they are about to answer, and printed under --no-review too
    # so they land in movie.log. The content warning goes first: a Style: line that
    # names the subject is the upstream cause, the per-panel echo is the symptom.
    # _load_story_panels is deliberately called twice rather than hoisted -- the
    # hoist would churn the exact-text guards L37a/L37b for one markdown re-read.
    for warning in _style_content_warnings(_load_story_panels(story_md)):
        print("Warning: %s" % warning)
    for warning in _style_echo_warnings(_load_story_panels(story_md)):
        print("Warning: %s" % warning)

    if not args.no_review:
        input("Review story.md above. Enter to continue, Ctrl-C to abort: ")

    return 0


# ---------------------------------------------------------------------------
# phase 2: stills
# ---------------------------------------------------------------------------

def phase2_stills(args):
    paths = _story_paths(args.story_id)
    print("=== Phase 2: stills ===")
    cmd = [sys.executable, os.path.join(WS, "bin", "ltx-story-images"),
           "--story-md", paths["story_md"], "--out-dir", paths["images_dir"],
           "--width", str(args.image_width), "--height", str(args.image_height),
           "--seed", str(args.image_seed)]
    if getattr(args, "seed_image", None):
        cmd += ["--seed-image", args.seed_image]
    print("Running: %s" % shlex.join(cmd))
    proc = subprocess.run(cmd, cwd=WS)
    if proc.returncode != 0:
        images_json = os.path.join(paths["images_dir"], "images.json")
        print("Error: ltx-story-images exited %d; see %s for which panels failed/were blocked"
              % (proc.returncode, images_json), file=sys.stderr)
        return 1
    return 0


# ---------------------------------------------------------------------------
# phase 3: manifest + dry-run
# ---------------------------------------------------------------------------

def phase3_manifest(args):
    paths = _story_paths(args.story_id)
    print("=== Phase 3: manifest + dry-run ===")

    cmd_manifest = [sys.executable, os.path.join(WS, "bin", "ltx-story-manifest"),
                     "--story-id", args.story_id, "--prompts-md", paths["story_md"]]
    if args.no_stills:
        cmd_manifest += ["--no-images"]
    else:
        cmd_manifest += ["--glob", "panel_*.png", "--images-dir", paths["images_dir"]]
    cmd_manifest += ["--fps", str(args.fps),
                     "--target-seconds", str(_target_seconds(args)),
                     "--min-frames", str(args.frames),
                     "--max-frames", str(args.frames),
                     "--force"]
    print("Running: %s" % shlex.join(cmd_manifest))
    proc = subprocess.run(cmd_manifest, cwd=WS)
    if proc.returncode != 0:
        print("Error: ltx-story-manifest exited %d" % proc.returncode, file=sys.stderr)
        return 1

    cmd_dryrun = [sys.executable, os.path.join(WS, "bin", "ltx-mlx-render"),
                  paths["manifest_path"], paths["movie_path"]] + _render_flags(args) \
                 + ["--dry-run"]
    print("Running: %s" % shlex.join(cmd_dryrun))
    proc = subprocess.run(cmd_dryrun, cwd=WS)
    if proc.returncode != 0:
        print("Error: ltx-mlx-render --dry-run exited %d" % proc.returncode, file=sys.stderr)
        return 1

    if not args.no_review:
        input("Review the plan and the estimated render time above. Enter to render, "
              "Ctrl-C to abort: ")

    return 0


# ---------------------------------------------------------------------------
# phase 4: render
# ---------------------------------------------------------------------------

def _top5_rss():
    import psutil
    procs = []
    for p in psutil.process_iter(["name", "memory_info"]):
        try:
            mem_info = p.info["memory_info"]
            if mem_info is None:
                continue
            rss_gib = mem_info.rss / (2 ** 30)
            procs.append((p.info["name"] or str(p.pid), rss_gib))
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue
    procs.sort(key=lambda item: item[1], reverse=True)
    return procs[:5]


def _wait_for_avail(min_avail_gib, avail_timeout):
    import psutil
    start = time.monotonic()
    last_print = None
    while True:
        avail_gib = psutil.virtual_memory().available / (2 ** 30)
        if avail_gib >= min_avail_gib:
            return True
        now = time.monotonic()
        elapsed = now - start
        if last_print is None or now - last_print >= 120:
            last_print = now
            print("avail %.2f GiB (< %.2f GiB required, %.0fs elapsed); top-5 RSS processes:"
                  % (avail_gib, min_avail_gib, elapsed))
            for name, rss_gib in _top5_rss():
                print("  %-30s %.2f GiB" % (name, rss_gib))
            print("hint: quit Chrome/Slack/Docker to free memory")
        if elapsed >= avail_timeout:
            print("Error: avail memory did not reach %.2f GiB within %ds (last reading %.2f GiB)"
                  % (min_avail_gib, avail_timeout, avail_gib), file=sys.stderr)
            return False
        time.sleep(5)


def _stream_and_tee(cmd, log_path):
    with open(log_path, "w") as logf:
        proc = subprocess.Popen(cmd, cwd=WS, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True, bufsize=1)
        for line in proc.stdout:
            sys.stdout.write(line)
            logf.write(line)
            logf.flush()
        proc.wait()
        return proc.returncode


def _report_summary(args, movie_path, story_dir):
    matches = glob.glob(os.path.join(story_dir, "runs", "*", "story_summary.json"))
    if not matches:
        print("Error: no runs/*/story_summary.json found after render", file=sys.stderr)
        return 1
    newest = max(matches, key=os.path.getmtime)
    with open(newest) as f:
        summary = json.load(f)

    completed = summary.get("completed_units")
    requested = summary.get("requested_units")
    intended = summary.get("intended_total_frames")
    actual = summary.get("actual_total_frames")
    fps = summary.get("fps", args.fps)
    retried = [u.get("unit") for u in summary.get("units", []) if u.get("attempts", 1) > 1]

    print("=== render summary (%s) ===" % newest)
    print("completed: %s/%s units" % (completed, requested))
    print("frames: intended=%s actual=%s" % (intended, actual))
    print("retried units: %r" % retried)

    if os.path.exists(movie_path):
        size_bytes = os.path.getsize(movie_path)
        duration = (actual or 0) / fps if fps else 0.0
        print("movie: %s (%d bytes, %.2fs @ %d fps)" % (movie_path, size_bytes, duration, fps))

    return 0 if completed == requested else 1


def phase4_render(args):
    paths = _story_paths(args.story_id)
    movie_path = paths["movie_path"]

    print("=== Phase 4: render ===")
    if os.path.exists(movie_path) and not args.force:
        print("Error: %s already exists; pass --force to overwrite" % movie_path,
              file=sys.stderr)
        return 2

    if not _wait_for_avail(args.min_avail_gib, args.avail_timeout):
        return 1

    cmd = [sys.executable, os.path.join(WS, "bin", "ltx-mlx-render"),
           paths["manifest_path"], movie_path] + _phase4_flags(args)
    print("Running: %s" % shlex.join(cmd))

    rc = _stream_and_tee(cmd, paths["movie_log_path"])
    if rc != 0:
        print("Error: ltx-mlx-render exited %d" % rc, file=sys.stderr)
        return rc

    return _report_summary(args, movie_path, paths["story_dir"])


# ---------------------------------------------------------------------------
# dry-run plan
# ---------------------------------------------------------------------------

def _print_dry_run_plan(args):
    paths = _story_paths(args.story_id)
    max_tokens = _phase1_max_tokens(args.panels)
    timeout = _phase1_timeout(args.panels)
    prompt = build_story_prompt(args.narrative, args.story_id, args.panels, args.no_stills,
                                 bool(getattr(args, "seed_image", None)))

    print("=== DRY RUN: ltx-movie phase plan (story-id=%s) ===" % args.story_id)
    print()

    if getattr(args, "seed_image", None):
        print("--- Phase 0: seed image ---")
        print("Would validate %s (readable image, every edge >= %dpx) and write a PNG "
              "copy with a long edge <= %dpx to %s. Phase 1 attaches that copy; Phase 2 "
              "receives the ORIGINAL." % (args.seed_image, SEED_MIN_EDGE,
                                          SEED_DOWNSCALE_MAX_EDGE, paths["seed_downscaled"]))
        print()

    print("--- Phase 1: story ---")
    print("Would skip if %s already exists (pass --force-story to regenerate)."
          % paths["story_md"])
    phase1_cmd = [sys.executable, os.path.join(WS, "bin", "qwen-agent"),
                  "--workspace", WS,
                  "--max-tokens", str(max_tokens), "--max-rounds", "4",
                  "--request-timeout", "600"]
    if getattr(args, "seed_image", None):
        phase1_cmd += ["--image", paths["seed_downscaled"]]
    phase1_cmd += ["--user-prompt", prompt]
    print("Command (subprocess timeout %ds): %s" % (timeout, shlex.join(phase1_cmd)))
    print()
    print("Rendered story prompt:")
    print(prompt)
    print()

    if args.no_stills:
        print("--- Phase 2: stills --- SKIPPED (--no-stills: no anchor stills are generated)")
        print()
    else:
        print("--- Phase 2: stills ---")
        phase2_cmd = [sys.executable, os.path.join(WS, "bin", "ltx-story-images"),
                      "--story-md", paths["story_md"], "--out-dir", paths["images_dir"],
                      "--width", str(args.image_width), "--height", str(args.image_height),
                      "--seed", str(args.image_seed)]
        if getattr(args, "seed_image", None):
            phase2_cmd += ["--seed-image", args.seed_image]
        print("Command: %s" % shlex.join(phase2_cmd))
        print()

    print("--- Phase 3: manifest + dry-run ---")
    phase3_manifest_cmd = [sys.executable, os.path.join(WS, "bin", "ltx-story-manifest"),
                            "--story-id", args.story_id, "--prompts-md", paths["story_md"]]
    if args.no_stills:
        phase3_manifest_cmd += ["--no-images"]
    else:
        phase3_manifest_cmd += ["--glob", "panel_*.png", "--images-dir", paths["images_dir"]]
    phase3_manifest_cmd += ["--fps", str(args.fps),
                             "--target-seconds", str(_target_seconds(args)),
                             "--min-frames", str(args.frames),
                             "--max-frames", str(args.frames), "--force"]
    print("Command: %s" % shlex.join(phase3_manifest_cmd))
    phase3_render_cmd = [sys.executable, os.path.join(WS, "bin", "ltx-mlx-render"),
                         paths["manifest_path"], paths["movie_path"]] \
                        + _render_flags(args) + ["--dry-run"]
    print("Command: %s" % shlex.join(phase3_render_cmd))
    print()

    print("--- Phase 4: render ---")
    print("Avail gate: wait until psutil.virtual_memory().available/2**30 >= %.1f GiB "
          "(timeout %ds)." % (args.min_avail_gib, args.avail_timeout))
    phase4_cmd = [sys.executable, os.path.join(WS, "bin", "ltx-mlx-render"),
                  paths["manifest_path"], paths["movie_path"]] + _phase4_flags(args)
    print("Command: %s" % shlex.join(phase4_cmd))
    return 0


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main(argv=None):
    raw_argv = argv if argv is not None else sys.argv[1:]
    parser = build_parser()
    args = parser.parse_args(argv)
    _resolve_length(args, raw_argv)

    if getattr(args, "seed_image", None) and args.no_stills:
        print("Error: --seed-image is incompatible with --no-stills: --no-stills removes "
              "Phase 2 entirely, so the seed image would never become panel_01.png.",
              file=sys.stderr)
        return 2

    if args.dry_run:
        return _print_dry_run_plan(args)

    paths = _story_paths(args.story_id)
    os.makedirs(paths["story_dir"], exist_ok=True)
    lock_path = paths["lock_path"]

    state, pid = _lock_state(lock_path)
    if state == "active":
        print("another ltx-movie run for this story is active, pid %d" % pid, file=sys.stderr)
        return 2
    if state == "stale":
        print("note: removing stale lockfile for story %s (dead pid %s)" % (args.story_id, pid))
        try:
            os.remove(lock_path)
        except OSError:
            pass

    with open(lock_path, "w") as f:
        f.write(str(os.getpid()))

    try:
        rc = _check_sudo_and_start_keepalive()
        if rc is not None:
            return rc

        if not args.no_review and not sys.stdin.isatty():
            print("Error: review gates require an interactive terminal. Run this "
                  "interactively, or pass --no-review for unattended operation.",
                  file=sys.stderr)
            return 2

        phases = ((phase1_story, phase3_manifest, phase4_render) if args.no_stills
                  else (phase1_story, phase2_stills, phase3_manifest, phase4_render))
        if getattr(args, "seed_image", None):
            phases = (phase0_seed,) + phases
        for phase_fn in phases:
            rc = phase_fn(args)
            if rc != 0:
                return rc
        return 0
    finally:
        try:
            os.remove(lock_path)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
