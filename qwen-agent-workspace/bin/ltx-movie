STORY_BASE_URL = os.environ.get("QWEN_AGENT_STORY_BASE_URL", "http://127.0.0.1:8177/v1")


def _resolve_story_model(base_url=STORY_BASE_URL):
    """The single model id the story server reports at base_url/models, or None
    (server unreachable, or it reports zero or multiple models). Lets Phase 1 match
    whatever the server serves -- e.g. mlx_lm.server, which reports the model by its
    path and has no served-name alias -- without the operator passing --story-model."""
    import urllib.request
    try:
        with urllib.request.urlopen(base_url.rstrip("/") + "/models", timeout=3) as resp:
            data = json.loads(resp.read()).get("data", [])
        # Prefer the loaded model: mlx_lm/mlx_vlm server list every cached model and
        # flag the active one with "loaded": true.
        loaded = [m["id"] for m in data if m.get("loaded")]
        ids = loaded if loaded else [m["id"] for m in data]
        return ids[0] if len(ids) == 1 else None
    except Exception:
        return None


def _story_engine():
    """story_engine.py, the robust Phase 1 engine, loaded by path and only inside function bodies
    (robust story spec 1.2), so importing this file stays stdlib-only."""
    return importlib.machinery.SourceFileLoader(
        "story_engine", os.path.join(WS, "story_engine.py")).load_module()


def _lora_catalog():
    """lora_catalog.py, loaded by path and only inside function bodies (robust story spec 1.2)."""
    return importlib.machinery.SourceFileLoader(
        "lora_catalog", os.path.join(WS, "lora_catalog.py")).load_module()


def _resolve_casting(args):
    """Validate and resolve --character/--cast into args.cast_members (and args.cast_block when
    Phase 1 will run). Returns 0, or 2 after printing an Error: line. Touches nothing."""
    characters = args.characters or []
    casts = args.casts or []
    args.cast_members = []
    args.cast_block = None
    if not characters and not casts:
        if args.character_strength is not None:
            print("Error: --character-strength requires --character or --cast", file=sys.stderr)
            return 2
        return 0
    if args.no_stills:
        print("Error: --character/--cast are not supported with --no-stills: casting needs the "
              "chained flow", file=sys.stderr)
        return 2
    lib = _character_lib()
    strength = (args.character_strength if args.character_strength is not None
                else (lib.SHOTS_CHARACTER_STRENGTH if getattr(args, "shots", False)
                      else lib.DEFAULT_CHARACTER_STRENGTH))
    if not 0 < strength <= 1.0:
        print("Error: --character-strength must be in (0, 1], got %r" % strength, file=sys.stderr)
        return 2
    try:
        entries = [(None, name) for name in characters] + [lib.parse_cast_arg(v) for v in casts]
        members = lib.resolve_cast(entries)
    except lib.UnusableCharacterError as e:
        print("Error: %s" % e, file=sys.stderr)
        print(lib.format_available_line(lib.usable_characters()), file=sys.stderr)
        return 2
    except lib.CharacterError as e:
        print("Error: %s" % e, file=sys.stderr)
        return 2
    story_md = _story_paths(args.story_id)["story_md"]
    if args.force_story or not os.path.exists(story_md):
        if casts:
            print("Error: --cast needs an existing story.md that already uses the phrase, and Phase "
                  "1 is about to write a new one (%s); use --character to cast a new story"
                  % story_md, file=sys.stderr)
            return 2
        if args.story_prompt_override is not None:
            print("Error: --character cannot be combined with --story-prompt-override when Phase 1 "
                  "runs: the override is used verbatim, so the Cast block cannot be added",
                  file=sys.stderr)
            return 2
        args.cast_block = lib.build_cast_block(members, shots=getattr(args, "shots", False))
    else:
        with open(story_md, encoding="utf-8") as f:
            text = f.read()
        for m in members:
            if not lib.phrase_occurs(text, m.phrase):
                print("Error: cast phrase %r (character %s) does not occur in %s"
                      % (m.phrase, m.name, story_md), file=sys.stderr)
                return 2
    args.character_strength = strength
    args.cast_members = members
    return 0


def _resolve_locations(args):
    """Validate and resolve --location/--location-strength into args.location_pins (the
    location_lib.LocationPin list) and args.location_strength (location library spec L3.1,
    L3.2). Returns 0, or 2 after one Error: line. Touches nothing."""
    names = args.locations or []
    args.location_pins = []
    if not names:
        if args.location_strength is not None:
            print("Error: --location-strength requires --location", file=sys.stderr)
            return 2
        return _check_story_locations(args, names)
    if args.no_stills:
        print("Error: --location is not supported with --no-stills: location LoRAs attach to "
              "chained or shots panels", file=sys.stderr)
        return 2
    lib = _location_lib()
    strength = (args.location_strength if args.location_strength is not None
                else lib.DEFAULT_LOCATION_STRENGTH)
    if not 0 < strength <= 1.0:
        print("Error: --location-strength must be in (0, 1], got %r" % strength, file=sys.stderr)
        return 2
    try:
        pins = lib.resolve_locations(names)
    except lib.UnusableLocationError as e:
        print("Error: %s" % e, file=sys.stderr)
        print(lib.format_available_line(lib.usable_locations()), file=sys.stderr)
        return 2
    except lib.LocationError as e:
        print("Error: %s" % e, file=sys.stderr)
        return 2
    cast_triggers = dict((m.trigger, m.name) for m in (getattr(args, "cast_members", None) or []))
    for pin in pins:
        if pin.trigger in cast_triggers:
            print("Error: location %s and character %s share the trigger %s"
                  % (pin.name, cast_triggers[pin.trigger], pin.trigger), file=sys.stderr)
            return 2
    for k, pin in enumerate(pins):
        if not lib.model_compatible(pin.base_model, args.model):
            pins[k] = pin._replace(attach_video=False)
            print("Warning: location %s's video LoRA was trained for %s, not --model %s; it is not "
                  "attached, and the panels set there render without it (its setting and stills "
                  "LoRA still apply)" % (pin.name, pin.base_model, args.model), file=sys.stderr)
    rc = _check_story_locations(args, names)
    if rc:
        return rc
    args.location_pins = pins
    args.location_strength = strength
    return 0


def _resolve_seed_edit(args):
    """--seed-edit-model/--seed-edit-lora (qwen edit models spec QE43): sets args.seed_edit to None (the seed
    as-is) or {"qwen_model": ID, "loras": [{"id", "scale"}]}. Returns 0, or 2 after one Error: line. A dry
    run and --story-only read no weights; otherwise the selection must be installed and fit this host
    before the lockfile and any phase."""
    model, loras = args.seed_edit_model, args.seed_edit_loras
    args.seed_edit = None
    if model is None:
        if loras is not None:
            print("Error: --seed-edit-lora needs --seed-edit-model", file=sys.stderr)
            return 2
        return 0
    if not getattr(args, "seed_image", None):
        print("Error: --seed-edit-model needs --seed-image", file=sys.stderr)
        return 2
    if model == "as-is":
        if loras is not None:
            print("Error: --seed-edit-lora cannot be combined with --seed-edit-model as-is", file=sys.stderr)
            return 2
        return 0
    path = os.path.join(WS, "qwen_edit.py")
    if not os.path.isfile(path):
        print("Error: --seed-edit-model needs %s, which this workspace does not have" % path, file=sys.stderr)
        return 2
    qe = _qwen_edit()
    if model not in qe.MODEL_IDS:
        print("Error: --seed-edit-model must be as-is or one of %s" % ", ".join(qe.MODEL_IDS), file=sys.stderr)
        return 2
    try:
        model_id, clean = qe.cli_selection(model, loras, "--seed-edit-model", "--seed-edit-lora")
    except qe.SelectionError as e:
        print("Error: %s" % e, file=sys.stderr)
        return 2
    if not args.dry_run and not args.story_only:
        problem = qe.selection_problem(model_id, clean)
        if problem is not None:
            print("Error: --seed-edit-model %s: %s" % (model_id, problem), file=sys.stderr)
            return 2
    args.seed_edit = {"qwen_model": model_id, "loras": clean}
    return 0


def _cast_ref_still(member):
    """(path, error) of a cast member's reference picture for --cast-refs-model (cast refs spec CR6), derived from
    its character directory, never from the absolute paths inside character.json: dataset/stills/char_09.png (the
    medium shot standing with arms relaxed, which shows the clothing) when dataset/manifest.json lists still 9 as
    kept with a generation prompt naming both CAST_REFS_FULL_WORDS; else the dataset reference still
    dataset/stills/<dataset.reference>.png (char_00, the seed cropped around the face, or char_01, a close-up), after
    CAST_REFS_FALLBACK_NOTE. error is the text of an Error: line when neither file exists, else None."""
    lib = _character_lib()
    stills_dir = os.path.join(lib.character_dir(member.name), "dataset", "stills")
    full = os.path.join(stills_dir, CAST_REFS_FULL_STILL)
    try:
        with open(os.path.join(os.path.dirname(stills_dir), "manifest.json"), encoding="utf-8") as f:
            items = json.load(f).get("items")
    except (OSError, ValueError, AttributeError):
        items = None
    for item in items if isinstance(items, list) else []:
        if (isinstance(item, dict) and item.get("n") == 9 and item.get("kept") is True
                and all(w in str(item.get("gen_prompt") or "").lower() for w in CAST_REFS_FULL_WORDS)
                and os.path.isfile(full)):
            return full, None
    path = os.path.join(stills_dir, "%s.png" % lib.load_character(member.name)["dataset"]["reference"])
    if not os.path.isfile(path):
        return None, ("character %s has no reference still (looked for %s); rebuild its dataset with bin/character "
                      "create %s --regenerate" % (member.name, path, member.name))
    print(CAST_REFS_FALLBACK_NOTE % (member.name, CAST_REFS_FULL_STILL, path))
    return path, None


def _resolve_cast_refs(args):
    """--cast-refs-model/--cast-refs-lora (cast refs spec CR4): sets args.cast_refs to None (off, or a no-op with fewer
    than two cast characters) or {"qwen_model": ID, "loras": [{"id", "scale"}], "stills": {name: path}}. Returns 0,
    or 2 after one Error: line. A dry run and --story-only read no weights."""
    model, loras = args.cast_refs_model, args.cast_refs_loras
    args.cast_refs = None
    if model is None:
        if loras is not None:
            print("Error: --cast-refs-lora needs --cast-refs-model", file=sys.stderr)
            return 2
        return 0
    if not args.shots:
        print("Error: --cast-refs-model needs --shots: it renders the shots stills that show two cast characters",
              file=sys.stderr)
        return 2
    if getattr(args, "seed_image", None):
        print("Error: --cast-refs-model cannot be combined with --seed-image: with a seed image every shots still "
              "is already a Qwen edit of the seed", file=sys.stderr)
        return 2
    path = os.path.join(WS, "qwen_edit.py")
    if not os.path.isfile(path):
        print("Error: --cast-refs-model needs %s, which this workspace does not have" % path, file=sys.stderr)
        return 2
    qe = _qwen_edit()
    if model not in qe.MODEL_IDS:
        print("Error: --cast-refs-model must be one of %s" % ", ".join(qe.MULTI_REFERENCE_MODEL_IDS),
              file=sys.stderr)
        return 2
    if qe.multi_reference_problem(model) is not None:
        print("Error: --cast-refs-model %s is refused: %s" % (model, qe.multi_reference_problem(model)),
              file=sys.stderr)
        return 2
    try:
        model_id, clean = qe.cli_selection(model, loras, "--cast-refs-model", "--cast-refs-lora")
    except qe.SelectionError as e:
        print("Error: %s" % e, file=sys.stderr)
        return 2
    members = getattr(args, "cast_members", None) or []
    if len(members) < 2:
        print(CAST_REFS_NOOP_NOTE % len(members))
        return 0
    stills, seen = {}, {}
    for m in members:
        still, error = _cast_ref_still(m)
        if error is not None:
            print("Error: --cast-refs-model: %s" % error, file=sys.stderr)
            return 2
        digest = _sha256_file(still)
        if digest in seen:
            print("Error: --cast-refs-model: characters %s and %s have the same reference still bytes (%s); each "
                  "picture must show a different person" % (seen[digest], m.name, still), file=sys.stderr)
            return 2
        seen[digest] = m.name
        stills[m.name] = still
    if not args.dry_run and not args.story_only:
        problem = qe.selection_problem(model_id, clean)
        if problem is not None:
            print("Error: --cast-refs-model %s: %s" % (model_id, problem), file=sys.stderr)
            return 2
    args.cast_refs = {"qwen_model": model_id, "loras": clean, "stills": stills}
    return 0


def _resolve_seed_context(args):
    """--seed-context/--seed-context-order (seed context spec CX2): sets args.seed_context to None (off) or
    {"mode": the --seed-context value, "order": "seed-first" | "context-first"}. Returns 0, or 2 after one Error:
    line. Reads no weights: the edit model is --seed-edit-model's, which _resolve_seed_edit has already checked."""
    mode, order = args.seed_context_mode, args.seed_context_order
    args.seed_context = None
    if mode is None:
        if order is not None:
            print("Error: --seed-context-order needs --seed-context", file=sys.stderr)
            return 2
        return 0
    if not args.shots:
        print("Error: --seed-context needs --shots: it conditions each seeded shots still on the previous panel",
              file=sys.stderr)
        return 2
    if not getattr(args, "seed_image", None):
        print("Error: --seed-context needs --seed-image: every shots still is then a Qwen edit of the seed",
              file=sys.stderr)
        return 2
    if getattr(args, "cast_refs_model", None) is not None:
        print("Error: --seed-context cannot be combined with --cast-refs-model: with a seed image every shots still "
              "is already a Qwen edit of the seed", file=sys.stderr)
        return 2
    edit = getattr(args, "seed_edit", None)
    if not edit:
        print("Error: --seed-context needs --seed-edit-model ID, a Qwen registry edit model (as-is is refused): "
              "every shots still is a Qwen edit of the seed", file=sys.stderr)
        return 2
    problem = _qwen_edit().multi_reference_problem(edit["qwen_model"])
    if problem is not None:
        print("Error: --seed-context needs a --seed-edit-model that edits with several pictures; %s is refused: %s"
              % (edit["qwen_model"], problem), file=sys.stderr)
        return 2
    args.seed_context = {"mode": mode, "order": order or "seed-first"}
    return 0


def _check_story_locations(args, names):
    """Location library spec L3.2: a reused story.md keeps the locations its plan.json pinned,
    in both directions. Returns 0, or 2 after one Error: line; a story without a usable
    plan.json gets a note when --location is given."""
    story_md = _story_paths(args.story_id)["story_md"]
    if args.force_story or not os.path.exists(story_md):
        return 0
    story_dir = os.path.dirname(story_md)
    found = _location_lib().plan_location_names(story_dir)
    if found is None:
        if names:
            print("note: %s is not a usable plan; --location gets no LoRA in this story (location "
                  "LoRAs attach only to planned beats)" % os.path.join(story_dir, "plan.json"))
        return 0
    if found != set(names):
        no_location = args.no_stills or args.story_legacy or args.story_prompt_override is not None
        fix = ("--force-story to plan a new story (this run cannot take --location)" if no_location
               else "pass the same --location flags, or --force-story to plan a new story")
        print("Error: story %s was planned with the locations [%s], not --location [%s]; %s"
              % (args.story_id, ", ".join(sorted(found)) or "none",
                 ", ".join(sorted(set(names))) or "none", fix), file=sys.stderr)
        return 2
    return 0


def _video_skill():
    return importlib.machinery.SourceFileLoader(
        "ltx2_mlx_video_skill", os.path.join(WS, "ltx2_mlx_video_skill.py")).load_module()


def _resolve_global_loras(args):
    """Validate --lora/--stills-lora (spec 5.7). Sets args.global_video_loras and
    args.global_stills_loras to [(abs path, strength)] on the merged route; both stay [] on the
    legacy route, where the single raw value is forwarded exactly as before. Returns 0 or 2."""
    args.global_video_loras, args.global_stills_loras = [], []
    members = getattr(args, "cast_members", None) or []
    checks = (
        ("--lora", "lora_path_specs", "global_video_loras", "video",
         {os.path.realpath(m.video_lora): m.name for m in members}),
        ("--stills-lora", "stills_lora_path_specs", "global_stills_loras", "stills",
         {os.path.realpath(m.stills_lora): m.name for m in members if m.stills_lora}),
    )
    for flag, specs_attr, out_attr, kind, char_paths in checks:
        specs = getattr(args, specs_attr, None) or []
        if not specs:
            continue
        skill = _video_skill()
        try:
            parsed = [skill.parse_lora_spec(v) for v in specs]
        except ValueError as e:
            print("Error: %s: %s" % (flag, e), file=sys.stderr)
            return 2
        if len(parsed) == 1 and parsed[0][1] == 1.0 and not char_paths:
            continue                                        # legacy route (5.7.2)
        seen, resolved = {}, []
        for path, strength, _explicit in parsed:
            if not os.path.isfile(path) or not os.access(path, os.R_OK):
                print("Error: %s %s: not a readable file" % (flag, path), file=sys.stderr)
                return 2
            real = os.path.realpath(path)
            if real in seen:
                print("Error: %s %s is given more than once" % (flag, path), file=sys.stderr)
                return 2
            if real in char_paths:
                print("Error: %s %s is also character %s's %s LoRA; pass it once"
                      % (flag, path, char_paths[real], kind), file=sys.stderr)
                return 2
            seen[real] = path
            resolved.append((os.path.abspath(path), strength))
        setattr(args, out_attr, resolved)
    return 0


def _action_lib():
    """action_lib.py, loaded by path (stdlib), for --action resolution."""
    return importlib.machinery.SourceFileLoader(
        "action_lib", os.path.join(WS, "action_lib.py")).load_module()


def _action_lora_arch_ok(path):
    """(ok, message): whether an action LoRA matches the video base architecture via
    bin/lora-check's static check. ok is True on PASS/PARTIAL/UNVERIFIED (base not on
    disk -> unverified, allowed with a warning), False on FAIL. Factored out so tests
    can stub it."""
    try:
        checker = importlib.machinery.SourceFileLoader(
            "lora_check", os.path.join(WS, "bin", "lora-check")).load_module()
        base = checker.resolve_base_dir(_video_skill().MODEL_ID)
        status, problems = checker.static_check(path, base)
    except Exception as e:  # noqa: BLE001 - a tooling error must not silently pass a bad LoRA
        return True, "architecture check unavailable (%s); skipped" % e
    if status == "FAIL":
        return False, "; ".join(problems)
    if status == "UNVERIFIED":
        return True, "unverified (%s)" % "; ".join(problems)
    return True, status


def _resolve_actions(args):
    """Resolve --action into (abs path, strength) entries, gate each through
    bin/lora-check, and merge them into args.global_video_loras so they fuse per
    panel with cast-character LoRAs. Returns 0 or 2."""
    specs = getattr(args, "actions", None) or []
    if not specs:
        return 0
    lib = _action_lib()
    resolved = []
    for spec in specs:
        name, sep, strength_s = spec.partition(":")
        try:
            lib.validate_name(name)
            data = lib.load_action(name)
        except lib.ActionError as e:
            print("Error: --action %s: %s" % (name, e), file=sys.stderr)
            return 2
        if data["status"] != "trained" or not data.get("lora"):
            print("Error: --action %s: not trained yet (run bin/action train %s)" % (name, name),
                  file=sys.stderr)
            return 2
        path = data["lora"]["path"]
        if not (os.path.isfile(path) and os.access(path, os.R_OK)):
            print("Error: --action %s: LoRA file missing or unreadable: %s" % (name, path),
                  file=sys.stderr)
            return 2
        if sep:
            try:
                strength = float(strength_s)
            except ValueError:
                print("Error: --action %s: strength %r is not a number" % (name, strength_s),
                      file=sys.stderr)
                return 2
        else:
            strength = data["default_strength"]
        if not 0 < strength <= 2:
            print("Error: --action %s: strength must satisfy 0 < s <= 2, got %r" % (name, strength),
                  file=sys.stderr)
            return 2
        ok, msg = _action_lora_arch_ok(path)
        if not ok:
            print("Error: --action %s: its LoRA does not match the video base architecture: %s"
                  % (name, msg), file=sys.stderr)
            return 2
        if "unverified" in msg:
            print("warning: --action %s: %s" % (name, msg), file=sys.stderr)
        resolved.append((os.path.abspath(path), strength))

    # Merge with existing global video LoRAs, promoting any legacy single --lora so
    # it is not dropped when actions switch us to the merged (multi-LoRA) route.
    existing = list(getattr(args, "global_video_loras", None) or [])
    if not existing:
        gspecs = getattr(args, "lora_path_specs", None) or []
        if gspecs:
            skill = _video_skill()
            try:
                existing = [(os.path.abspath(p), s) for (p, s, _e)
                            in (skill.parse_lora_spec(v) for v in gspecs)]
            except ValueError as e:
                print("Error: --lora: %s" % e, file=sys.stderr)
                return 2
    args.global_video_loras = existing + resolved
    return 0


def _resolve_story_engine(args):
    """Select Phase 1's story engine (robust story spec RS2): sets args.story_engine to "robust" or
    "legacy" and args.story_catalog to the loaded LoRA catalog (the empty catalog with
    --no-auto-lora, None on the legacy engine). Returns 0, or 2 after one Error: line."""
    if args.no_narration and args.speech_only:
        print("Error: --speech-only and --no-narration cannot be combined", file=sys.stderr)
        return 2
    legacy = args.story_legacy or args.story_prompt_override is not None
    reason = "--story-legacy" if args.story_legacy else "--story-prompt-override"
    if legacy:
        for flag, given in (("--judge", args.judge), ("--no-auto-lora", args.no_auto_lora),
                            ("--goal", args.goal is not None),
                            ("--no-narration", args.no_narration),
                            ("--speech-only", args.speech_only),
                            ("--location", bool(args.locations))):
            if given:
                print("Error: %s needs the default story engine; it cannot be combined with %s"
                      % (flag, reason), file=sys.stderr)
                return 2
        args.story_engine, args.story_catalog = "legacy", None
        return 0
    if args.judge and not os.environ.get("ANTHROPIC_API_KEY"):
        print("Error: --judge needs ANTHROPIC_API_KEY for bin/judge-story; export it or drop "
              "--judge", file=sys.stderr)
        return 2
    if args.no_auto_lora:
        args.story_catalog = {"schema_version": 1, "entries": []}
    else:
        catalog = _lora_catalog()
        path = catalog.catalog_path(WS)
        try:
            args.story_catalog = catalog.load_catalog(path)
        except catalog.CatalogError as e:
            reason = str(e)
            if reason.startswith(path + ": "):
                reason = reason[len(path) + 2:]
            print("Error: invalid LoRA catalog %s: %s; run bin/lora-catalog verify" % (path, reason),
                  file=sys.stderr)
            return 2
    args.story_engine = "robust"
    return 0


def _resolve_shots(args):
    """Validate --shots/--redo (shots spec 5.1). Sets args.redo_panels to the sorted, de-duplicated
    panel numbers ([] without --redo). Returns 0, or 2 after one Error: line. Touches nothing."""
    args.redo_panels = []
    if not args.shots:
        if args.redo is not None:
            print("Error: --redo requires --shots", file=sys.stderr)
            return 2
        return 0
    if args.no_stills:
        print("Error: --shots needs Phase 2's per-panel stills; it cannot be combined with "
              "--no-stills", file=sys.stderr)
        return 2
    if getattr(args, "seed_image", None):
        # Shots seed edits SE2: every panel's still is a Qwen edit of the seed.
        if args.story_legacy or args.story_prompt_override is not None:
            print("Error: --shots with --seed-image needs the default story engine; it cannot be combined "
                  "with %s" % ("--story-legacy" if args.story_legacy else "--story-prompt-override"),
                  file=sys.stderr)
            return 2
        if args.seed_edit_model in (None, "as-is"):
            print("Error: --shots with --seed-image needs --seed-edit-model ID: every panel's still is a Qwen "
                  "edit of the seed, so the seed cannot be used as-is", file=sys.stderr)
            return 2
        if getattr(args, "stills_lora_path_specs", None):
            print("Error: --stills-lora cannot be combined with --shots and --seed-image: every panel's still "
                  "is a Qwen edit of the seed, and Z-Image stills LoRAs do not apply to it", file=sys.stderr)
            return 2
    if args.redo is None:
        return 0
    if args.force_story:
        print("Error: --redo cannot be combined with --force-story: --force-story writes a new "
              "story.md, so every panel changes", file=sys.stderr)
        return 2
    if args.story_only:
        print("Error: --redo cannot be combined with --story-only: --story-only stops before the "
              "stills and clips that --redo re-renders", file=sys.stderr)
        return 2
    try:
        panels = sorted({int(x) for x in args.redo.split(",") if x.strip()})
    except ValueError:
        panels = []
    if not panels:
        print("Error: --redo must be a comma-separated list of panel numbers, e.g. 3 or 3,7; "
              "got %r" % args.redo, file=sys.stderr)
        return 2
    for n in panels:
        if not 1 <= n <= args.panels:
            print("Error: --redo panel %d is out of range (1..%d)" % (n, args.panels),
                  file=sys.stderr)
            return 2
    story_md = _story_paths(args.story_id)["story_md"]
    if not os.path.isfile(story_md):
        print("Error: --redo needs an existing story.md: %s" % story_md, file=sys.stderr)
        return 2
    args.redo_panels = panels
    return 0


def _list_characters(raw_argv):
    """--list-characters: print bin/character list's table and exit, before argparse (so no
    --story-id or narrative is required) and before the lockfile, the sudo check, the review
    gate or any phase (spec 5.6(i))."""
    if raw_argv != ["--list-characters"]:
        print("Error: --list-characters takes no other arguments", file=sys.stderr)
        return 2
    print("\n".join(_character_lib().character_table_lines()))
    return 0


def _cast_flags(args):
    """--cast PHRASE=NAME per member, then --character-strength; [] when uncast."""
    members = getattr(args, "cast_members", None)
    if not members:
        return []
    flags = []
    for m in members:
        flags += ["--cast", "%s=%s" % (m.phrase, m.name)]
    return flags + ["--character-strength", repr(float(args.character_strength))]


def _location_flags(args, video=False):
    """--location NAME per pinned location (with video, only those whose video LoRA attaches),
    then --location-strength; [] when none qualifies (location library spec L3.8)."""
    pins = [pin for pin in (getattr(args, "location_pins", None) or [])
            if pin.attach_video or not video]
    if not pins:
        return []
    flags = []
    for pin in pins:
        flags += ["--location", pin.name]
    return flags + ["--location-strength", repr(float(args.location_strength))]


def _seed_cell_budget():
    """(max_area_cells, max_edge_cells) for seed geometry when host autotune is on and
    its tier sets a size (QWEN_LTX_AUTOTUNE, e.g. 1024x576 -> 144 cells, 16-cell edge),
    else None: ltx_image_fit's measured 704x448 default applies."""
    skill = _ltx2_skill()
    if not skill.autotune_enabled():
        return None
    o = skill.autotune_overrides()
    if "width" not in o or "height" not in o:
        return None
    w, h = o["width"] // 64, o["height"] // 64
    return w * h, max(_image_fit().MAX_CELLS, w, h)


def _seed_geometry(seed_path):
    """Validate seed_path and derive the video geometry from it, within the autotune
    tier's area when that is on (_seed_cell_budget). Writes nothing.

    Returns (violations, geometry, img): ([], (W, H, pad_px), the EXIF-oriented RGB
    image) on success, or ([one violation], None, None) at the first problem."""
    if not os.path.isfile(seed_path):
        return ["--seed-image not found: %s" % seed_path], None, None
    try:
        fit = _image_fit()
        img = fit.load_oriented_rgb(seed_path)
    except ImportError as e:
        return ["--seed-image needs Pillow, which is not importable: %s" % e], None, None
    except Exception as e:
        return (["--seed-image is not a readable image: %s: %s" % (type(e).__name__, e)],
                None, None)
    if min(img.size) < SEED_MIN_EDGE:
        return (["--seed-image is degenerate: %dx%d (each edge must be at least %d px)"
                 % (img.size[0], img.size[1], SEED_MIN_EDGE)], None, None)
    try:
        geometry = fit.derive_video_dims(*img.size, *(_seed_cell_budget() or ()))
    except ValueError as e:
        return [str(e)], None, None
    return [], geometry, img


def _prepare_seed_image(seed_path, out_path):
    """Validate the seed, derive (W, H, pad_px), and write the story model's copy:
    frame 0 exactly as it will be rendered (the seed fitted into W x H, never cropped),
    scaled so its long edge is SEED_DOWNSCALE_MAX_EDGE. The vision model therefore sees
    the same aspect and relative pad as panel_01.png, at a size where faces are legible.

    Returns (violations, geometry). On any violation nothing is written."""
    violations, geometry, img = _seed_geometry(seed_path)
    if violations:
        return violations, None
    width, height, _pad = geometry
    k = SEED_DOWNSCALE_MAX_EDGE / float(max(width, height))
    llm = _image_fit().fit_letterbox(img, round(width * k), round(height * k))
    try:
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        llm.save(out_path, format="PNG")
    except OSError as e:
        return ["cannot write the downscaled seed copy to %s: %s" % (out_path, e)], None
    return [], geometry


def _seed_geometry_line(seed_path, src_size, geometry, llm_path):
    """The one geometry line Phase 0 and --dry-run both print."""
    width, height, pad = geometry
    return ("seed image OK: %s (%dx%d after EXIF orientation) -> video geometry %dx%d "
            "(residual pad %d px, %.2fx of the measured 704x448 area); story-model copy %s"
            % (seed_path, src_size[0], src_size[1], width, height, pad,
               (width * height) / (704.0 * 448), llm_path))


def phase0_seed(args):
    """Pre-flight --seed-image, derive the video geometry from it, and write the scaled
    copy that Phase 1 attaches.

    Runs first, before the 27B call and before any GPU time: a missing, corrupt,
    degenerate or out-of-range (outside 1:3 .. 3:1) seed fails here with exit 2. Phase 2
    works from the ORIGINAL file, never from this copy."""
    paths = _story_paths(args.story_id)
    print("=== Phase 0: seed image ===")
    violations, geometry = _prepare_seed_image(args.seed_image, paths["seed_downscaled"])
    if violations:
        for v in violations:
            print("Error: %s" % v, file=sys.stderr)
        return 2
    args.video_width, args.video_height, args.seed_pad_px = geometry
    args.seed_downscaled_path = paths["seed_downscaled"]
    src_size = _image_fit().load_oriented_rgb(args.seed_image).size
    print(_seed_geometry_line(args.seed_image, src_size, geometry, paths["seed_downscaled"]))
    return 0


# ---------------------------------------------------------------------------
# phase 1: story
# ---------------------------------------------------------------------------

def _run_story_agent(cmd, timeout, story_md):
    """Run one bin/qwen-agent story-authoring call: print the command, wait up to timeout
    seconds, and apply Phase 1's exit-code rules. Returns 0 when story.md may be validated
    (including qwen-agent exiting nonzero after writing it), else 1. Moved verbatim out of
    phase1_story so the shots rewrite reuses it (shots spec 5.4)."""
    print("Running (timeout %ds): %s" % (
        timeout, shlex.join(cmd[:-1] + ["--user-prompt", "<%d chars>" % len(cmd[-1])])
    ))

    proc = subprocess.Popen(cmd, cwd=WS, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True)
    try:
        out, _ = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        out, _ = proc.communicate()
        tail = "\n".join((out or "").splitlines()[-40:])
        print("Error: qwen-agent timed out after %ds writing story.md (known hang mode: "
              "attempting to self-verify, which the prompt forbids); log tail:\n%s"
              % (timeout, tail), file=sys.stderr)
        return 1
    if "--danger-auto-approve" in cmd:
        # Every tool call qwen-agent ran unconfirmed under this flag traces as
        # [danger-auto]; print the full output (not just the failure-path tail
        # below) regardless of exit code, so that trail actually reaches whatever
        # captures this process's stdout -- a human's terminal, or bin/iterate-story's
        # own per-round log (tiered-approval spec SS1.4.1). Silently discarding it on
        # success would make the audit-trail property that flag's acceptance depends
        # on false exactly when nothing went wrong.
        print(out or "")
    if proc.returncode != 0:
        tail = "\n".join((out or "").splitlines()[-40:])
        if os.path.isfile(story_md):
            # qwen-agent can finish writing story.md and STILL exit
            # nonzero (e.g. it hits its round/tool limit after the
            # write -- observed 2026-08-27, story sisters_sorrow: 30
            # valid panels on disk, rc != 0, and this branch killed the
            # run). The file on disk, validated below, is the evidence
            # that matters; the exit code is not. Same lesson as
            # qwen-serve-guard's restart rc: never trust an exit code
            # over a direct check of the outcome.
            print("Warning: qwen-agent exited %d but story.md exists -- "
                  "validating the file instead of failing. Log tail:\n%s"
                  % (proc.returncode, tail))
        else:
            print("Error: qwen-agent exited %d while authoring story.md\n%s"
                  % (proc.returncode, tail), file=sys.stderr)
            return 1
    return 0


def phase1_story(args):
    if args.story_model is None:
        # Auto-detect the served model so BOTH Phase 1 engines (robust + legacy)
        # match it without the operator passing --story-model. Done here, before the
        # robust branch returns, so the robust StoryContext also gets the resolved name.
        resolved = _resolve_story_model()
        if resolved:
            args.story_model = resolved
            print("story model auto-detected from %s: %s"
                  % (STORY_BASE_URL, resolved), file=sys.stderr)
    if getattr(args, "story_engine", "legacy") == "robust":
        return _phase1_robust(args)
    paths = _story_paths(args.story_id)
    story_md = paths["story_md"]
    authored = None

    if os.path.exists(story_md) and not args.force_story:
        print("note: %s already exists; skipping Phase 1 (pass --force-story to regenerate)"
              % story_md)
    else:
        print("=== Phase 1: story ===")
        stale_plan = os.path.join(_story_dir(args.story_id), "plan.json")
        if os.path.exists(stale_plan):
            moved = _unused_path(os.path.join(_story_dir(args.story_id), "plan.stale-%s-%d.json"
                                              % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()),
                                                 os.getpid())))
            os.replace(stale_plan, moved)
            print("note: moved the robust engine's plan.json aside to %s; this story.md is written "
                  "by --story-legacy" % moved)
        if args.story_prompt_override is not None:
            with open(args.story_prompt_override, encoding="utf-8") as f:
                prompt = f.read()
        else:
            prompt = build_story_prompt(args.narrative, args.story_id, args.panels, args.no_stills,
                                         bool(getattr(args, "seed_image", None)),
                                         seconds=_clip_seconds(args),
                                         cast_block=getattr(args, "cast_block", None),
                                         shots=getattr(args, "shots", False))
        with open(os.path.join(_story_dir(args.story_id), "story_prompt.txt"), "w",
                  encoding="utf-8") as f:
            f.write(prompt)
        max_tokens = _phase1_max_tokens(args.panels)
        timeout = _phase1_timeout(args.panels)
        # Story agent tool restriction spec AT12: the legacy prompt needs exactly one write_file call.
        cmd = [sys.executable, os.path.join(WS, "bin", "qwen-agent"),
               "--workspace", WS,
               "--max-tokens", str(max_tokens), "--max-rounds", "4",
               "--request-timeout", "600", "--tools", "write_file"]
        if args.story_model:  # resolved at the top of phase1_story
            cmd += ["--model", args.story_model]
        if args.story_context_window:
            cmd += ["--context-window", str(args.story_context_window)]
        if getattr(args, "seed_downscaled_path", None):
            cmd += ["--image", args.seed_downscaled_path]
        if args.force_story and args.no_review:
            cmd += ["--danger-auto-approve"]
        cmd += ["--user-prompt", prompt]
        before = os.stat(story_md) if os.path.exists(story_md) else None
        rc = _run_story_agent(cmd, timeout, story_md)
        if rc:
            return rc
        authored = {"cmd": cmd, "timeout": timeout, "prompt": prompt, "before": before}

    if getattr(args, "shots", False):
        return _phase1_shots_finish(args, story_md, authored)

    violations = _validate_story_md(story_md, args.panels, args.no_stills)
    if violations:
        print("Error: story.md failed validation:", file=sys.stderr)
        for v in violations:
            print("  - %s" % v, file=sys.stderr)
        print("Hand-edit %s to fix the violations above and rerun; story.md already exists "
              "so Phase 1 will be skipped next time (pass --force-story to regenerate it "
              "instead)." % story_md, file=sys.stderr)
        return 1

    if not args.no_review:
        with open(story_md) as f:
            content = f.read()
        print("=== story.md ===")
        print(content)

    # Advisory only -- never changes the return code. Printed after the story dump so a
    # human reviewing it sees it directly above the prompt they are about to answer, and
    # printed under --no-review too so it lands in movie.log. An old-format story.md with
    # Image: on later panels still renders; those fields are ignored (spec D10).
    if not args.no_stills:
        for w in _chain_image_warnings(_load_story_panels(story_md)):
            print("Warning: %s" % w)

    members = getattr(args, "cast_members", None) or []
    if members:
        with open(story_md, encoding="utf-8") as f:
            text = f.read()
        lib = _character_lib()
        for m in members:
            if not lib.phrase_occurs(text, m.phrase):
                print("Warning: story.md does not use cast phrase %r; character %s gets no LoRA in "
                      "this story" % (m.phrase, m.name))

    if not args.no_review:
        input("Review story.md above. Enter to continue, Ctrl-C to abort: ")

    return 0


def _story_mode(args):
    return ("no_stills" if args.no_stills
            else "shots" if getattr(args, "shots", False) else "chained")


def _story_pins(args, catalog):
    """Every global video --lora as a pin {"path", "strength", "catalog_id", "kind"} (LC12); the
    catalog fields come from a video catalog entry with the same realpath, else null."""
    if getattr(args, "global_video_loras", None):
        loras = list(args.global_video_loras)
    elif args.lora_path:
        loras = [(os.path.abspath(args.lora_path), 1.0)]
    else:
        loras = []
    by_real = dict((os.path.realpath(e["path"]), e) for e in catalog["entries"]
                   if e["target"] == "video")
    pins = []
    for path, strength in loras:
        entry = by_real.get(os.path.realpath(path))
        pins.append({"path": path, "strength": strength,
                     "catalog_id": entry["id"] if entry else None,
                     "kind": entry["kind"] if entry else None})
    return pins


# Soft panel count spec SPC13, D7: the user is told when the story has more panels than its target,
# and why, on every run.
PANEL_COUNT_NOTE = "note: story.md has %d panels for a target of %d (%s)"
PANEL_COUNT_PHASES = "; Phases 2-4 use all %d"
PANEL_COUNT_NO_REASON = "plan.json records no reason"
DRY_PANELS_RANGE = ("Panel count: a target of %d; the plan may have %d to %d beats, and Phases 2-4 "
                    "use the plan's count.")
DRY_PANELS_STORY = ("Panel count: plan.json and story.md have %d panels for a target of %d; Phases "
                    "2-4 would use all %d.")
DRY_PANELS_STOP = "Panel count: Phase 1 would stop: %s"


def _plan_panels(args):
    """(panels, reason, target) of plan.json when it is the plan of this story.md (soft panel
    count spec SPC13, D6): a JSON object with schema ltx-movie.plan.v1, this run's mode, an int
    panels from the target (args.panels_target, else args.panels) to the target plus
    story_engine.PANELS_EXTRA, and story.md parsing to exactly that many panels; else None.
    reason is "because <the text after 'because '>" of the first speech_notes entry that starts
    "plan: P20 panel count: ", else PANEL_COUNT_NO_REASON. target is plan.json's int
    panels_target when it has one, else this run's target (fix FW-b: the note names the target
    the story was planned for). A story.md that cannot be read or decoded parses to no panels,
    so its plan is not adopted (fix FW-c)."""
    target = getattr(args, "panels_target", None) or args.panels
    paths = _story_paths(args.story_id)
    try:
        with open(os.path.join(paths["story_dir"], "plan.json"), encoding="utf-8") as f:
            plan = json.load(f)
    except (OSError, ValueError):
        return None
    panels = plan.get("panels") if isinstance(plan, dict) else None
    if (not isinstance(plan, dict) or plan.get("schema") != "ltx-movie.plan.v1"
            or plan.get("mode") != _story_mode(args) or not isinstance(panels, int)
            or isinstance(panels, bool)
            or not target <= panels <= target + _story_engine().PANELS_EXTRA
            or len(_load_story_panels(paths["story_md"])) != panels):
        return None
    notes = plan.get("speech_notes") if isinstance(plan.get("speech_notes"), list) else []
    saved = [m for m in notes if isinstance(m, str) and m.startswith("plan: P20 panel count: ")
             and ", because " in m]
    reason = ("because " + saved[0].split(", because ", 1)[1]) if saved else PANEL_COUNT_NO_REASON
    planned = plan.get("panels_target")
    if not isinstance(planned, int) or isinstance(planned, bool):
        planned = target
    return panels, reason, planned


def _resolve_story_panels(args):
    """Soft panel count spec SPC13, D7: args.panels_target is --panels; with the default story
    engine, no --force-story and an existing story.md whose plan.json is its plan for this run,
    args.panels becomes the plan's panel count. Prints nothing; never fails."""
    args.panels_target = args.panels
    if (args.story_legacy or args.story_prompt_override is not None or args.force_story
            or not os.path.isfile(_story_paths(args.story_id)["story_md"])):
        return
    found = _plan_panels(args)
    if found is not None:
        args.panels = found[0]


def _write_story_prompt(args, story_dir):
    """<story_dir>/story_prompt.txt: build_story_prompt for args.panels (soft panel count spec
    SPC13, D12)."""
    prompt = build_story_prompt(args.narrative, args.story_id, args.panels, args.no_stills,
                                bool(getattr(args, "seed_image", None)),
                                seconds=_clip_seconds(args),
                                cast_block=getattr(args, "cast_block", None),
                                shots=getattr(args, "shots", False))
    with open(os.path.join(story_dir, "story_prompt.txt"), "w", encoding="utf-8") as f:
        f.write(prompt)


def _story_context(args, dry_run=False):
    """The story_engine.StoryContext of this run (robust story spec 2.1)."""
    engine = _story_engine()
    paths = _story_paths(args.story_id)
    seeded = bool(getattr(args, "seed_image", None))
    catalog = getattr(args, "story_catalog", None) or {"schema_version": 1, "entries": []}
    if getattr(args, "global_stills_loras", None):
        stills = [os.path.realpath(path) for path, _strength in args.global_stills_loras]
    elif args.stills_lora_path:
        stills = [os.path.realpath(args.stills_lora_path)]
    else:
        stills = []
    if not seeded:
        agent_image = None
    elif dry_run:
        agent_image = paths["seed_downscaled"]
    else:
        agent_image = getattr(args, "seed_downscaled_path", None)
    return engine.StoryContext(
        ws=WS, story_id=args.story_id, story_dir=paths["story_dir"], mode=_story_mode(args),
        panels=args.panels, seconds=_clip_seconds(args), narrative=args.narrative,
        goal=args.goal, members=list(getattr(args, "cast_members", None) or []),
        seed_image=os.path.abspath(args.seed_image) if seeded else None,
        seed_agent_image=agent_image, story_model=args.story_model,
        context_window=args.story_context_window, video_model=args.model,
        auto_lora=not args.no_auto_lora, catalog=catalog, pinned=_story_pins(args, catalog),
        stills_pinned=stills, judge=args.judge,
        narration=False if args.no_narration else "speech" if args.speech_only else True,
        clip_seconds=args.frames / float(args.fps),
        panels_target=getattr(args, "panels_target", None), length=getattr(args, "length", None),
        locations=list(getattr(args, "location_pins", None) or []))


def _no_stills_rules():
    """The Rules: lines of STORY_PROMPT_TEMPLATE_NO_STILLS, each stripped (robust story spec RS12)."""
    template = STORY_PROMPT_TEMPLATE_NO_STILLS
    block = template[template.index("Rules:\n") + len("Rules:\n"):
                     template.index("\n\nNarrative to adapt:")]
    return "\n".join(line.strip() for line in block.split("\n"))


def _catalog_plan(args, dry_run=False):
    """This story's plan.json when catalog LoRAs apply (LC13): the robust engine, auto LoRA on,
    and a valid plan for this mode and panel count (and, in a dry run, no --force-story). Else
    None."""
    if (getattr(args, "story_engine", "legacy") != "robust" or getattr(args, "no_auto_lora", False)
            or (dry_run and args.force_story)):
        return None
    try:
        with open(os.path.join(_story_dir(args.story_id), "plan.json"), encoding="utf-8") as f:
            plan = json.load(f)
    except (OSError, ValueError):
        return None
    if (not isinstance(plan, dict) or plan.get("schema") != "ltx-movie.plan.v1"
            or plan.get("mode") != _story_mode(args) or plan.get("panels") != args.panels
            or not isinstance(plan.get("loras"), dict)
            or not all(k in plan for k in ("title", "logline", "cast", "locations", "props",
                                           "beats", "loras"))):
        return None
    if dry_run and not os.path.exists(os.path.join(_story_dir(args.story_id), "story.md")):
        return None
    return plan


def _catalog_plan_error(args, plan, picks, dry_run=False):
    """The LC13 Error line when plan.json's LoRA picks are malformed or fail the catalog checks,
    else None. picks: every pick about to be resolved."""
    engine = _story_engine()
    if not all(engine._is_pick(p) for p in picks):
        return ("Error: plan.json has malformed LoRA picks; rerun with --force-story or "
                "--no-auto-lora")
    return None


def _catalog_checks_error(args, plan, dry_run=False):
    """The LC13 Error line when the plan's LoRA picks fail the engine's catalog checks (L1-L8)."""
    engine = _story_engine()
    ctx = _story_context(args, dry_run)
    compatible = dict((e["id"], e) for e in engine.compatible_entries(ctx))
    catalog = dict((e["id"], e) for e in ctx.catalog.get("entries", []))
    try:
        hard = engine.lora_checks(ctx, plan, compatible, catalog)[0]
    except (KeyError, TypeError, AttributeError, ValueError, IndexError):
        return ("Error: plan.json has malformed LoRA picks; rerun with --force-story or "
                "--no-auto-lora")
    if hard:
        return ("Error: plan.json LoRA picks fail the catalog checks (%s); rerun with "
                "--force-story or --no-auto-lora" % hard[0])
    return None


_MALFORMED_PICKS = ("Error: plan.json has malformed LoRA picks; rerun with --force-story or "
                    "--no-auto-lora")


def _catalog_pick(args, pick):
    """(the catalog-loras entry of one plan pick, None) or (None, the LC13 Error line)."""
    entries = dict((e["id"], e) for e in (getattr(args, "story_catalog", None) or {}).get(
        "entries", []))
    entry = entries.get(pick.get("id"))
    if entry is None:
        return None, ("Error: plan.json picks catalog LoRA %s, which is no longer in the catalog; "
                      "re-add it with bin/lora-catalog add, or rerun with --no-auto-lora"
                      % pick.get("id"))
    try:
        size = os.path.getsize(entry["path"])
    except OSError:
        size = None
    if size != entry["bytes"]:
        return None, ("Error: catalog LoRA %s changed since it was cataloged (%s); run "
                      "bin/lora-catalog verify" % (entry["id"], entry["path"]))
    return {"id": entry["id"], "kind": entry["kind"], "path": entry["path"],
            "sha256": entry["sha256"], "strength": pick["strength"],
            "triggers": list(entry["triggers"])}, None


def _catalog_panel_loras(args, dry_run=False):
    """(None, None) when the plan picks no video catalog LoRA; else (None, one list per panel:
    its motion/physics picks, global then per-beat, then the global style pick) or (the LC13
    Error line, None)."""
    plan = _catalog_plan(args, dry_run)
    if plan is None:
        return None, None
    raw_global = plan["loras"].get("global")
    raw_beat = plan["loras"].get("per_beat")
    if ((raw_global is not None and not isinstance(raw_global, list))
            or (raw_beat is not None and not isinstance(raw_beat, dict))
            or any(not isinstance(v, list) for v in (raw_beat or {}).values())):
        return _MALFORMED_PICKS, None
    global_picks = raw_global or []
    per_beat = raw_beat or {}
    if not global_picks and not any(per_beat.values()):
        return None, None
    error = _catalog_plan_error(args, plan, global_picks + [p for picks in per_beat.values()
                                                            for p in picks], dry_run)
    if error:
        return error, None
    resolved = {}
    for pick in global_picks + [p for picks in per_beat.values() for p in picks]:
        item, error = _catalog_pick(args, pick)
        if error:
            return error, None
        resolved[id(pick)] = item
    error = _catalog_checks_error(args, plan, dry_run)
    if error:
        return error, None
    panels = []
    for k in range(1, args.panels + 1):
        picks = [resolved[id(p)] for p in global_picks + (per_beat.get(str(k)) or [])]
        panels.append([p for p in picks if p["kind"] in ("motion", "physics")]
                      + [resolved[id(p)] for p in global_picks
                         if resolved[id(p)]["kind"] == "style"])
    return None, panels


def _catalog_stills_flags(args, dry_run=False):
    """(None, ["--lora", PATH:STRENGTH, "--lora-trigger", T, ...]) for the plan's stills pick,
    (None, []) without one, or (the LC13 Error line, []) (LC14)."""
    plan = _catalog_plan(args, dry_run)
    picks = (plan["loras"].get("stills") or []) if plan else []
    if not picks:
        return None, []
    if not isinstance(picks, list):
        return _MALFORMED_PICKS, []
    error = _catalog_plan_error(args, plan, picks, dry_run)
    if error:
        return error, []
    item, error = _catalog_pick(args, picks[0])
    if error:
        return error, []
    error = _catalog_checks_error(args, plan, dry_run)
    if error:
        return error, []
    flags = ["--lora", "%s:%s" % (item["path"], repr(float(item["strength"])))]
    for trigger in item["triggers"]:
        flags += ["--lora-trigger", trigger]
    return None, flags


def _write_catalog_loras(args, path, panels):
    """<story_dir>/catalog_loras.json (robust story spec 2.8), written atomically."""
    _story_engine()._write_json(path, {"schema": "ltx-movie.catalog-loras.v1",
                                       "story_id": args.story_id, "panels": panels})


def _phase1_robust(args):
    """Phase 1 on the robust story engine (robust story spec RS35): re-check an existing story.md
    (no --force-story), else write story_prompt.txt and run the engine; then the review gate."""
    paths = _story_paths(args.story_id)
    story_md = paths["story_md"]
    engine = _story_engine()
    ctx = _story_context(args)
    if os.path.exists(story_md) and not args.force_story:
        generated = False
        print("note: %s already exists; re-checking it instead of regenerating it (pass "
              "--force-story to regenerate)" % story_md)
        rc, advisories = engine.recheck(
            ctx, lambda path, panels, no_stills=False: _validate_story_md(
                path, panels, no_stills, no_narration=args.no_narration or args.speech_only))
    else:
        generated = True
        print("=== Phase 1: story ===")
        _write_story_prompt(args, paths["story_dir"])
        rc, advisories = engine.run(ctx, no_stills_rules=_no_stills_rules())
    target = getattr(args, "panels_target", None) or args.panels
    if rc != 0:
        # Soft panel count fix FW-a: a generated story that fails its checks is still saved and
        # the engine says to hand-edit it and rerun, so story_prompt.txt gets the plan's count.
        found = _plan_panels(args) if generated else None
        if found is not None and found[0] != target:
            args.panels = found[0]
            _write_story_prompt(args, paths["story_dir"])
        return rc
    if not args.no_review:
        with open(story_md, encoding="utf-8") as f:
            content = f.read()
        print("=== story.md ===")
        print(content)
    for advisory in advisories:
        print("Warning: %s" % advisory)
    found = _plan_panels(args)
    if found is not None:
        args.panels = found[0]
        if args.panels != target:
            if generated:
                _write_story_prompt(args, paths["story_dir"])
            print(PANEL_COUNT_NOTE % (args.panels, found[2], found[1])
                  + ("" if args.story_only else PANEL_COUNT_PHASES % args.panels))
    members = getattr(args, "cast_members", None) or []
    if members:
        with open(story_md, encoding="utf-8") as f:
            text = f.read()
        lib = _character_lib()
        for m in members:
            if not lib.phrase_occurs(text, m.phrase):
                print("Warning: story.md does not use cast phrase %r; character %s gets no LoRA in "
                      "this story" % (m.phrase, m.name))
    if not args.no_review:
        input("Review story.md above. Enter to continue, Ctrl-C to abort: ")
    return 0


def _unused_path(path):
    """path if nothing exists there, else path with -2, -3, ... inserted before its extension:
    the first that does not exist, so a moved-aside or copied draft never replaces an earlier one
    (shots rules v2 spec 5.3)."""
    root, ext = os.path.splitext(path)
    candidate, k = path, 2
    while os.path.lexists(candidate):
        candidate = "%s-%d%s" % (root, k, ext)
        k += 1
    return candidate


def _shots_repair_s9(lib, story_md, members):
    """Insert every missing cast identity sentence into story.md in place (shots rules v2 spec
    5.3; character_lib.repair_cast_descriptions). When anything changes, the unrepaired bytes
    are first copied to story.pre-repair-<UTC stamp>-<pid>.md and one "Repaired S9 on panels
    ..." line is printed. Returns the sorted repaired panel numbers, [] when nothing changed or
    story.md cannot be read or decoded (validation then reports it)."""
    if not members:
        return []
    try:
        with open(story_md, "rb") as f:
            raw = f.read()
        text = raw.decode("utf-8")
    except (OSError, UnicodeDecodeError):
        return []
    repaired_text, repaired = lib.repair_cast_descriptions(text, members)
    if not repaired:
        return []
    keep = _unused_path(os.path.join(
        os.path.dirname(story_md), "story.pre-repair-%s-%d.md"
        % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), os.getpid())))
    with open(keep, "xb") as f:
        f.write(raw)
    temporary = story_md + ".repair.tmp"
    with open(temporary, "wb") as f:
        f.write(repaired_text.encode("utf-8"))
    os.replace(temporary, story_md)
    panels = sorted({number for number, _name in repaired})
    print("Repaired S9 on panels %s: inserted %d missing cast identity sentence(s); the "
          "unrepaired draft is kept at %s"
          % (",".join(str(n) for n in panels), len(repaired), keep))
    return panels


def _shots_check(lib, story_md, expected_panels, members, repair=False):
    """(violations, advisories) for a shots-mode story.md (shots spec 4). With repair, S9 is
    first repaired in place (shots rules v2 spec 5.3)."""
    if repair:
        _shots_repair_s9(lib, story_md, members)
    try:
        with open(story_md, encoding="utf-8") as f:
            text = f.read()
    except OSError as e:
        return ["story: cannot read story.md: %s" % e], []
    panels = _load_story_panels(story_md)
    return (lib.shots_violations(text, panels, expected_panels, members),
            lib.shots_advisories(panels, members))


def _phase1_shots_finish(args, story_md, authored):
    """Shots-mode Phase 1 after story.md exists (shots spec 5.4; shots rules v2 spec 5.3):
    validate; a draft the story model wrote in this run first gets its missing cast identity
    sentences inserted (S9 repair) and then up to SHOTS_MAX_REWRITES rewrites, each listing only
    the violations still present; then the story dump, the advisories, the cast-phrase warnings
    and the review gate. authored is None when Phase 1 was skipped: no repair, no rewrite. A
    story.md that Phase 1's call left unchanged (authored["before"], an os.stat taken before the
    call) is never repaired or validated: exit 1."""
    lib = _character_lib()
    members = getattr(args, "cast_members", None) or []
    before = (authored or {}).get("before")
    if before is not None and os.path.isfile(story_md):
        now = os.stat(story_md)
        if ((now.st_ino, now.st_mtime_ns, now.st_size)
                == (before.st_ino, before.st_mtime_ns, before.st_size)):
            print("Error: qwen-agent did not write %s; the existing file is unchanged since before "
                  "Phase 1 and was neither validated nor repaired. Rerun the same command to try "
                  "again." % story_md, file=sys.stderr)
            return 1
    violations, advisories = _shots_check(lib, story_md, args.panels, members,
                                          repair=authored is not None)
    if violations and authored is None:
        print("Error: story.md breaks the shot rules:", file=sys.stderr)
        for v in violations:
            print("  - %s" % v, file=sys.stderr)
        print("Hand-edit %s to fix the violations above and rerun, or pass --force-story to have "
              "the story model write a new one." % story_md, file=sys.stderr)
        return 2
    if violations and not os.path.isfile(story_md):
        print("Error: qwen-agent exited 0 without writing %s; nothing to rewrite. Rerun the same "
              "command to try again." % story_md, file=sys.stderr)
        return 1
    story_dir = os.path.dirname(story_md)
    rejected = []
    attempt = 0
    while violations:
        if attempt == lib.SHOTS_MAX_REWRITES:
            print("Error: story.md still breaks the shot rules after %d rewrites:" % attempt,
                  file=sys.stderr)
            for v in violations:
                print("  - %s" % v, file=sys.stderr)
            print("The rejected drafts are kept at %s. Hand-edit %s to fix the violations above "
                  "and rerun (Phase 1 is skipped while story.md exists), or rerun with "
                  "--force-story." % (", ".join(rejected), story_md), file=sys.stderr)
            return 2
        attempt += 1
        moved = _unused_path(os.path.join(story_dir, "story.rejected-%s-%d.md"
                                          % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()),
                                             os.getpid())))
        if attempt == 1:
            print("Warning: the story model's draft broke the shot rules; moving it to %s and "
                  "asking for rewrite 1 of %d:" % (moved, lib.SHOTS_MAX_REWRITES))
        else:
            print("Warning: rewrite %d still breaks the shot rules; moving it to %s and asking for "
                  "rewrite %d of %d:" % (attempt - 1, moved, attempt, lib.SHOTS_MAX_REWRITES))
        for v in violations:
            print("  - %s" % v)
        os.replace(story_md, moved)
        rejected.append(moved)
        rewrite = authored["prompt"] + "\n\n" + lib.shots_rewrite_block(violations, args.panels)
        name = ("story_prompt.rewrite.txt" if attempt == 1
                else "story_prompt.rewrite-%d.txt" % attempt)
        with open(os.path.join(story_dir, name), "w", encoding="utf-8") as f:
            f.write(rewrite)
        cmd = list(authored["cmd"])
        cmd[-1] = rewrite
        print("=== Phase 1: story (rewrite %d of %d) ===" % (attempt, lib.SHOTS_MAX_REWRITES))
        rc = _run_story_agent(cmd, authored["timeout"], story_md)
        if not rc and not os.path.isfile(story_md):
            print("Error: qwen-agent exited 0 without writing %s" % story_md, file=sys.stderr)
            rc = 1
        if rc:
            if os.path.isfile(story_md):
                moved = _unused_path(os.path.join(story_dir, "story.rejected-%s-%d.md"
                                                  % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()),
                                                     os.getpid())))
                os.replace(story_md, moved)
                rejected.append(moved)
            print("Error: shots rewrite %d of %d failed; the rejected draft(s) are kept at %s"
                  % (attempt, lib.SHOTS_MAX_REWRITES, ", ".join(rejected)), file=sys.stderr)
            return rc
        violations, advisories = _shots_check(lib, story_md, args.panels, members, repair=True)
    if not args.no_review:
        with open(story_md) as f:
            content = f.read()
        print("=== story.md ===")
        print(content)
    for a in advisories:
        print("Warning: %s" % a)
    if members:
        with open(story_md, encoding="utf-8") as f:
            text = f.read()
    for m in members:
        if not lib.phrase_occurs(text, m.phrase):
            print("Warning: story.md does not use cast phrase %r; character %s gets no LoRA in "
                  "this story" % (m.phrase, m.name))
    if not args.no_review:
        input("Review story.md above. Enter to continue, Ctrl-C to abort: ")
    return 0


# ---------------------------------------------------------------------------
# phase 2: stills
# ---------------------------------------------------------------------------

def _still_size(args):
    """Phase 2's still size, shared by the real phase and its dry-run mirror. Panel 1
    (whether z_image-rendered or fitted from --seed-image) is always produced at twice
    the video size; ltx-2-mlx then downscales it exactly (1/4 and 1/2) for its two
    conditioning passes, preserving more real detail than fitting straight to the
    video size would."""
    return 2 * args.video_width, 2 * args.video_height


def phase2_stills(args):
    paths = _story_paths(args.story_id)
    print("=== Phase 2: stills ===")
    if getattr(args, "shots", False) and getattr(args, "seed_image", None):
        if getattr(args, "seed_context", None):
            return _phase2_seed_context(args)     # seed context CX10: each still also sees the previous panel's
        return _phase2_shots_seed(args)       # shots seed edits SE8: every still is a Qwen edit of the seed
    still_w, still_h = _still_size(args)
    cmd = [sys.executable, os.path.join(WS, "bin", "ltx-story-images"),
           "--story-md", paths["story_md"], "--out-dir", paths["images_dir"],
           "--only", "1", "--width", str(still_w), "--height", str(still_h),
           "--seed", str(args.image_seed)]
    if getattr(args, "seed_image", None):
        cmd += ["--seed-image", args.seed_image]
        if getattr(args, "seed_edited_path", None):
            cmd[-1] = args.seed_edited_path            # QE49: Phase 1c's screened edit is panel 1's seed
    if getattr(args, "global_stills_loras", None):
        for path, strength in args.global_stills_loras:
            cmd += ["--lora", "%s:%s" % (path, repr(float(strength)))]
    elif args.stills_lora_path:
        cmd += ["--lora", args.stills_lora_path]
    error, catalog_flags = _catalog_stills_flags(args)
    if error:
        print(error, file=sys.stderr)
        return 2
    cmd += catalog_flags
    cmd += _cast_flags(args)
    cmd += _location_flags(args)
    if getattr(args, "shots", False):
        if getattr(args, "cast_refs", None):
            return _phase2_shots_cast_refs(args, cmd)   # cast refs CR10: two-character panels are Qwen edits
        return _phase2_shots(args, cmd)
    panel_01 = os.path.join(paths["images_dir"], "panel_01.png")
    if (getattr(args, "cast_members", None) and not getattr(args, "seed_image", None)
            and os.path.exists(panel_01)):
        print("Warning: %s exists and will be reused as-is; it was not necessarily rendered with "
              "the cast's stills LoRAs (delete it to regenerate)" % panel_01)
    print("Running: %s" % shlex.join(cmd))
    proc = subprocess.run(cmd, cwd=WS)
    if proc.returncode != 0:
        images_json = os.path.join(paths["images_dir"], "images.json")
        print("Error: ltx-story-images exited %d; see %s for which panels failed/were blocked"
              % (proc.returncode, images_json), file=sys.stderr)
        return 1
    return 0


def _panel_list(panels):
    return ",".join(str(i) for i in panels)


def _shots_stills_groups(story_md_path, members, locations=()):
    """[(names, [panel numbers])]: shots-mode panels grouped by the cast characters whose stills
    LoRAs bin/ltx-story-images will load for them -- the same _compose_prompt(Image:, Style:) +
    cast_text(insert=members with a stills LoRA) match it performs, so every group is one LoRA
    set (shots spec 5.5). Sorted by (len(names), names); panels ascending, 1-based by position.
    Uncast: one group of every panel. A panel whose plan.json beat is set at a pinned location
    with a stills LoRA adds "location NAME" to its names (location library spec L3.8)."""
    panels = _load_story_panels(story_md_path)
    by_panel = {i: () for i in range(1, len(panels) + 1)}
    if members:
        lib = _character_lib()
        images = importlib.machinery.SourceFileLoader(
            "ltx_story_images_for_movie", os.path.join(WS, "bin", "ltx-story-images")).load_module()
        style = images._style_text(panels)
        insert = {m.name for m in members if m.stills_lora}
        for i, p in enumerate(panels, start=1):
            by_panel[i] = tuple(lib.cast_text(images._compose_prompt(p["image"], style), members,
                                              insert=insert)[1])
    names = [pin.name for pin in locations if pin.stills_lora]
    if names:
        per_panel, _note = _location_lib().plan_panel_locations(os.path.dirname(story_md_path),
                                                                len(panels), names)
        for i, name in enumerate(per_panel, start=1):
            if name is not None:
                by_panel[i] += ("location " + name,)
    groups = {}
    for i, names in sorted(by_panel.items()):
        groups.setdefault(names, []).append(i)
    return sorted(groups.items(), key=lambda g: (len(g[0]), g[0]))


def _shots_missing_stills(args, panels):
    """The panels of one group whose still must be generated: those being redone, and those
    with no images/panel_NN.png."""
    images_dir = _story_paths(args.story_id)["images_dir"]
    redo = set(getattr(args, "redo_panels", None) or [])
    return [i for i in panels if i in redo
            or not os.path.exists(os.path.join(images_dir, "panel_%02d.png" % i))]


def _exclude_groups(groups, exclude):
    """groups without the panels in exclude, leaving out a group that has none left (cast refs spec CR11); groups
    itself when exclude is empty."""
    if not exclude:
        return groups
    kept = [(names, [i for i in panels if i not in exclude]) for names, panels in groups]
    return [(names, panels) for names, panels in kept if panels]


def _phase2_shots(args, cmd, exclude=()):
    """Phase 2 in shots mode (shots spec 5.5): one bin/ltx-story-images run per stills-LoRA group,
    each the Phase 2 cmd with --only <the group's panels> and --shots appended, teed to
    images/stills-group-KK.log. A group with no missing still is skipped. A failing group does
    not stop the rest: every group runs, then one error lists each failed group and Phase 2
    returns 1. Stills already written are kept. The panels in exclude (the cast-reference
    panels, cast refs spec CR11) are left out of every group."""
    paths = _story_paths(args.story_id)
    groups = _exclude_groups(_shots_stills_groups(paths["story_md"], getattr(args, "cast_members", None) or [],
                                                  getattr(args, "location_pins", None) or []), exclude)
    os.makedirs(paths["images_dir"], exist_ok=True)
    failed = []
    for k, (names, panels) in enumerate(groups, start=1):
        label = "%s; panels %s" % (", ".join(names) or "no character LoRAs", _panel_list(panels))
        if not _shots_missing_stills(args, panels):
            print("stills group %d/%d (%s): every still exists; skipped" % (k, len(groups), label))
            continue
        group_cmd = list(cmd)
        group_cmd[group_cmd.index("--only") + 1] = _panel_list(panels)
        group_cmd.append("--shots")
        log_path = os.path.join(paths["images_dir"], "stills-group-%02d.log" % k)
        print("stills group %d/%d (%s); log: %s" % (k, len(groups), label, log_path))
        print("Running: %s" % shlex.join(group_cmd))
        rc = _stream_and_tee(group_cmd, log_path)
        if rc != 0:
            failed.append("  - stills group %d/%d (%s) exited %d -- see %s"
                          % (k, len(groups), label, rc, log_path))
    if failed:
        print("Error: ltx-story-images exited nonzero for %d of %d stills groups:"
              % (len(failed), len(groups)), file=sys.stderr)
        for line in failed:
            print(line, file=sys.stderr)
        print("Stills already written are kept. If a log shows \"panel N BLOCKED\", edit that "
              "panel's Image: line in story.md first -- the stills seed is pinned, so a rerun alone "
              "reproduces the block. Then rerun the same command to continue -- groups whose stills "
              "all exist are skipped.", file=sys.stderr)
        return 1
    return 0


def phase_release_story_server(args):
    """Release the Phase-1 story LLM (Qwen3-VL-32B via vLLM-Metal, ~22 GiB) so Phases 2-4
    get its memory back. Opt-in via --story-server-stop-after-story; this runs between
    Phase 1 and Phase 2, before Phase 2 (bin/ltx-story-images is pure local GPU work and
    never talks to port 8177) even starts. FALSIFIED 2026-09-17 by SC10: releasing after
    Phase 2 instead left the vision server resident through Phase 2's stills, which pushed
    macOS swap past the render supervisor's absolute 3.0 GiB gate and failed every panel.
    """
    print("=== Phase 1b: release the story server ===")
    cmd = [os.path.join(WS, "bin", "story-server"), "stop"]
    print("Running: %s" % shlex.join(cmd))
    proc = subprocess.run(cmd, cwd=WS)
    if proc.returncode != 0:
        print("Error: story-server stop exited %d; the story LLM may still hold the memory "
              "the render needs" % proc.returncode, file=sys.stderr)
        return 1
    if not _wait_for_avail(args.min_avail_gib, args.avail_timeout):
        return 1
    return 0


def _seed_edit_paths(story_dir):
    """Phase 1c's files in the story directory (qwen edit models spec QE45)."""
    return {"original": os.path.join(story_dir, "seed-original.png"),
            "edited": os.path.join(story_dir, "seed-edited.png"),
            "record": os.path.join(story_dir, "seed_edit.json"),
            "work": os.path.join(story_dir, "seed_edit_work"),
            "stage": os.path.join(story_dir, "seed_edit_work", "seed-edited.pending.png")}


def _panel1_edit_prompt(story_md):
    """Panel 1's Image: text plus the story's Style: text, joined as bin/ltx-story-images joins them, or ""."""
    panels = _load_story_panels(story_md)
    if not panels:
        return ""
    images = importlib.machinery.SourceFileLoader(
        "ltx_story_images_for_movie", os.path.join(WS, "bin", "ltx-story-images")).load_module()
    return images._compose_prompt(panels[0]["image"], images._style_text(panels))


def _seed_edit_size(args, multiple):
    """Phase 1c's edit size (qwen edit models spec QE47): the video size floored to the model's multiple."""
    return (args.video_width // multiple * multiple, args.video_height // multiple * multiple)


def _write_seed_edit_record(path, record):
    """seed_edit.json, written atomically (<path>.tmp, then os.replace)."""
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(record, f, indent=2)
    os.replace(tmp, path)


def phase_seed_edit(args):
    """Phase 1c (qwen edit models spec QE48): edit the --seed-image into panel 1 with the Qwen registry model
    of --seed-edit-model, prompted by panel 1's Image: (and Style:) text, screened with content safety, and
    recorded in seed_edit.json; on success Phase 2 gets the edited image as its --seed-image. A rerun with
    the same seed bytes, prompt, seed, size and settings reuses an ok edit. Returns 0 or 1; a blocked or
    failed edit stops the movie (no fallback to the unedited seed)."""
    import hashlib
    qe = _qwen_edit()
    paths = _story_paths(args.story_id)
    files = _seed_edit_paths(paths["story_dir"])
    model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
    label = qe.label(model_id)
    print("=== Phase 1c: seed edit ===")
    prompt = _panel1_edit_prompt(paths["story_md"])
    if not prompt:
        print("Error: panel 1 of %s has no Image: description to edit the seed with" % paths["story_md"],
              file=sys.stderr)
        return 1
    width, height = _seed_edit_size(args, qe.multiple(model_id))
    with open(args.seed_image, "rb") as f:
        source_sha256 = hashlib.sha256(f.read()).hexdigest()
    key = dict(qe.settings(model_id, loras), source_sha256=source_sha256, prompt=prompt,
               seed=args.image_seed, width=width, height=height)
    try:
        with open(files["record"], encoding="utf-8") as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = None
    if (isinstance(old, dict) and old.get("status") == "ok" and os.path.isfile(files["edited"])
            and all(k in old and old[k] == v for k, v in key.items())):
        print("seed edit: reusing %s (same seed image, prompt, seed and settings)" % files["edited"])
        args.seed_edited_path = files["edited"]
        return 0
    _image_fit().load_oriented_rgb(args.seed_image).save(files["original"], format="PNG")
    for path in (files["record"], files["edited"], files["stage"]):
        if os.path.exists(path):
            os.remove(path)
    print("seed edit: %s; %dx%d; seed %d; prompt: panel 1's Image: text (%d characters)"
          % (qe.generator_text(model_id, loras), width, height, args.image_seed, len(prompt)))
    job = {"n": 1, "seed": args.image_seed, "prompt": prompt, "source": files["original"],
           "stage_path": files["stage"], "output_path": files["edited"]}
    try:
        qe.wait_for_memory(qe.memory_floor(model_id), label, tag="ltx-movie")
        results, failure = qe.run_jobs(model_id, loras, [job], width, height, SEED_EDIT_SKILL, files["work"])
    except qe.Unavailable as e:
        results, failure = None, str(e)
    result = results[0] if results else None
    status = "failed" if failure is not None or result is None else result["status"]
    settings = qe.settings(model_id, loras)
    _write_seed_edit_record(files["record"], {
        "schema": SEED_EDIT_SCHEMA, "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "status": status, "label": label, "source": os.path.abspath(args.seed_image),
        "source_sha256": source_sha256, "original": os.path.basename(files["original"]),
        "output": os.path.basename(files["edited"]) if status == "ok" else None, "prompt": prompt,
        "seed": args.image_seed, "width": width, "height": height, "qwen_model": settings["qwen_model"],
        "loras": settings["loras"], "steps": settings["steps"], "scheduler": settings["scheduler"],
        "seconds": result["seconds"] if result is not None else None, "error": failure})
    if failure is not None:
        print("Error: the seed edit failed: %s" % failure, file=sys.stderr)
        return 1
    if status == "blocked":
        print("Error: the content screen blocked the edited seed image (%s) for story %s; the movie stops here "
              "rather than use an unscreened or unedited panel 1. Change panel 1's Image: line in %s, or rerun "
              "with --seed-edit-model as-is to use the seed unchanged" % (label, args.story_id, paths["story_md"]),
              file=sys.stderr)
        return 1
    args.seed_edited_path = files["edited"]
    print("seed edit: %s (%.1f s)" % (files["edited"], result["seconds"]))
    return 0


def _shots_seed_paths(story_dir):
    """The shots seed edits' files in the story directory (shots seed edits spec SE9)."""
    return {"original": os.path.join(story_dir, "seed-original.png"),
            "record": os.path.join(story_dir, "seed_edits.json"),
            "work": os.path.join(story_dir, "seed_edits")}


def _sha256_file(path):
    """The sha256 hex digest of path's bytes (shots seed edits spec SE10)."""
    import hashlib
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def _shots_seed_prompts(story_md):
    """[(n, prompt)] for every panel of story.md (shots seed edits spec SE11): SHOTS_SEED_EDIT_PREFIX, then panel
    n's Image: text joined with the story's Style: text exactly as bin/ltx-story-images joins them. prompt is ""
    for a panel with no Image: text; [] when story.md has no panels."""
    panels = _load_story_panels(story_md)
    if not panels:
        return []
    images = importlib.machinery.SourceFileLoader(
        "ltx_story_images_for_movie", os.path.join(WS, "bin", "ltx-story-images")).load_module()
    style = images._style_text(panels)
    return [(n, SHOTS_SEED_EDIT_PREFIX + images._compose_prompt(p["image"], style) if p["image"].strip() else "")
            for n, p in enumerate(panels, start=1)]


def _shots_seed_entries(record_path, schema=SHOTS_SEED_EDITS_SCHEMA):
    """{n: entry} of seed_edits.json (shots seed edits spec SE12), or {} when it is missing, unreadable or not
    this schema (cast_ref_edits.json with CAST_REFS_SCHEMA, cast refs spec CR9)."""
    try:
        with open(record_path, encoding="utf-8") as f:
            record = json.load(f)
    except (OSError, ValueError):
        return {}
    if not (isinstance(record, dict) and record.get("schema") == schema
            and isinstance(record.get("panels"), list)):
        return {}
    return dict((e["n"], e) for e in record["panels"]
                if isinstance(e, dict) and isinstance(e.get("n"), int) and not isinstance(e.get("n"), bool))


def _write_shots_seed_record(path, entries, total, schema=SHOTS_SEED_EDITS_SCHEMA):
    """seed_edits.json (or, with CAST_REFS_SCHEMA, cast_ref_edits.json) with the entries of panels 1..total in panel
    order, written atomically (SE12; cast refs spec CR9)."""
    _write_seed_edit_record(path, {"schema": schema,
                                   "updated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                                   "panels": [entries[n] for n in sorted(entries) if 1 <= n <= total]})


def _shots_seed_plan(args, qe):
    """Phase 2's shots seed-edit plan, read-only (shots seed edits spec SE13): (error, plan). error is the text of
    an Error: line or None; plan is {"prompts": [(n, prompt)], "size": (W, H), "still": (SW, SH), "keys": {n: key},
    "entries": {n: entry}, "reuse": [n], "todo": [n]}. A panel is reused iff it is not a --redo panel, its entry is
    ok with every key item equal, and images/panel_NN.png exists with the entry's still_sha256."""
    paths = _story_paths(args.story_id)
    files = _shots_seed_paths(paths["story_dir"])
    model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
    prompts = _shots_seed_prompts(paths["story_md"])
    if not prompts:
        return "%s has no panels to edit the seed into" % paths["story_md"], None
    for n, prompt in prompts:
        if not prompt:
            return "panel %d of %s has no Image: description to edit the seed with" % (n, paths["story_md"]), None
    size = _seed_edit_size(args, qe.multiple(model_id))
    still = _still_size(args)
    source_sha256 = _sha256_file(args.seed_image)
    settings = qe.settings(model_id, loras)
    entries = _shots_seed_entries(files["record"])
    redo = set(getattr(args, "redo_panels", None) or [])
    keys, reuse, todo = {}, [], []
    for n, prompt in prompts:
        keys[n] = dict(settings, source_sha256=source_sha256, prompt=prompt, seed=args.image_seed,
                       width=size[0], height=size[1], still_width=still[0], still_height=still[1])
        entry = entries.get(n)
        path = os.path.join(paths["images_dir"], "panel_%02d.png" % n)
        if (n not in redo and isinstance(entry, dict) and entry.get("status") == "ok"
                and all(k in entry and entry[k] == v for k, v in keys[n].items())
                and os.path.isfile(path) and entry.get("still_sha256") == _sha256_file(path)):
            reuse.append(n)
        else:
            todo.append(n)
    return None, {"prompts": prompts, "size": size, "still": still, "keys": keys, "entries": entries,
                  "reuse": reuse, "todo": todo}


def _shots_seed_lora_note(args):
    """True when a Z-Image stills LoRA would have applied (shots seed edits spec SE14): a cast character or pinned
    location with a stills LoRA, or plan.json's catalog stills pick."""
    if any(m.stills_lora for m in getattr(args, "cast_members", None) or []):
        return True
    if any(pin.stills_lora for pin in getattr(args, "location_pins", None) or []):
        return True
    plan = _catalog_plan(args)
    return bool(plan and plan["loras"].get("stills"))


def _phase2_shots_seed(args):
    """Phase 2 in shots mode with a seed image (shots seed edits spec SE15): every panel's still is a Qwen edit of the
    original seed, prompted by SHOTS_SEED_EDIT_PREFIX and that panel's own Image: (and Style:) text, in one
    qwen_edit.run_jobs batch, screened with content safety, fitted into images/panel_NN.png at the still size and
    recorded per panel in seed_edits.json. Recorded edits of the same seed bytes, prompt, seed, sizes and settings
    are reused; every other panel's existing still is moved aside first. Returns 0 or 1; a blocked or failed panel
    fails the phase after the batch, with no fallback to the unedited seed or to Z-Image."""
    qe = _qwen_edit()
    paths = _story_paths(args.story_id)
    files = _shots_seed_paths(paths["story_dir"])
    model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
    label = qe.label(model_id)
    error, plan = _shots_seed_plan(args, qe)
    if error is not None:
        print("Error: %s" % error, file=sys.stderr)
        return 1
    if _shots_seed_lora_note(args):
        print(SHOTS_SEED_LORA_NOTE)
    entries, todo, total = plan["entries"], plan["todo"], len(plan["prompts"])
    if plan["reuse"]:
        print("seed edits: reusing the stills of panels %s (recorded edits of the same seed image, prompt, seed "
              "and settings)" % _panel_list(plan["reuse"]))
    if not todo:
        print("seed edits: every panel's still is a recorded edit of the same seed image, prompt, seed and "
              "settings; nothing to edit")
        return 0
    os.makedirs(paths["images_dir"], exist_ok=True)
    os.makedirs(files["work"], exist_ok=True)
    archive = os.path.join(paths["story_dir"], "redo", "%s-%d" % (
        time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), os.getpid()), "images")
    for n in todo:
        still = os.path.join(paths["images_dir"], "panel_%02d.png" % n)
        if os.path.lexists(still):
            os.makedirs(archive, exist_ok=True)
            moved = os.path.join(archive, os.path.basename(still))
            os.replace(still, moved)
            print("seed edits: moved %s -> %s (not a recorded edit of this seed image, prompt, seed and settings)"
                  % (still, moved))
        for name in ("panel_%02d.png" % n, "panel_%02d.pending.png" % n):
            if os.path.lexists(os.path.join(files["work"], name)):
                os.remove(os.path.join(files["work"], name))
        entries.pop(n, None)
    _write_shots_seed_record(files["record"], entries, total)
    fit = _image_fit()
    fit.load_oriented_rgb(args.seed_image).save(files["original"], format="PNG")
    (width, height), (still_w, still_h) = plan["size"], plan["still"]
    prompts = dict(plan["prompts"])
    print("seed edits: %s; %dx%d, fitted into %dx%d stills; seed %d; panels %s of %d, each prompted by its own "
          "Image: text" % (qe.generator_text(model_id, loras), width, height, still_w, still_h, args.image_seed,
                           _panel_list(todo), total))

    def record_entry(n, status, seconds, error_text):
        key = plan["keys"][n]
        ok = status == "ok"
        return {"n": n, "status": status, "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "label": label, "source": os.path.abspath(args.seed_image), "source_sha256": key["source_sha256"],
                "original": os.path.basename(files["original"]), "prompt": key["prompt"], "seed": key["seed"],
                "width": key["width"], "height": key["height"], "still_width": key["still_width"],
                "still_height": key["still_height"], "qwen_model": key["qwen_model"], "loras": key["loras"],
                "steps": key["steps"], "scheduler": key["scheduler"],
                "output": "seed_edits/panel_%02d.png" % n if ok else None,
                "still": "images/panel_%02d.png" % n if ok else None,
                "still_sha256": (_sha256_file(os.path.join(paths["images_dir"], "panel_%02d.png" % n))
                                 if ok else None),
                "seconds": seconds, "error": error_text}

    def on_result(result):
        n = result["n"]
        if result["status"] == "ok":
            still = os.path.join(paths["images_dir"], "panel_%02d.png" % n)
            fit.fit_letterbox(fit.load_oriented_rgb(result["output_path"]), still_w, still_h).save(
                still + ".tmp", format="PNG")
            os.replace(still + ".tmp", still)
            print("panel %d -> %s (Qwen edit of the seed, %.1fs)" % (n, still, result["seconds"]))
        else:
            print("panel %d BLOCKED: the content screen blocked the Qwen edit of the seed" % n)
        entries[n] = record_entry(n, result["status"], result["seconds"], None)
        _write_shots_seed_record(files["record"], entries, total)

    jobs = [{"n": n, "seed": args.image_seed, "prompt": prompts[n], "source": files["original"],
             "stage_path": os.path.join(files["work"], "panel_%02d.pending.png" % n),
             "output_path": os.path.join(files["work"], "panel_%02d.png" % n)} for n in todo]
    try:
        qe.wait_for_memory(qe.memory_floor(model_id), label, tag="ltx-movie")
        results, failure = qe.run_jobs(model_id, loras, jobs, width, height, SHOTS_SEED_EDIT_SKILL, files["work"],
                                       on_result=on_result, noun="panel")
    except qe.Unavailable as e:
        results, failure = None, str(e)
    status = dict((r["n"], r["status"]) for r in results or [])
    ok = [n for n in todo if status.get(n) == "ok"]
    blocked = [n for n in todo if status.get(n) == "blocked"]
    failed = [n for n in todo if n not in ok and n not in blocked]
    if failed and failure is None:
        failure = "%s reported no result for panels %s" % (label, _panel_list(failed))
    if failed:
        for n in failed:
            entries[n] = record_entry(n, "failed", None, failure)
        _write_shots_seed_record(files["record"], entries, total)
    if failure is not None:
        print("Error: the seed edits failed: %s (kept: %s; edited on the next run: %s)"
              % (failure, _panel_list(sorted(plan["reuse"] + ok)) or "none", _panel_list(sorted(failed + blocked))),
              file=sys.stderr)
    if blocked:
        print("Error: the content screen blocked the Qwen edit of the seed (%s) for panels %s of story %s; the movie "
              "stops here rather than use an unscreened, unedited or text-rendered still. Change those panels' Image: "
              "lines in %s, then rerun: every other panel's recorded still is reused"
              % (label, _panel_list(blocked), args.story_id, paths["story_md"]), file=sys.stderr)
    if failure is not None or blocked:
        return 1
    print("seed edits: %d panel stills written" % len(ok))
    return 0


def _seed_context_paths(story_dir):
    """The seed-context edits' files in the story directory (seed context spec CX5)."""
    return {"original": os.path.join(story_dir, "seed-original.png"),
            "record": os.path.join(story_dir, "seed_context_edits.json"),
            "work": os.path.join(story_dir, "seed_context_edits")}


def _seed_context_setting(lib, image):
    """The setting sentence of an Image: text (seed context spec CX4): its first sentence, split as character_lib
    splits sentences, that starts with "The setting is" (character_lib's S12 pattern), with its whitespace collapsed;
    None when it has none."""
    for sentence in lib._SENTENCE_SPLIT_RE.split(image.strip()):
        if lib._SETTING_SENTENCE_RE.match(sentence):
            return " ".join(sentence.split())
    return None


def _seed_context_prompt(order, text):
    """A context panel's edit prompt (seed context spec CX3): SEED_CONTEXT_PREFIX with the seed as Picture 1 and the
    context picture as Picture 2 (order seed-first), or the other way round (context-first), then text."""
    people, scene = (1, 2) if order == "seed-first" else (2, 1)
    nth = {1: "first", 2: "second"}
    return SEED_CONTEXT_PREFIX % {"people": people, "people_nth": nth[people], "scene": scene,
                                  "scene_nth": nth[scene]} + text


def _seed_context_plan(args, qe):
    """Phase 2's seed-context plan, read-only (seed context spec CX5): (error, plan). error is the text of an Error:
    line or None. plan is {"prompts": {n: prompt}, "kinds": {n: "none" or the mode}, "changes": [n], "size": (W, H),
    "still": (SW, SH), "base": {n: the key without its "context" item}, "entries": {n: entry}, "total": the panel
    count}. Panel 1 and every panel whose setting sentence (_seed_context_setting) differs from the previous panel's
    are kind "none", prompted exactly as seeded shots prompts them (SHOTS_SEED_EDIT_PREFIX); the location changes
    are those panels after panel 1. Every other panel is prompted by _seed_context_prompt."""
    paths = _story_paths(args.story_id)
    files = _seed_context_paths(paths["story_dir"])
    model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
    mode, order = args.seed_context["mode"], args.seed_context["order"]
    panels = _load_story_panels(paths["story_md"])
    if not panels:
        return "%s has no panels to edit the seed into" % paths["story_md"], None
    for n, p in enumerate(panels, start=1):
        if not p["image"].strip():
            return "panel %d of %s has no Image: description to edit the seed with" % (n, paths["story_md"]), None
    lib = _character_lib()
    images = importlib.machinery.SourceFileLoader(
        "ltx_story_images_for_movie", os.path.join(WS, "bin", "ltx-story-images")).load_module()
    style = images._style_text(panels)
    settings_of = [_seed_context_setting(lib, p["image"]) for p in panels]
    size = _seed_edit_size(args, qe.multiple(model_id))
    still = _still_size(args)
    source_sha256 = _sha256_file(args.seed_image)
    settings = qe.settings(model_id, loras)
    prompts, kinds, base = {}, {}, {}
    for n, p in enumerate(panels, start=1):
        text = images._compose_prompt(p["image"], style)
        kinds[n] = "none" if n == 1 or settings_of[n - 1] != settings_of[n - 2] else mode
        prompts[n] = SHOTS_SEED_EDIT_PREFIX + text if kinds[n] == "none" else _seed_context_prompt(order, text)
        base[n] = dict(settings, source_sha256=source_sha256, prompt=prompts[n], seed=args.image_seed,
                       width=size[0], height=size[1], still_width=still[0], still_height=still[1])
    return None, {"prompts": prompts, "kinds": kinds, "changes": [n for n in sorted(kinds) if n > 1
                                                                  and kinds[n] == "none"],
                  "size": size, "still": still, "base": base,
                  "entries": _shots_seed_entries(files["record"], SEED_CONTEXT_SCHEMA), "total": len(panels)}


def _seed_context_context(args, plan, n, path):
    """The "context" item of panel n's key (seed context spec CX6): {"kind", "file", "sha256", "picture"}. path is
    the context picture's file (unused for kind "none"); file is its path relative to the story directory; sha256 is
    its digest, or None while it does not exist; picture is its picture number."""
    kind = plan["kinds"][n]
    if kind == "none":
        return {"kind": "none", "file": None, "sha256": None, "picture": None}
    return {"kind": kind, "file": os.path.relpath(path, _story_paths(args.story_id)["story_dir"]),
            "sha256": _sha256_file(path) if os.path.isfile(path) else None,
            "picture": 2 if args.seed_context["order"] == "seed-first" else 1}


def _seed_context_reusable(args, plan, n, context, changed):
    """True when panel n's recorded still is reused (seed context spec CX7): n is not a --redo panel; it is kind
    "none" or panel n-1 is not in changed (the panels whose still was edited earlier in this run); its entry is ok
    with every key item equal (the base key plus context); and images/panel_NN.png exists with the entry's
    still_sha256."""
    key = dict(plan["base"][n], context=context)
    entry = plan["entries"].get(n)
    path = os.path.join(_story_paths(args.story_id)["images_dir"], "panel_%02d.png" % n)
    return (n not in set(getattr(args, "redo_panels", None) or [])
            and (context["kind"] == "none" or n - 1 not in changed)
            and isinstance(entry, dict) and entry.get("status") == "ok"
            and all(k in entry and entry[k] == v for k, v in key.items())
            and os.path.isfile(path) and entry.get("still_sha256") == _sha256_file(path))


def _seed_context_cascade(plan, start):
    """The panels after start whose context picture comes from start's still, directly or through each other: start+1,
    start+2, ... up to the next kind "none" panel (seed context spec CX7)."""
    out = []
    n = start + 1
    while n <= plan["total"] and plan["kinds"][n] != "none":
        out.append(n)
        n += 1
    return out


def _seed_context_notes(args, plan):
    """The location-change line and the --redo cascade note (seed context spec CX7, CX10)."""
    if plan["changes"]:
        print(SEED_CONTEXT_CHANGE_NOTE % _panel_list(plan["changes"]))
    redo = getattr(args, "redo_panels", None) or []
    extra = sorted(set(m for r in redo for m in _seed_context_cascade(plan, r)) - set(redo))
    if extra:
        print(SEED_CONTEXT_REDO_NOTE % (_panel_list(redo), _panel_list(extra),
                                        SEED_CONTEXT_KINDS[args.seed_context["mode"]]))


def _seed_context_edit(args, qe, plan, n, path, context, archive):
    """Edit panel n's still (seed context spec CX8): one qwen_edit.run_jobs call with one job, after moving an
    existing images/panel_NN.png into archive and clearing the panel's work files, its child log, its entry and the
    entries of the panels that see its still (_seed_context_cascade), which are edited again after it. A kind "none"
    job edits the seed alone; any other job also carries "sources", the seed and the context picture path in picture
    order. The output is screened, fitted into images/panel_NN.png and recorded. Returns (status, failure): status
    is ok, blocked or failed; failure is the failure text or None. Any Exception (not KeyboardInterrupt or
    SystemExit) raised by the memory wait or the batch becomes a failed entry and a failure text."""
    paths = _story_paths(args.story_id)
    files = _seed_context_paths(paths["story_dir"])
    model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
    label = qe.label(model_id)
    entries, total = plan["entries"], plan["total"]
    (width, height), (still_w, still_h) = plan["size"], plan["still"]
    still = os.path.join(paths["images_dir"], "panel_%02d.png" % n)
    if os.path.lexists(still):
        os.makedirs(archive, exist_ok=True)
        moved = os.path.join(archive, os.path.basename(still))
        os.replace(still, moved)
        print("seed context: moved %s -> %s (not a recorded edit of this seed image, context picture, prompt, seed "
              "and settings)" % (still, moved))
    log_path = os.path.join(files["work"], "child-%02d.log" % n)
    for name in ("panel_%02d.png" % n, "panel_%02d.pending.png" % n, os.path.basename(log_path)):
        if os.path.lexists(os.path.join(files["work"], name)):
            os.remove(os.path.join(files["work"], name))
    for m in [n] + _seed_context_cascade(plan, n):
        entries.pop(m, None)
    _write_shots_seed_record(files["record"], entries, total, SEED_CONTEXT_SCHEMA)
    job = {"n": n, "seed": args.image_seed, "prompt": plan["prompts"][n], "source": files["original"],
           "stage_path": os.path.join(files["work"], "panel_%02d.pending.png" % n),
           "output_path": os.path.join(files["work"], "panel_%02d.png" % n)}
    if context["kind"] == "none":
        print("seed context: panel %d: a single-image edit of the seed%s"
              % (n, "" if n == 1 else " (a location change: its setting sentence differs from panel %d's)" % (n - 1)))
    else:
        job["sources"] = [files["original"], path] if context["picture"] == 2 else [path, files["original"]]
        job["source"] = job["sources"][0]
        print("seed context: panel %d: Picture %d is the seed (%s), Picture %d is %s (%s)"
              % (n, 3 - context["picture"], files["original"], context["picture"],
                 SEED_CONTEXT_PICTURES[context["kind"]] % (n - 1), path))
    fit = _image_fit()

    def record_entry(status, seconds, error_text):
        key = dict(plan["base"][n], context=context)
        ok = status == "ok"
        return {"n": n, "status": status, "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "label": label, "source": os.path.abspath(args.seed_image), "source_sha256": key["source_sha256"],
                "original": os.path.basename(files["original"]), "context": key["context"], "prompt": key["prompt"],
                "seed": key["seed"], "width": key["width"], "height": key["height"],
                "still_width": key["still_width"], "still_height": key["still_height"],
                "qwen_model": key["qwen_model"], "loras": key["loras"], "steps": key["steps"],
                "scheduler": key["scheduler"],
                "output": "seed_context_edits/panel_%02d.png" % n if ok else None,
                "still": "images/panel_%02d.png" % n if ok else None,
                "still_sha256": _sha256_file(still) if ok else None, "seconds": seconds, "error": error_text}

    def on_result(result):
        if result["status"] == "ok":
            fit.fit_letterbox(fit.load_oriented_rgb(result["output_path"]), still_w, still_h).save(
                still + ".tmp", format="PNG")
            os.replace(still + ".tmp", still)
            print("panel %d -> %s (seed-context Qwen edit, %.1fs)" % (n, still, result["seconds"]))
        else:
            print("panel %d BLOCKED: the content screen blocked the seed-context Qwen edit" % n)
        entries[n] = record_entry(result["status"], result["seconds"], None)
        _write_shots_seed_record(files["record"], entries, total, SEED_CONTEXT_SCHEMA)

    try:
        qe.wait_for_memory(qe.memory_floor(model_id), label, tag="ltx-movie")
        results, failure = qe.run_jobs(model_id, loras, [job], width, height, SEED_CONTEXT_SKILL, files["work"],
                                       log_path=log_path, on_result=on_result, noun="panel")
    except qe.Unavailable as e:
        results, failure = None, str(e)
    except Exception as e:      # seed context CX8: a failed entry and an Error: line, never a traceback
        results, failure = None, "%s: %s" % (type(e).__name__, e)
    status = results[0]["status"] if results else "failed"
    if status not in ("ok", "blocked"):
        status = "failed"
    if status == "failed":
        if failure is None:
            failure = "%s reported no result for panel %d" % (label, n)
        entries[n] = record_entry("failed", None, failure)
        _write_shots_seed_record(files["record"], entries, total, SEED_CONTEXT_SCHEMA)
    return status, failure


def _seed_context_stop(args, plan, n, status, failure, label):
    """The Error: line of a panel that stops the seed-context edits (seed context spec CX8)."""
    paths = _story_paths(args.story_id)
    if failure is not None:
        print("Error: the seed-context edit of panel %d failed: %s; the stills before it are kept, and a rerun "
              "continues from panel %d" % (n, failure, n), file=sys.stderr)
    else:
        print("Error: the content screen blocked the seed-context Qwen edit (%s) of panel %d of story %s; the movie "
              "stops here rather than use an unscreened, unedited or text-rendered still. Change that panel's Image: "
              "line in %s, then rerun: every recorded still before it is reused"
              % (label, n, args.story_id, paths["story_md"]), file=sys.stderr)


def _phase2_seed_context(args):
    """Phase 2 in seeded shots mode with --seed-context still (seed context spec CX10): every panel's still is a Qwen
    edit of the original seed, in panel order, one qwen_edit.run_jobs call (one child) per edited panel: a kind
    "none" panel (panel 1 and every location change) edits the seed alone, every other panel the seed and the
    previous panel's still. A panel is reused by _seed_context_reusable. The first blocked or failed panel stops the
    phase (exit 1), with no fallback."""
    qe = _qwen_edit()
    paths = _story_paths(args.story_id)
    files = _seed_context_paths(paths["story_dir"])
    model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
    error, plan = _seed_context_plan(args, qe)
    if error is not None:
        print("Error: %s" % error, file=sys.stderr)
        return 1
    if _shots_seed_lora_note(args):
        print(SHOTS_SEED_LORA_NOTE)
    _seed_context_notes(args, plan)
    (width, height), (still_w, still_h) = plan["size"], plan["still"]
    picture = 2 if args.seed_context["order"] == "seed-first" else 1
    print("seed context: %s; %dx%d, fitted into %dx%d stills; seed %d; %d panels in order, one Qwen child per edited "
          "panel; the seed is Picture %d and %s is Picture %d" % (
              qe.generator_text(model_id, loras), width, height, still_w, still_h, args.image_seed, plan["total"],
              3 - picture, SEED_CONTEXT_KINDS[args.seed_context["mode"]], picture))
    os.makedirs(paths["images_dir"], exist_ok=True)
    os.makedirs(files["work"], exist_ok=True)
    _image_fit().load_oriented_rgb(args.seed_image).save(files["original"], format="PNG")
    archive = os.path.join(paths["story_dir"], "redo", "%s-%d" % (
        time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), os.getpid()), "images")
    changed, reused = set(), []
    for n in range(1, plan["total"] + 1):
        path = os.path.join(paths["images_dir"], "panel_%02d.png" % (n - 1))
        context = _seed_context_context(args, plan, n, path)
        if _seed_context_reusable(args, plan, n, context, changed):
            reused.append(n)
            print("seed context: panel %d: reusing %s (a recorded edit of the same seed image, context picture, "
                  "prompt, seed and settings)" % (n, os.path.join(paths["images_dir"], "panel_%02d.png" % n)))
            continue
        status, failure = _seed_context_edit(args, qe, plan, n, path, context, archive)
        changed.add(n)
        if failure is not None or status != "ok":
            _seed_context_stop(args, plan, n, status, failure, qe.label(model_id))
            return 1
    print("seed context: %d panel stills written, %d reused" % (len(changed), len(reused)))
    return 0


def _render_tool():
    """bin/ltx-mlx-render's path: Phase 4 renders with it, and --seed-context frame renders with it and loads it for
    extract_last_frame and check_chain_seed (seed context spec CX15)."""
    return os.path.join(WS, "bin", "ltx-mlx-render")


def _ltx_render():
    """bin/ltx-mlx-render, loaded by path and only by --seed-context frame (seed context spec CX15)."""
    return importlib.machinery.SourceFileLoader("ltx_mlx_render_for_movie", _render_tool()).load_module()


def phase_seed_context_frames(args):
    """Phase 2 in seeded shots mode with --seed-context frame (seed context spec CX15-CX19), in place of
    phase2_stills: the manifest is built once with a placeholder still for every panel; then, for each panel k in
    order, still k is reused or edited (the context picture of a kind "frame" panel is the exact last frame of clip
    k-1), a manifest of panels 1..k with their real stills is written to seed_context_edits/manifest_upto.json and
    bin/ltx-movie runs bin/ltx-mlx-render --resume on it (clips 1..k-1 are reused, clip k renders), and clip k's last
    frame is extracted and checked when panel k+1 needs it. Phase 3 and Phase 4 then rebuild the manifest and reuse
    every clip. Each partial render uses Phase 4's flags (skip plus one retry); a clip still failing after the retry
    makes bin/ltx-mlx-render exit non-zero, which stops the run. The first blocked or failed still, failed clip or
    bad frame stops the run, with no fallback."""
    print("=== Phase 2: stills and clips, panel by panel (seed context frame) ===")
    qe = _qwen_edit()
    paths = _story_paths(args.story_id)
    files = _seed_context_paths(paths["story_dir"])
    model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
    if os.path.exists(paths["movie_path"]) and not args.force:
        print("Error: %s already exists; pass --force to overwrite" % paths["movie_path"], file=sys.stderr)
        return 2
    error, plan = _seed_context_plan(args, qe)
    if error is not None:
        print("Error: %s" % error, file=sys.stderr)
        return 1
    if _shots_seed_lora_note(args):
        print(SHOTS_SEED_LORA_NOTE)
    _seed_context_notes(args, plan)
    (width, height), (still_w, still_h) = plan["size"], plan["still"]
    picture = 2 if args.seed_context["order"] == "seed-first" else 1
    total = plan["total"]
    print("seed context: %s; %dx%d, fitted into %dx%d stills; seed %d; %d panels in order, one Qwen child per edited "
          "panel; the seed is Picture %d and %s is Picture %d" % (
              qe.generator_text(model_id, loras), width, height, still_w, still_h, args.image_seed, total,
              3 - picture, SEED_CONTEXT_KINDS["frame"], picture))
    os.makedirs(paths["images_dir"], exist_ok=True)
    os.makedirs(files["work"], exist_ok=True)
    fit = _image_fit()
    fit.load_oriented_rgb(args.seed_image).save(files["original"], format="PNG")
    placeholder = os.path.join(files["work"], "placeholder.png")
    fit.fit_letterbox(fit.load_oriented_rgb(args.seed_image), still_w, still_h).save(placeholder, format="PNG")
    rc, cmd = _phase3_manifest_cmd(args, ["--image", placeholder] * total)
    if rc:
        return rc
    log = os.path.join(files["work"], "manifest.log")
    print("seed context: the manifest, built once with %s as every panel's still until it is made; log: %s"
          % (placeholder, log))
    print("Running: %s" % shlex.join(cmd))
    rc = _stream_and_tee(cmd, log)
    if rc != 0:
        print("Error: ltx-story-manifest exited %d; see %s" % (rc, log), file=sys.stderr)
        return 1
    try:
        with open(paths["manifest_path"], encoding="utf-8") as f:
            manifest = json.load(f)
        panels = list(manifest["panels"])
    except (OSError, ValueError, KeyError, TypeError) as e:
        print("Error: cannot read %s: %s" % (paths["manifest_path"], e), file=sys.stderr)
        return 1
    if len(panels) != total:
        print("Error: %s has %d panels and %s has %d" % (paths["manifest_path"], len(panels), paths["story_md"], total),
              file=sys.stderr)
        return 1
    try:
        render = _ltx_render()
    except Exception as e:      # seed context CX19: an Error: line, never a traceback
        print("Error: cannot load %s: %s: %s" % (_render_tool(), type(e).__name__, e), file=sys.stderr)
        return 1
    if not args.no_review:
        input(SEED_CONTEXT_FRAME_GATE)
    archive = os.path.join(paths["story_dir"], "redo", "%s-%d" % (
        time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), os.getpid()), "images")
    upto_json = os.path.join(files["work"], "manifest_upto.json")
    upto_mp4 = os.path.join(files["work"], "upto.mp4")
    changed, reused = set(), []
    for k in range(1, total + 1):
        path = os.path.join(files["work"], "frame_%02d.png" % (k - 1))
        context = _seed_context_context(args, plan, k, path)
        if _seed_context_reusable(args, plan, k, context, changed):
            reused.append(k)
            print("seed context: panel %d: reusing %s (a recorded edit of the same seed image, context picture, "
                  "prompt, seed and settings)" % (k, os.path.join(paths["images_dir"], "panel_%02d.png" % k)))
        else:
            status, failure = _seed_context_edit(args, qe, plan, k, path, context, archive)
            changed.add(k)
            if failure is not None or status != "ok":
                _seed_context_stop(args, plan, k, status, failure, qe.label(model_id))
                return 1
        _write_seed_edit_record(upto_json, dict(manifest, panels=[
            dict(p, image_path=os.path.abspath(os.path.join(paths["images_dir"], "panel_%02d.png" % j)))
            for j, p in enumerate(panels[:k], start=1)]))
        if os.path.lexists(upto_mp4):
            os.remove(upto_mp4)
        if not _wait_for_avail(args.min_avail_gib, args.avail_timeout):
            return 1
        cmd = [sys.executable, _render_tool(), upto_json, upto_mp4] + _phase4_flags(args)
        log = os.path.join(files["work"], "render-%02d.log" % k)
        print("seed context: panel %d: its clip (bin/ltx-mlx-render --resume on panels 1-%d); log: %s" % (k, k, log))
        print("Running: %s" % shlex.join(cmd))
        rc = _stream_and_tee(cmd, log)
        if rc != 0:
            print("Error: ltx-mlx-render exited %d on panels 1-%d, so panel %d's clip is not made; frame mode stops "
                  "here (see %s); a rerun reuses every recorded still and finished clip" % (rc, k, k, log),
                  file=sys.stderr)
            return 1
        if os.path.lexists(upto_mp4):
            os.remove(upto_mp4)
        if k < total and plan["kinds"][k + 1] == "frame":
            frame = os.path.join(files["work"], "frame_%02d.png" % k)
            clip = os.path.join(paths["story_dir"], "clips", "panel_%02d.mp4" % k)
            try:
                problems = (render.extract_last_frame(clip, frame, args.frames)
                            or render.check_chain_seed(frame, args.video_width, args.video_height, k))
            except Exception as e:      # seed context CX19: an Error: line, never a traceback
                problems = ["%s: %s" % (type(e).__name__, e)]
            if problems:
                print("Error: panel %d's context frame (the last frame of %s): %s" % (k + 1, clip, "; ".join(problems)),
                      file=sys.stderr)
                return 1
            print("seed context: panel %d: the last frame of %s -> %s" % (k + 1, clip, frame))
    print("seed context: %d panel stills written, %d reused; every clip is made, so Phase 4 reuses them all"
          % (len(changed), len(reused)))
    return 0


def _cast_refs_paths(story_dir):
    """The cast-reference edits' files in the story directory (cast refs spec CR9)."""
    return {"record": os.path.join(story_dir, "cast_ref_edits.json"),
            "work": os.path.join(story_dir, "cast_ref_edits")}


def _cast_refs_side(lib, text, phrase, other):
    """"left" or "right" when text puts phrase on one side of the frame, else None (cast refs spec CR8): the first
    occurrence of phrase whose words, up to the next mention of either phrase or the next . ! ? or ;, name screen
    positions (CAST_REFS_SIDE_PATTERN) of exactly one side."""
    import re
    mine, theirs, stop = lib._phrase_regex(phrase), lib._phrase_regex(other), re.compile(CAST_REFS_STOP_PATTERN)
    for match in mine.finditer(text):
        ends = [m.start() for m in (mine.search(text, match.end()), theirs.search(text, match.end()),
                                     stop.search(text, match.end())) if m]
        segment = text[match.end():min(ends) if ends else len(text)]
        sides = set(next(g for g in m.groups() if g).lower()
                    for m in re.finditer(CAST_REFS_SIDE_PATTERN, segment, re.IGNORECASE))
        if len(sides) == 1:
            return sides.pop()
    return None


def _cast_refs_prompt(lib, pair, text):
    """A cast-reference panel's edit prompt (cast refs spec CR8): CAST_REFS_EDIT_PREFIX with pair[0] as Picture 1 and
    pair[1] as Picture 2, plus CAST_REFS_POSITION when text puts them on different sides, then text (the panel's
    Image: text joined with the Style: text). No LoRA trigger word is inserted."""
    a, b = pair[0].phrase, pair[1].phrase
    sides = (_cast_refs_side(lib, text, a, b), _cast_refs_side(lib, text, b, a))
    position = CAST_REFS_POSITION % (a, sides[0], b, sides[1]) if None not in sides and sides[0] != sides[1] else ""
    return CAST_REFS_EDIT_PREFIX % {"a": a, "b": b, "A": a[:1].upper() + a[1:], "position": position} + text


def _cast_refs_plan(args, qe):
    """Phase 2's cast-reference plan, read-only (cast refs spec CR9): (error, plan). error is the text of an Error:
    line or None. A cast-reference panel is one whose Image: text, joined with the Style: text, names exactly two
    cast characters (character_lib.cast_text); its pair lists them in cast order. A panel naming three or more is an
    error. plan is {"pairs": {n: [member, member]}, "prompts": {n: prompt}, "size": (W, H), "still": (SW, SH),
    "keys": {n: key}, "entries": {n: entry}, "reuse": [n], "todo": [n], "total": the panel count}. A panel is reused
    iff it is not a --redo panel, its entry is ok with every key item equal, and images/panel_NN.png exists with the
    entry's still_sha256."""
    paths = _story_paths(args.story_id)
    model_id, loras = args.cast_refs["qwen_model"], args.cast_refs["loras"]
    panels = _load_story_panels(paths["story_md"])
    if not panels:
        return "%s has no panels" % paths["story_md"], None
    lib = _character_lib()
    images = importlib.machinery.SourceFileLoader(
        "ltx_story_images_for_movie", os.path.join(WS, "bin", "ltx-story-images")).load_module()
    style = images._style_text(panels)
    members = args.cast_members
    pairs, prompts = {}, {}
    for n, p in enumerate(panels, start=1):
        text = images._compose_prompt(p["image"], style)
        names = lib.cast_text(text, members)[1]
        if len(names) > 2:
            return ("panel %d of %s names %d cast characters (%s); --cast-refs-model takes exactly two per panel"
                    % (n, paths["story_md"], len(names), ", ".join(names))), None
        if len(names) == 2:
            pairs[n] = [m for m in members if m.name in names]
            prompts[n] = _cast_refs_prompt(lib, pairs[n], text)
    still = _still_size(args)
    multiple = qe.multiple(model_id)
    size = (still[0] // multiple * multiple, still[1] // multiple * multiple)
    stills = args.cast_refs["stills"]
    digests = dict((name, _sha256_file(path)) for name, path in stills.items())
    settings = qe.settings(model_id, loras)
    entries = _shots_seed_entries(_cast_refs_paths(paths["story_dir"])["record"], CAST_REFS_SCHEMA)
    redo = set(getattr(args, "redo_panels", None) or [])
    keys, reuse, todo = {}, [], []
    for n in sorted(pairs):
        sources = [{"name": m.name, "still": os.path.basename(stills[m.name]), "sha256": digests[m.name]}
                   for m in pairs[n]]
        keys[n] = dict(settings, sources=sources, prompt=prompts[n], seed=args.image_seed, width=size[0],
                       height=size[1], still_width=still[0], still_height=still[1])
        entry = entries.get(n)
        path = os.path.join(paths["images_dir"], "panel_%02d.png" % n)
        if (n not in redo and isinstance(entry, dict) and entry.get("status") == "ok"
                and all(k in entry and entry[k] == v for k, v in keys[n].items())
                and os.path.isfile(path) and entry.get("still_sha256") == _sha256_file(path)):
            reuse.append(n)
        else:
            todo.append(n)
    return None, {"pairs": pairs, "prompts": prompts, "size": size, "still": still, "keys": keys,
                  "entries": entries, "reuse": reuse, "todo": todo, "total": len(panels)}


def _phase2_cast_refs_batch(args, qe, plan):
    """The cast-reference edits of plan["todo"] in one qwen_edit.run_jobs batch (cast refs spec CR10): each job's
    sources are its pair's reference stills in cast order; every output is screened with content safety, fitted into
    images/panel_NN.png at the still size and recorded in cast_ref_edits.json. A todo panel's existing still is moved
    aside first. Returns 0 or 1; a blocked or failed panel returns 1 after the batch, with no fallback to Z-Image."""
    paths = _story_paths(args.story_id)
    files = _cast_refs_paths(paths["story_dir"])
    model_id, loras = args.cast_refs["qwen_model"], args.cast_refs["loras"]
    label = qe.label(model_id)
    stills = args.cast_refs["stills"]
    entries, todo, total = plan["entries"], plan["todo"], plan["total"]
    if plan["reuse"]:
        print("cast refs: reusing the stills of panels %s (recorded edits of the same pictures, prompt, seed and "
              "settings)" % _panel_list(plan["reuse"]))
    if not todo:
        print("cast refs: every cast-reference panel's still is a recorded edit of the same pictures, prompt, seed "
              "and settings; nothing to edit")
        return 0
    os.makedirs(paths["images_dir"], exist_ok=True)
    os.makedirs(files["work"], exist_ok=True)
    archive = os.path.join(paths["story_dir"], "redo", "%s-%d" % (
        time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), os.getpid()), "images")
    for n in todo:
        still = os.path.join(paths["images_dir"], "panel_%02d.png" % n)
        if os.path.lexists(still):
            os.makedirs(archive, exist_ok=True)
            moved = os.path.join(archive, os.path.basename(still))
            os.replace(still, moved)
            print("cast refs: moved %s -> %s (not a recorded cast-reference edit of these pictures, prompt, seed "
                  "and settings)" % (still, moved))
        for name in ("panel_%02d.png" % n, "panel_%02d.pending.png" % n):
            if os.path.lexists(os.path.join(files["work"], name)):
                os.remove(os.path.join(files["work"], name))
        entries.pop(n, None)
    _write_shots_seed_record(files["record"], entries, total, CAST_REFS_SCHEMA)
    fit = _image_fit()
    (width, height), (still_w, still_h) = plan["size"], plan["still"]
    print("cast refs: %s; %dx%d, fitted into %dx%d stills; seed %d; panels %s, each with its two characters' "
          "reference stills as Picture 1 and Picture 2" % (qe.generator_text(model_id, loras), width, height,
                                                           still_w, still_h, args.image_seed, _panel_list(todo)))
    for n in todo:
        print("cast refs: panel %d: Picture 1 %s (%s), Picture 2 %s (%s)"
              % (n, plan["pairs"][n][0].name, stills[plan["pairs"][n][0].name], plan["pairs"][n][1].name,
                 stills[plan["pairs"][n][1].name]))

    def record_entry(n, status, seconds, error_text):
        key = plan["keys"][n]
        ok = status == "ok"
        return {"n": n, "status": status, "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "label": label, "sources": key["sources"],
                "source_paths": [os.path.abspath(stills[m.name]) for m in plan["pairs"][n]],
                "prompt": key["prompt"], "seed": key["seed"], "width": key["width"], "height": key["height"],
                "still_width": key["still_width"], "still_height": key["still_height"],
                "qwen_model": key["qwen_model"], "loras": key["loras"], "steps": key["steps"],
                "scheduler": key["scheduler"],
                "output": "cast_ref_edits/panel_%02d.png" % n if ok else None,
                "still": "images/panel_%02d.png" % n if ok else None,
                "still_sha256": (_sha256_file(os.path.join(paths["images_dir"], "panel_%02d.png" % n))
                                 if ok else None),
                "seconds": seconds, "error": error_text}

    def on_result(result):
        n = result["n"]
        if result["status"] == "ok":
            still = os.path.join(paths["images_dir"], "panel_%02d.png" % n)
            fit.fit_letterbox(fit.load_oriented_rgb(result["output_path"]), still_w, still_h).save(
                still + ".tmp", format="PNG")
            os.replace(still + ".tmp", still)
            print("panel %d -> %s (cast-reference Qwen edit, %.1fs)" % (n, still, result["seconds"]))
        else:
            print("panel %d BLOCKED: the content screen blocked the cast-reference Qwen edit" % n)
        entries[n] = record_entry(n, result["status"], result["seconds"], None)
        _write_shots_seed_record(files["record"], entries, total, CAST_REFS_SCHEMA)

    jobs = []
    for n in todo:
        sources = [stills[m.name] for m in plan["pairs"][n]]
        jobs.append({"n": n, "seed": args.image_seed, "prompt": plan["prompts"][n], "source": sources[0],
                     "sources": sources, "stage_path": os.path.join(files["work"], "panel_%02d.pending.png" % n),
                     "output_path": os.path.join(files["work"], "panel_%02d.png" % n)})
    try:
        qe.wait_for_memory(qe.memory_floor(model_id), label, tag="ltx-movie")
        results, failure = qe.run_jobs(model_id, loras, jobs, width, height, CAST_REFS_SKILL, files["work"],
                                       log_path=os.path.join(files["work"], "child.log"), on_result=on_result,
                                       noun="panel")
    except qe.Unavailable as e:
        results, failure = None, str(e)
    status = dict((r["n"], r["status"]) for r in results or [])
    ok = [n for n in todo if status.get(n) == "ok"]
    blocked = [n for n in todo if status.get(n) == "blocked"]
    failed = [n for n in todo if n not in ok and n not in blocked]
    if failed and failure is None:
        failure = "%s reported no result for panels %s" % (label, _panel_list(failed))
    if failed:
        for n in failed:
            entries[n] = record_entry(n, "failed", None, failure)
        _write_shots_seed_record(files["record"], entries, total, CAST_REFS_SCHEMA)
    if failure is not None:
        print("Error: the cast-reference edits failed: %s (kept: %s; edited on the next run: %s)"
              % (failure, _panel_list(sorted(plan["reuse"] + ok)) or "none", _panel_list(sorted(failed + blocked))),
              file=sys.stderr)
    if blocked:
        print("Error: the content screen blocked the cast-reference Qwen edit (%s) of panels %s of story %s; the "
              "movie stops here rather than use an unscreened or Z-Image still. Change those panels' Image: lines in "
              "%s, then rerun: every other panel's still is reused"
              % (label, _panel_list(blocked), args.story_id, paths["story_md"]), file=sys.stderr)
    if failure is not None or blocked:
        return 1
    print("cast refs: %d panel stills written" % len(ok))
    return 0


def _phase2_shots_cast_refs(args, cmd):
    """Phase 2 in shots mode with --cast-refs-model (cast refs spec CR10): the cast-reference panels are Qwen edits
    of their two characters' reference stills (_phase2_cast_refs_batch); every other panel runs the unchanged
    Z-Image stills groups (_phase2_shots without those panels). Both run, the Z-Image groups first; returns 1 when
    either failed. With no cast-reference panel, Phase 2 is exactly _phase2_shots after one note."""
    qe = _qwen_edit()
    error, plan = _cast_refs_plan(args, qe)
    if error is not None:
        print("Error: %s" % error, file=sys.stderr)
        return 1
    if not plan["pairs"]:
        print(CAST_REFS_NONE_NOTE)
        return _phase2_shots(args, cmd)
    multi = sorted(plan["pairs"])
    if (_shots_seed_lora_note(args) or getattr(args, "global_stills_loras", None)
            or getattr(args, "stills_lora_path", None)):
        print(CAST_REFS_LORA_NOTE % _panel_list(multi))
    rc = _phase2_shots(args, cmd, exclude=multi)
    if _phase2_cast_refs_batch(args, qe, plan) != 0 or rc != 0:
        return 1
    return 0


def _redo_moves(args, archive):
    """[(src, dst)] for every existing file --redo moves aside (shots spec 5.6), in order: per redo
    panel its still, clip and clip provenance; then movie.mp4. Reads only os.path state."""
    paths = _story_paths(args.story_id)
    clips_dir = os.path.join(paths["story_dir"], "clips")
    moves = []
    for n in args.redo_panels:
        for src, sub in ((os.path.join(paths["images_dir"], "panel_%02d.png" % n), "images"),
                         (os.path.join(clips_dir, "panel_%02d.mp4" % n), "clips"),
                         (os.path.join(clips_dir, "panel_%02d.mp4.provenance.json" % n), "clips")):
            if os.path.lexists(src):
                moves.append((src, os.path.join(archive, sub, os.path.basename(src))))
    if os.path.lexists(paths["movie_path"]):
        moves.append((paths["movie_path"], os.path.join(archive, "movie.mp4")))
    return moves


def phase_redo_shots(args):
    """--redo (shots spec 5.6): move the named panels' still, clip and clip provenance, and
    movie.mp4, into <story>/redo/<UTC stamp>-<pid>/, so Phase 2 regenerates only those stills
    and Phase 4 (--resume) re-renders only those clips. Never deletes anything."""
    paths = _story_paths(args.story_id)
    panels = _panel_list(args.redo_panels)
    print("=== Redo: panels %s ===" % panels)
    archive = os.path.join(paths["story_dir"], "redo", "%s-%d"
                           % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), os.getpid()))
    moves = _redo_moves(args, archive)
    for src, dst in moves:
        try:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            os.replace(src, dst)
        except OSError as e:
            print("Error: --redo could not move %s to %s: %s" % (src, dst, e), file=sys.stderr)
            return 1
        print("redo: moved %s -> %s" % (src, dst))
    if not moves:
        print("redo: nothing to move (no still, clip or movie exists yet for panels %s)" % panels)
    print("redo: panels %s re-render; every other panel's still and clip is reused (stills by "
          "existence, clips by --resume provenance)" % panels)
    return 0


# ---------------------------------------------------------------------------
# phase 3: manifest + dry-run
# ---------------------------------------------------------------------------

def _shots_image_flags(args):
    """--image <images>/panel_NN.png for every panel 1..--panels, in order (shots spec 5.7)."""
    images_dir = _story_paths(args.story_id)["images_dir"]
    flags = []
    for i in range(1, args.panels + 1):
        flags += ["--image", os.path.join(images_dir, "panel_%02d.png" % i)]
    return flags


def phase3_manifest(args):
    paths = _story_paths(args.story_id)
    print("=== Phase 3: manifest + dry-run ===")

    rc, cmd_manifest = _phase3_manifest_cmd(args)
    if rc:
        return rc
    print("Running: %s" % shlex.join(cmd_manifest))
    proc = subprocess.run(cmd_manifest, cwd=WS)
    if proc.returncode != 0:
        print("Error: ltx-story-manifest exited %d" % proc.returncode, file=sys.stderr)
        return 1

    cmd_dryrun = [sys.executable, os.path.join(WS, "bin", "ltx-mlx-render"),
                  paths["manifest_path"], paths["movie_path"]] + _render_flags(args) \
                 + ["--dry-run"]
    print("Running: %s" % shlex.join(cmd_dryrun))
    proc = subprocess.run(cmd_dryrun, cwd=WS)
    if proc.returncode != 0:
        print("Error: ltx-mlx-render --dry-run exited %d" % proc.returncode, file=sys.stderr)
        return 1

    if not args.no_review:
        input("Review the plan and the estimated render time above. Enter to render, "
              "Ctrl-C to abort: ")

    return 0


def _phase3_manifest_cmd(args, image_flags=None):
    """(rc, cmd): Phase 3's bin/ltx-story-manifest command with rc 0, or (2, None) after printing the catalog error.
    In shots mode its --image flags are image_flags when given (--seed-context frame's placeholders, seed context
    spec CX16), else _shots_image_flags(args). Writes catalog_loras.json when the plan picks catalog LoRAs."""
    paths = _story_paths(args.story_id)
    cmd_manifest = [sys.executable, os.path.join(WS, "bin", "ltx-story-manifest"),
                     "--story-id", args.story_id, "--prompts-md", paths["story_md"]]
    if args.no_stills:
        cmd_manifest += ["--no-images"]
    elif getattr(args, "shots", False):
        cmd_manifest += ["--shots"] + (_shots_image_flags(args) if image_flags is None else list(image_flags))
    else:
        cmd_manifest += ["--chain", "--image", os.path.join(paths["images_dir"], "panel_01.png")]
    cmd_manifest += ["--fps", str(args.fps),
                     "--target-seconds", str(_target_seconds(args)),
                     "--min-frames", str(args.frames),
                     "--max-frames", str(args.frames),
                     "--force"]
    if getattr(args, "no_narration", False) or getattr(args, "speech_only", False):
        cmd_manifest += ["--pace", "equal"]
    if getattr(args, "speech_delivery", "beats") != "beats":
        cmd_manifest += ["--speech-delivery", args.speech_delivery]
    cmd_manifest += _cast_flags(args)
    cmd_manifest += _location_flags(args, video=True)
    error, catalog_lists = _catalog_panel_loras(args)
    if error:
        print(error, file=sys.stderr)
        return 2, None
    if catalog_lists is not None:
        catalog_path = os.path.join(paths["story_dir"], "catalog_loras.json")
        _write_catalog_loras(args, catalog_path, catalog_lists)
        cmd_manifest += ["--catalog-loras", catalog_path]
    return 0, cmd_manifest


# ---------------------------------------------------------------------------
# phase 4: render
# ---------------------------------------------------------------------------

def _top5_rss():
    import psutil
    procs = []
    for p in psutil.process_iter(["name", "memory_info"]):
        try:
            mem_info = p.info["memory_info"]
            if mem_info is None:
                continue
            rss_gib = mem_info.rss / (2 ** 30)
            procs.append((p.info["name"] or str(p.pid), rss_gib))
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue
    procs.sort(key=lambda item: item[1], reverse=True)
    return procs[:5]


def _wait_for_avail(min_avail_gib, avail_timeout):
    import psutil
    start = time.monotonic()
    last_print = None
    while True:
        avail_gib = psutil.virtual_memory().available / (2 ** 30)
        if avail_gib >= min_avail_gib:
            return True
        now = time.monotonic()
        elapsed = now - start
        if last_print is None or now - last_print >= 120:
            last_print = now
            print("avail %.2f GiB (< %.2f GiB required, %.0fs elapsed); top-5 RSS processes:"
                  % (avail_gib, min_avail_gib, elapsed))
            for name, rss_gib in _top5_rss():
                print("  %-30s %.2f GiB" % (name, rss_gib))
            print("hint: quit Chrome/Slack/Docker to free memory")
        if elapsed >= avail_timeout:
            print("Error: avail memory did not reach %.2f GiB within %ds (last reading %.2f GiB)"
                  % (min_avail_gib, avail_timeout, avail_gib), file=sys.stderr)
            return False
        time.sleep(5)


def _stream_and_tee(cmd, log_path):
    with open(log_path, "w") as logf:
        proc = subprocess.Popen(cmd, cwd=WS, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True, bufsize=1,
                                 env=dict(os.environ, PYTHONUNBUFFERED="1"))
        for line in proc.stdout:
            sys.stdout.write(line)
            logf.write(line)
            logf.flush()
        proc.wait()
        return proc.returncode


def _report_summary(args, movie_path, story_dir):
    matches = glob.glob(os.path.join(story_dir, "runs", "*", "story_summary.json"))
    if not matches:
        print("Error: no runs/*/story_summary.json found after render", file=sys.stderr)
        return 1
    newest = max(matches, key=os.path.getmtime)
    with open(newest) as f:
        summary = json.load(f)

    completed = summary.get("completed_units")
    requested = summary.get("requested_units")
    intended = summary.get("intended_total_frames")
    actual = summary.get("actual_total_frames")
    fps = summary.get("fps", args.fps)
    retried = [u.get("unit") for u in summary.get("units", []) if u.get("attempts", 1) > 1]

    print("=== render summary (%s) ===" % newest)
    print("completed: %s/%s units" % (completed, requested))
    print("frames: intended=%s actual=%s" % (intended, actual))
    print("retried units: %r" % retried)

    if os.path.exists(movie_path):
        size_bytes = os.path.getsize(movie_path)
        duration = (actual or 0) / fps if fps else 0.0
        print("movie: %s (%d bytes, %.2fs @ %d fps)" % (movie_path, size_bytes, duration, fps))

    return 0 if completed == requested else 1


def phase4_render(args):
    paths = _story_paths(args.story_id)
    movie_path = paths["movie_path"]

    print("=== Phase 4: render ===")
    if os.path.exists(movie_path) and not args.force:
        print("Error: %s already exists; pass --force to overwrite" % movie_path,
              file=sys.stderr)
        return 2

    if not _wait_for_avail(args.min_avail_gib, args.avail_timeout):
        return 1

    cmd = [sys.executable, _render_tool(), paths["manifest_path"], movie_path] + _phase4_flags(args)
    print("Running: %s" % shlex.join(cmd))

    rc = _stream_and_tee(cmd, paths["movie_log_path"])
    if rc != 0:
        print("Error: ltx-mlx-render exited %d" % rc, file=sys.stderr)
        return rc

    return _report_summary(args, movie_path, paths["story_dir"])


# ---------------------------------------------------------------------------
# dry-run plan
# ---------------------------------------------------------------------------

def _print_legacy_phase1(args, paths, prompt, max_tokens, timeout):
    """The --story-legacy Phase 1 block of the dry run, exactly as before the robust engine."""
    print("Would skip if %s already exists (pass --force-story to regenerate)."
          % paths["story_md"])
    phase1_cmd = [sys.executable, os.path.join(WS, "bin", "qwen-agent"),
                  "--workspace", WS,
                  "--max-tokens", str(max_tokens), "--max-rounds", "4",
                  "--request-timeout", "600", "--tools", "write_file"]
    if args.story_model:
        phase1_cmd += ["--model", args.story_model]
    if args.story_context_window:
        phase1_cmd += ["--context-window", str(args.story_context_window)]
    if getattr(args, "seed_image", None):
        phase1_cmd += ["--image", paths["seed_downscaled"]]
    phase1_cmd += ["--user-prompt", prompt]
    print("Command (subprocess timeout %ds): %s" % (timeout, shlex.join(phase1_cmd)))
    print()
    print("Rendered story prompt:")
    print(prompt)
    print()


def _print_robust_phase1(args, paths):
    """The robust engine's Phase 1 block of the dry run (robust story spec RS30). Writes nothing;
    loads story_engine.py and lora_catalog.py only."""
    engine = _story_engine()
    ctx = _story_context(args, dry_run=True)
    compatible = engine.compatible_entries(ctx)
    print("Would skip if %s already exists and re-check it instead (pass --force-story to "
          "regenerate)." % paths["story_md"])
    print("Story engine: a JSON plan, one call per panel, deterministic checks and up to 2 critic "
          "rounds that repair only spoken timing and the amount of action (analyst via the local "
          "qwen-agentd, else a local one-shot); --story-legacy for the single-prompt path.")
    for warning in engine.catalog_warnings(ctx):
        print(warning)
    catalog_path = _lora_catalog().catalog_path(WS)
    if args.no_auto_lora:
        print("Catalog LoRAs: off (--no-auto-lora)")
    elif compatible:
        print("Catalog LoRAs: %d compatible entr%s in %s"
              % (len(compatible), "y" if len(compatible) == 1 else "ies", catalog_path))
    else:
        print("Catalog LoRAs: none compatible in %s" % catalog_path)
    if args.judge:
        print("Judge gate: bin/judge-story --patches after the critic rounds (report only).")
    prompt = engine.build_plan_prompt(ctx, compatible, ctx.pinned)
    argv = engine.agent_cmd(ctx, prompt, max_tokens=engine.plan_tokens(ctx, compatible),
                            image=ctx.seed_agent_image)
    print("Command (subprocess timeout %ds): %s"
          % (engine.plan_timeout(engine.most_panels(ctx)), shlex.join(argv)))
    print()
    print("Rendered plan prompt:")
    print(prompt)
    print()
    # Soft panel count spec SPC13 (e); plan ruling SPR5: after the rendered prompt, so the
    # command line is still followed by a blank line and "Rendered plan prompt:".
    problem = engine.spoken_lines_problem(ctx)
    lo, hi = engine.panel_range(ctx)
    target = engine.target_panels(ctx)
    # Soft panel count fix FW-d: only a generate run stops on the spoken lines; an existing
    # story.md is re-checked instead.
    if problem and (args.force_story or not os.path.exists(paths["story_md"])):
        print(DRY_PANELS_STOP % problem)
    elif ctx.panels != target:
        print(DRY_PANELS_STORY % (ctx.panels, target, ctx.panels))
    else:
        print(DRY_PANELS_RANGE % (target, lo, hi))
    print()


def _print_shots_stills_plan(args, cmd, exclude=()):
    """Phase 2's dry-run lines in shots mode (shots spec 5.8). Touches nothing. The panels in exclude (the
    cast-reference panels, cast refs spec CR12) are left out of every group."""
    story_md = _story_paths(args.story_id)["story_md"]
    if args.force_story or not os.path.exists(story_md):
        group_cmd = list(cmd)
        group_cmd[group_cmd.index("--only") + 1] = "<PANELS>"
        group_cmd.append("--shots")
        print("Stills groups: computed from story.md after Phase 1 -- one run per distinct set of "
              "cast stills LoRAs, each with --only <PANELS> (that group's panels):")
        print("Command: %s" % shlex.join(group_cmd))
        return
    groups = _exclude_groups(_shots_stills_groups(story_md, getattr(args, "cast_members", None) or [],
                                                  getattr(args, "location_pins", None) or []), exclude)
    for k, (names, panels) in enumerate(groups, start=1):
        group_cmd = list(cmd)
        group_cmd[group_cmd.index("--only") + 1] = _panel_list(panels)
        group_cmd.append("--shots")
        skip = "" if _shots_missing_stills(args, panels) else " -- would be skipped: every still exists"
        print("stills group %d/%d (%s; panels %s)%s"
              % (k, len(groups), ", ".join(names) or "no character LoRAs", _panel_list(panels), skip))
        print("Command: %s" % shlex.join(group_cmd))


def _print_shots_seed_plan(args):
    """Phase 2's dry-run lines in shots mode with a seed image (shots seed edits spec SE19). Reads; never writes."""
    qe = _qwen_edit()
    paths = _story_paths(args.story_id)
    model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
    known = isinstance(args.video_width, int)
    size = "%dx%d" % _seed_edit_size(args, qe.multiple(model_id)) if known else "<W>x<H>"
    still = "%dx%d" % _still_size(args) if known else "<2W>x<2H>"
    print("Would edit the seed into every panel's still with %s at %s, seed %d, in one Qwen child: each panel is "
          "prompted by the shots seed-edit instruction and its own Image: text (and the Style: text) from story.md, "
          "screened with content safety (skill %s), fitted (never cropped) into %s at %s and recorded in %s. "
          "Z-Image and stills LoRAs are not used. A blocked or failed panel stops the run after the batch; a rerun "
          "reuses every recorded edit."
          % (qe.generator_text(model_id, loras), size, args.image_seed, SHOTS_SEED_EDIT_SKILL,
             os.path.join(paths["images_dir"], "panel_NN.png"), still,
             _shots_seed_paths(paths["story_dir"])["record"]))
    if args.force_story or not known or not os.path.exists(paths["story_md"]):
        print("Panels: decided at Phase 2, from story.md after Phase 1")
        return
    error, plan = _shots_seed_plan(args, qe)
    if error is not None:
        print("Panels: Phase 2 would stop: %s" % error)
        return
    print("Panels to edit: %s; reused: %s"
          % (_panel_list(plan["todo"]) or "none", _panel_list(plan["reuse"]) or "none"))


def _print_seed_context_plan(args):
    """Phase 2's dry-run lines in seeded shots mode with --seed-context (seed context spec CX11). Reads; never
    writes."""
    qe = _qwen_edit()
    paths = _story_paths(args.story_id)
    model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
    known = isinstance(args.video_width, int)
    size = "%dx%d" % _seed_edit_size(args, qe.multiple(model_id)) if known else "<W>x<H>"
    still = "%dx%d" % _still_size(args) if known else "<2W>x<2H>"
    picture = 2 if args.seed_context["order"] == "seed-first" else 1
    print("Would edit the seed into every panel's still with %s at %s, seed %d, one Qwen child per edited panel, in "
          "panel order: panel 1 and every panel whose Image: setting sentence differs from the previous panel's are "
          "single-image edits of the seed (the shots seed-edit instruction); every other panel is a two-image edit "
          "with the seed as Picture %d and %s as Picture %d (the seed-context instruction). Each is prompted by its "
          "own Image: text (and the Style: text) from story.md, screened with content safety (skill %s), fitted "
          "(never cropped) into %s at %s and recorded in %s. Z-Image and stills LoRAs are not used. A blocked or "
          "failed panel stops the run; a rerun reuses every recorded edit whose context picture is unchanged."
          % (qe.generator_text(model_id, loras), size, args.image_seed, 3 - picture,
             SEED_CONTEXT_KINDS[args.seed_context["mode"]], picture, SEED_CONTEXT_SKILL,
             os.path.join(paths["images_dir"], "panel_NN.png"), still,
             _seed_context_paths(paths["story_dir"])["record"]))
    if args.seed_context["mode"] == "frame":
        work = _seed_context_paths(paths["story_dir"])["work"]
        print("Frame mode: Phase 2 also renders each panel's clip right after its still, with bin/ltx-mlx-render "
              "--resume on a manifest of the panels so far (%s; Phase 4's flags: skip plus one retry; logs %s), and the exact last "
              "frame of clip k is panel k+1's context picture. A clip still failing after the retry stops the run. Phases 3 and 4 then build "
              "the final manifest and reuse every clip."
              % (os.path.join(work, "manifest_upto.json"), os.path.join(work, "render-NN.log")))
    if args.force_story or not known or not os.path.exists(paths["story_md"]):
        print("Panels: decided at Phase 2, from story.md after Phase 1")
        return
    error, plan = _seed_context_plan(args, qe)
    if error is not None:
        print("Panels: Phase 2 would stop: %s" % error)
        return
    print("Location changes (single-image edits): %s" % (_panel_list(plan["changes"]) or "none"))
    if args.seed_context["mode"] == "frame":
        print("Panels to edit: decided panel by panel during the run: a context picture is the last frame of a clip "
              "this run renders or reuses")
        return
    changed, reused = set(), []
    for n in range(1, plan["total"] + 1):
        path = os.path.join(paths["images_dir"], "panel_%02d.png" % (n - 1))
        if _seed_context_reusable(args, plan, n, _seed_context_context(args, plan, n, path), changed):
            reused.append(n)
        else:
            changed.add(n)
    print("Panels to edit: %s; reused: %s" % (_panel_list(sorted(changed)) or "none", _panel_list(reused) or "none"))


def _print_cast_refs_plan(args, cmd):
    """Phase 2's dry-run lines in shots mode with --cast-refs-model (cast refs spec CR12). Reads; never writes."""
    qe = _qwen_edit()
    paths = _story_paths(args.story_id)
    model_id, loras = args.cast_refs["qwen_model"], args.cast_refs["loras"]
    still = _still_size(args)
    multiple = qe.multiple(model_id)
    print("Would edit every panel whose Image: names two cast characters with %s at %dx%d, seed %d, in one Qwen "
          "child: Picture 1 and Picture 2 are the two characters' reference stills in cast order (%s); each panel is "
          "prompted by the cast-reference instruction and its own Image: text (and the Style: text), screened with "
          "content safety (skill %s) and recorded in %s. No Z-Image stills LoRA applies to those panels; a blocked "
          "or failed one stops the run after the batch. Every other panel is a Z-Image still:"
          % (qe.generator_text(model_id, loras), still[0] // multiple * multiple, still[1] // multiple * multiple,
             args.image_seed, "; ".join("%s %s" % (m.name, args.cast_refs["stills"][m.name])
                                        for m in args.cast_members),
             CAST_REFS_SKILL, _cast_refs_paths(paths["story_dir"])["record"]))
    if args.force_story or not os.path.exists(paths["story_md"]):
        print("Cast-reference panels: decided at Phase 2, from story.md after Phase 1")
        _print_shots_stills_plan(args, cmd)
        return
    error, plan = _cast_refs_plan(args, qe)
    if error is not None:
        print("Cast-reference panels: Phase 2 would stop: %s" % error)
        return
    multi = sorted(plan["pairs"])
    print("Cast-reference panels: %s; to edit: %s; reused: %s"
          % ("; ".join("%d (%s)" % (n, ", ".join(m.name for m in plan["pairs"][n])) for n in multi) or "none",
             _panel_list(plan["todo"]) or "none", _panel_list(plan["reuse"]) or "none"))
    _print_shots_stills_plan(args, cmd, exclude=multi)


def _print_dry_run_plan(args):
    paths = _story_paths(args.story_id)
    geometry_line = None
    if getattr(args, "seed_image", None):
        # Resolve Phase 0's geometry before printing anything, so a bad seed fails the
        # dry run exactly as it would fail Phase 0 (exit 2). Nothing is written.
        violations, geometry, img = _seed_geometry(args.seed_image)
        if violations and violations[0].startswith("--seed-image needs Pillow"):
            args.video_width, args.video_height = "<W>", "<H>"
            geometry_line = ("video geometry: derived from the seed at Phase 0 "
                             "(Pillow not importable in this interpreter)")
        elif violations:
            for v in violations:
                print("Error: %s" % v, file=sys.stderr)
            return 2
        else:
            args.video_width, args.video_height = geometry[0], geometry[1]
            geometry_line = _seed_geometry_line(args.seed_image, img.size, geometry,
                                                paths["seed_downscaled"])
    max_tokens = _phase1_max_tokens(args.panels)
    timeout = _phase1_timeout(args.panels)
    prompt = build_story_prompt(args.narrative, args.story_id, args.panels, args.no_stills,
                                 bool(getattr(args, "seed_image", None)),
                                 seconds=_clip_seconds(args),
                                 cast_block=getattr(args, "cast_block", None),
                                 shots=getattr(args, "shots", False))

    print("=== DRY RUN: ltx-movie phase plan (story-id=%s) ===" % args.story_id)
    print()

    if getattr(args, "cast_members", None):
        print("--- Cast ---")
        for m in args.cast_members:
            print('cast: %s as "%s" (trigger %s; video LoRA %s; stills LoRA %s)'
                  % (m.name, m.phrase, m.trigger, m.video_lora,
                     m.stills_lora or "none: " + (m.stills_skip_reason or "not trained")))
        print()

    if getattr(args, "location_pins", None):
        print("--- Locations ---")
        for pin in args.location_pins:
            strength = pin.strength if pin.strength is not None else args.location_strength
            line = ("location: %s (trigger %s; video LoRA %s; stills LoRA %s; strength %s)"
                    % (pin.name, pin.trigger, pin.video_lora,
                       pin.stills_lora or "none: " + (pin.stills_skip_reason or "not trained"),
                       repr(float(strength))))
            if not pin.attach_video:
                line += " -- video LoRA not attached: trained for %s" % pin.base_model
            print(line)
        print()

    if getattr(args, "seed_image", None):
        print("--- Phase 0: seed image ---")
        print("Would validate %s (readable image, every edge >= %dpx, aspect 1:3 to 3:1), "
              "derive the video geometry from it, and write a scaled story-model copy "
              "(long edge %dpx) to %s. %s"
              % (args.seed_image, SEED_MIN_EDGE, SEED_DOWNSCALE_MAX_EDGE, paths["seed_downscaled"],
                 "Phase 2 edits the ORIGINAL into every panel's still with the Qwen edit model; nothing is cropped."
                 if getattr(args, "shots", False) else
                 "Phase 2 fits the ORIGINAL into panel_01.png at twice the video size; nothing is cropped."))
        print(geometry_line)

    print("--- Phase 1: story ---")
    if getattr(args, "story_engine", "legacy") == "robust":
        _print_robust_phase1(args, paths)
    else:
        _print_legacy_phase1(args, paths, prompt, max_tokens, timeout)

    if getattr(args, "story_server_stop_after_story", False):
        print("--- Phase 1b: release the story server ---")
        print("Command: %s" % shlex.join([os.path.join(WS, "bin", "story-server"), "stop"]))
        print("Then wait until psutil.virtual_memory().available/2**30 >= %.1f GiB "
              "(timeout %ds) before Phase 2." % (args.min_avail_gib, args.avail_timeout))
        print()

    if getattr(args, "redo_panels", None):
        print("--- Redo: panels %s ---" % _panel_list(args.redo_panels))
        for src, dst in _redo_moves(args, os.path.join(paths["story_dir"], "redo",
                                                       "<UTC stamp>-<pid>")):
            print("Would move %s -> %s" % (src, dst))
        print("Then only those panels' stills and clips re-render; every other panel is reused.")
        print()

    if getattr(args, "seed_edit", None) and not getattr(args, "shots", False):
        qe = _qwen_edit()
        model_id, loras = args.seed_edit["qwen_model"], args.seed_edit["loras"]
        files = _seed_edit_paths(paths["story_dir"])
        size = ("%dx%d" % _seed_edit_size(args, qe.multiple(model_id)) if isinstance(args.video_width, int)
                else "<W>x<H>")
        print("--- Phase 1c: seed edit ---")
        print("Would edit the seed with %s at %s, seed %d, prompted by panel 1's Image: text (and its Style: "
              "text) from story.md; every output is screened with content safety (skill %s); writes %s, %s "
              "and %s. A blocked or failed edit stops the run."
              % (qe.generator_text(model_id, loras), size, args.image_seed, SEED_EDIT_SKILL,
                 files["original"], files["edited"], files["record"]))
        print()

    if getattr(args, "shots", False) and getattr(args, "seed_image", None):
        print("--- Phase 2: stills ---")
        if getattr(args, "seed_context", None):
            _print_seed_context_plan(args)
        else:
            _print_shots_seed_plan(args)
        print()
    elif args.no_stills:
        print("--- Phase 2: stills --- SKIPPED (--no-stills: no anchor stills are generated)")
        print()
    else:
        print("--- Phase 2: stills ---")
        still_w, still_h = _still_size(args)
        phase2_cmd = [sys.executable, os.path.join(WS, "bin", "ltx-story-images"),
                      "--story-md", paths["story_md"], "--out-dir", paths["images_dir"],
                      "--only", "1", "--width", str(still_w), "--height", str(still_h),
                      "--seed", str(args.image_seed)]
        if getattr(args, "seed_image", None):
            phase2_cmd += ["--seed-image", args.seed_image]
            if getattr(args, "seed_edit", None):
                phase2_cmd[-1] = _seed_edit_paths(paths["story_dir"])["edited"]
        if getattr(args, "global_stills_loras", None):
            for path, strength in args.global_stills_loras:
                phase2_cmd += ["--lora", "%s:%s" % (path, repr(float(strength)))]
        elif args.stills_lora_path:
            phase2_cmd += ["--lora", args.stills_lora_path]
        error, catalog_flags = _catalog_stills_flags(args, dry_run=True)
        if error:
            print(error, file=sys.stderr)
            return 2
        phase2_cmd += catalog_flags
        phase2_cmd += _cast_flags(args)
        phase2_cmd += _location_flags(args)
        if getattr(args, "shots", False) and getattr(args, "cast_refs", None):
            _print_cast_refs_plan(args, phase2_cmd)
        elif getattr(args, "shots", False):
            _print_shots_stills_plan(args, phase2_cmd)
        else:
            print("Command: %s" % shlex.join(phase2_cmd))
        print()

    print("--- Phase 3: manifest + dry-run ---")
    phase3_manifest_cmd = [sys.executable, os.path.join(WS, "bin", "ltx-story-manifest"),
                            "--story-id", args.story_id, "--prompts-md", paths["story_md"]]
    if args.no_stills:
        phase3_manifest_cmd += ["--no-images"]
    elif getattr(args, "shots", False):
        phase3_manifest_cmd += ["--shots"] + _shots_image_flags(args)
    else:
        phase3_manifest_cmd += ["--chain", "--image",
                                os.path.join(paths["images_dir"], "panel_01.png")]
    phase3_manifest_cmd += ["--fps", str(args.fps),
                             "--target-seconds", str(_target_seconds(args)),
                             "--min-frames", str(args.frames),
                             "--max-frames", str(args.frames), "--force"]
    if getattr(args, "no_narration", False) or getattr(args, "speech_only", False):
        phase3_manifest_cmd += ["--pace", "equal"]
    if getattr(args, "speech_delivery", "beats") != "beats":
        phase3_manifest_cmd += ["--speech-delivery", args.speech_delivery]
    phase3_manifest_cmd += _cast_flags(args)
    phase3_manifest_cmd += _location_flags(args, video=True)
    error, catalog_lists = _catalog_panel_loras(args, dry_run=True)
    if error:
        print(error, file=sys.stderr)
        return 2
    if catalog_lists is not None:
        phase3_manifest_cmd += ["--catalog-loras",
                                os.path.join(paths["story_dir"], "catalog_loras.json")]
    print("Command: %s" % shlex.join(phase3_manifest_cmd))
    phase3_render_cmd = [sys.executable, os.path.join(WS, "bin", "ltx-mlx-render"),
                         paths["manifest_path"], paths["movie_path"]] \
                        + _render_flags(args) + ["--dry-run"]
    print("Command: %s" % shlex.join(phase3_render_cmd))
    print()

    print("--- Phase 4: render ---")
    print("Avail gate: wait until psutil.virtual_memory().available/2**30 >= %.1f GiB "
          "(timeout %ds)." % (args.min_avail_gib, args.avail_timeout))
    phase4_cmd = [sys.executable, os.path.join(WS, "bin", "ltx-mlx-render"),
                  paths["manifest_path"], paths["movie_path"]] + _phase4_flags(args)
    print("Command: %s" % shlex.join(phase4_cmd))
    return 0


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def _phase_sequence(args):
    """The ordered phase tuple. Pure: no I/O, no side effects -- it is the unit under test
    for the --story-server-stop-after-story insertion point."""
    if getattr(args, "story_only", False):
        phases = (phase1_story,)
        if getattr(args, "seed_image", None):
            phases = (phase0_seed,) + phases
        return phases
    phases = ((phase1_story, phase3_manifest, phase4_render) if args.no_stills
              else (phase1_story, phase2_stills, phase3_manifest, phase4_render))
    if getattr(args, "story_server_stop_after_story", False):
        cut = 1
        phases = phases[:cut] + (phase_release_story_server,) + phases[cut:]
    if getattr(args, "redo_panels", None):
        cut = phases.index(phase2_stills)
        phases = phases[:cut] + (phase_redo_shots,) + phases[cut:]
    if (getattr(args, "seed_edit", None) and phase2_stills in phases and not getattr(args, "shots", False)):
        cut = phases.index(phase2_stills)
        phases = phases[:cut] + (phase_seed_edit,) + phases[cut:]
    if getattr(args, "seed_image", None):
        phases = (phase0_seed,) + phases
    if (getattr(args, "seed_context", None) or {}).get("mode") == "frame":
        # Seed context CX15: the frame mode's Phase 2 renders every clip as it goes; Phases 3 and 4 reuse them.
        phases = tuple(phase_seed_context_frames if p is phase2_stills else p for p in phases)
    return phases


def main(argv=None):
    raw_argv = argv if argv is not None else sys.argv[1:]
    if "--list-characters" in raw_argv:
        return _list_characters(raw_argv)
    parser = build_parser()
    args = parser.parse_args(argv)
    _autotuned = []
    if os.environ.get("QWEN_LTX_AUTOTUNE", "").strip():   # opt-in: unset never loads the skill
        _autotune_fields = [("num_frames", "frames", ["--frames"], int),
                            ("low_ram", "no_low_ram", ["--no-low-ram"], lambda v: not v)]
        if not getattr(args, "seed_image", None):    # a seed image derives geometry itself
            _autotune_fields = [("width", "video_width", ["--video-width"], int),
                                ("height", "video_height", ["--video-height"], int)] + _autotune_fields
        _autotuned = _ltx2_skill().maybe_autotune_apply(args, raw_argv, _autotune_fields)
    if _autotuned:
        print("autotune (QWEN_LTX_AUTOTUNE): %s" % ", ".join(_autotuned), file=sys.stderr)
    if args.list_characters:                 # an abbreviation (--list-char) got past the pre-scan
        print("Error: --list-characters takes no other arguments", file=sys.stderr)
        return 2
    if args.narrative is None and args.story_prompt_override is None:
        parser.error("either a narrative argument or --story-prompt-override is required")
    _resolve_length(args, raw_argv)
    if args.panels < 1:
        print("Error: --panels must be at least 1, got %d" % args.panels, file=sys.stderr)
        return 2

    if getattr(args, "seed_image", None):
        if args.video_width is not None or args.video_height is not None:
            print("Error: video geometry is derived from --seed-image; omit "
                  "--video-width/--video-height", file=sys.stderr)
            return 2
    else:
        if args.video_width is None:
            args.video_width = 704
        if args.video_height is None:
            args.video_height = 448
        if (args.video_width % 64 or args.video_height % 64
                or args.video_width < 64 or args.video_height < 64):
            print("Error: --video-width/--video-height must be multiples of 64 (ltx-2-mlx "
                  "two-stage floors to 64), got %dx%d" % (args.video_width, args.video_height),
                  file=sys.stderr)
            return 2

    if getattr(args, "seed_image", None) and args.no_stills:
        print("Error: --seed-image is incompatible with --no-stills: --no-stills removes "
              "Phase 2 entirely, so the seed image would never become panel_01.png.",
              file=sys.stderr)
        return 2

    if args.story_prompt_override is not None and not os.path.isfile(args.story_prompt_override):
        print("Error: --story-prompt-override file not found: %s" % args.story_prompt_override,
              file=sys.stderr)
        return 2

    _resolve_story_panels(args)
    rc = _resolve_shots(args)
    if rc:
        return rc
    rc = _resolve_casting(args)
    if rc:
        return rc
    rc = _resolve_global_loras(args)
    if rc:
        return rc
    rc = _resolve_actions(args)
    if rc:
        return rc
    rc = _resolve_story_engine(args)
    if rc:
        return rc
    rc = _resolve_locations(args)
    if rc:
        return rc
    rc = _resolve_seed_edit(args)
    if rc:
        return rc
    rc = _resolve_cast_refs(args)
    if rc:
        return rc
    rc = _resolve_seed_context(args)
    if rc:
        return rc

    if args.dry_run:
        return _print_dry_run_plan(args)

    paths = _story_paths(args.story_id)
    os.makedirs(paths["story_dir"], exist_ok=True)
    lock_path = paths["lock_path"]

    state, pid = _lock_state(lock_path)
    if state == "active":
        print("another ltx-movie run for this story is active, pid %d" % pid, file=sys.stderr)
        return 2
    if state == "stale":
        print("note: removing stale lockfile for story %s (dead pid %s)" % (args.story_id, pid))
        try:
            os.remove(lock_path)
        except OSError:
            pass

    with open(lock_path, "w") as f:
        f.write(str(os.getpid()))

    try:
        rc = _check_sudo_and_start_keepalive()
        if rc is not None:
            return rc

        if not args.no_review and not sys.stdin.isatty():
            print("Error: review gates require an interactive terminal. Run this "
                  "interactively, or pass --no-review for unattended operation.",
                  file=sys.stderr)
            return 2

        phases = _phase_sequence(args)
        for phase_fn in phases:
            rc = phase_fn(args)
            if rc != 0:
                return rc
        return 0
    finally:
        try:
            os.remove(lock_path)
        except OSError:
            pass


def _pipeline_log_story_dir(argv):
    story_id = pipeline_log.argv_value(argv, "--story-id")
    return os.path.join(WS, "generated", "stories", story_id) if story_id else None


if __name__ == "__main__":
    sys.exit(pipeline_log.run_logged("ltx-movie", _pipeline_log_story_dir(sys.argv[1:]), main, sys.argv))
