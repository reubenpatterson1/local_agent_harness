#!/usr/bin/env python3
"""ltx-story-images -- generate one Z-Image-Turbo panel image per prompts.md
`Image:` field, for a story.md destined for bin/ltx-story-manifest.

This tool never invents creative content -- it renders exactly the Image:
prompt text already written in the story.md. It reuses
bin/ltx-story-manifest's own prompts.md parser (see the load-bearing
comment in main(), below) so a manifest built from the same story.md never
drifts out of sync with the images rendered here.

Usage:
    ltx-story-images --story-md path/to/story.md --out-dir path/to/panels
        [--width 1280] [--height 704] [--seed 0] [--force] [--dry-run]
        [--only 3,7] [--seed-image PATH]

Content safety: z_image_skill.generate_image screens every generated image
*before* it is ever saved -- nothing unsafe ever hits disk. A blocked panel
is recorded (status "blocked") and generation continues; one blocked panel
out of a 15-image batch must not lose the other 14.

images.json schema (schema_version 1):
{
  "schema_version": 1,
  "story_md": "/absolute/path/to/story.md",
  "width": 1280,
  "height": 704,
  "seed": 0,
  "panels": [
    {"index": 1, "path": "/abs/panel_01.png", "prompt": "...",
     "status": "ok" | "blocked" | "error", "seconds": 4.2,
     "source": "seed" | "generated"}
  ]
}

Grounded mode: when the story.md's Panel 1 carries a `Style:` field (written by
bin/ltx-movie's --seed-image story preface), that text is appended verbatim to
every panel's image prompt, and every panel is generated with the SAME CPU RNG
seed (--seed exactly, not --seed + index) so that panels sharing a prompt suffix
also share their noise draw. Without that field nothing changes: prompts are the
Image: text alone and panel i uses --seed + i, exactly as before. The Style:
field, not the --seed-image flag, is the switch -- so a single-panel rerun
(--only 5 --force) reproduces the same seed and the same prompt as the original
batch whether or not --seed-image is passed again.

Dependencies: stdlib only at import time. torch/z_image_skill/content_safety
are imported inside main(), after arg parsing and the --dry-run exit, so a
--dry-run invocation never touches the GPU/model stack. PIL is imported
inside the --seed-image path only.
"""

import argparse
import importlib.machinery
import json
import os
import sys
import time

WS = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, WS)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ltx-story-images",
        description="Generate one Z-Image-Turbo panel image per prompts.md Image: field.",
    )
    parser.add_argument("--story-md", dest="story_md", required=True)
    parser.add_argument("--out-dir", dest="out_dir", required=True)
    parser.add_argument("--width", type=int, default=1280)
    parser.add_argument("--height", type=int, default=704)
    parser.add_argument("--seed", type=int, default=0,
                        help="base CPU RNG seed. Ungrounded story.md: panel i uses "
                             "--seed + i. Grounded story.md (Panel 1 has a Style: field): "
                             "every panel uses --seed exactly.")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--only", dest="only", default=None,
                         help="comma-separated 1-based panel indices, e.g. 3,7 "
                              "(default: every panel)")
    parser.add_argument("--seed-image", dest="seed_image", default=None,
                        help="image that becomes panel 1 verbatim: it is scaled to fit "
                             "(never cropped) and centred on a black --width x --height "
                             "canvas and saved as panel_01.png instead of being generated. "
                             "Panel 1 takes this path even with --force (there is no "
                             "txt2img output to regenerate).")
    return parser


def _parse_only(only, n_panels):
    """Return the list of 1-based panel indices to process. Raises
    ValueError on a malformed --only value."""
    if only is None:
        return list(range(1, n_panels + 1))
    return [int(x) for x in only.split(",") if x.strip()]


def _write_seed_panel(seed_path, out_path, width, height):
    """Write seed_path to out_path as an RGB PNG of exactly width x height: EXIF
    orientation applied, scaled to fit (never cropped) and centred on a black
    width x height canvas (ltx_image_fit.fit_letterbox).

    ltx_image_fit is imported here and not at module scope on purpose: this file's
    docstring promises stdlib-only imports at import time, and
    tests/test_ltx_story_images.py guards that promise. ltx_image_fit itself imports
    PIL only inside its functions.
    """
    import ltx_image_fit
    ltx_image_fit.fit_letterbox(ltx_image_fit.load_oriented_rgb(seed_path),
                                width, height).save(out_path, format="PNG")


def _style_text(panels):
    """Panel 1's once-only Style: text, stripped, or "" when there is none.

    Only Panel 1 is consulted: the Phase 1 preface asks for exactly one Style:
    line, in Panel 1, and a stray one elsewhere is parsed but never read. The
    .get() keeps this working against a story.md parser that predates the field.
    """
    if not panels:
        return ""
    return panels[0].get("style", "").strip()


def _compose_prompt(image_text, style_text):
    """The txt2img prompt for one panel: its own Image: text, then the story's
    Style: text appended verbatim, joined by a single space.

    The panel's own text leads because it carries everything panel-specific; the
    style suffix carries only what every panel shares. With no style this returns
    the Image: text unchanged (the parser already strips and space-joins it), so
    an ungrounded story.md produces byte-identical prompts to before this existed.
    """
    image_text = image_text.strip()
    style_text = style_text.strip()
    if not style_text:
        return image_text
    if not image_text:
        return style_text
    return image_text + " " + style_text


def _panel_seed(base_seed, index, grounded):
    """The CPU RNG seed for panel `index` (1-based).

    Ungrounded: base_seed + index -- unchanged pre-existing behaviour, where each
    panel is an independent scene and per-panel noise variety is wanted. Grounded:
    base_seed for every panel, so panels that share a prompt suffix also share
    their noise draw instead of drifting apart on composition and palette alone.
    """
    return base_seed if grounded else base_seed + index


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    # LOAD-BEARING: exactly one story.md parser exists in this workspace
    # (bin/ltx-story-manifest's _parse_prompts_md). Duplicating it here
    # would let the two tools' parsing rules drift apart over time, so a
    # manifest built from a story.md would no longer match the images
    # rendered from that same story.md. Always reuse it, never reimplement.
    story_manifest = importlib.machinery.SourceFileLoader(
        "ltx_story_manifest", os.path.join(WS, "bin", "ltx-story-manifest")
    ).load_module()

    try:
        _narrative, panels = story_manifest._parse_prompts_md(args.story_md)
    except OSError as e:
        print("Error: cannot read --story-md file: %s" % e, file=sys.stderr)
        return 2

    if not panels:
        print("Error: --story-md has no panels", file=sys.stderr)
        return 2

    try:
        selected_indices = _parse_only(args.only, len(panels))
    except ValueError:
        print("Error: --only must be a comma-separated list of ints, got %r" % args.only,
              file=sys.stderr)
        return 2

    for i in selected_indices:
        if i < 1 or i > len(panels):
            print("Error: --only index %d out of range (1..%d)" % (i, len(panels)), file=sys.stderr)
            return 2

    for i in selected_indices:
        if not panels[i - 1]["image"].strip():
            print("Error: panel %d has no Image: field" % i, file=sys.stderr)
            return 2

    if args.seed_image is not None and not os.path.isfile(args.seed_image):
        print("Error: --seed-image not found: %s" % args.seed_image, file=sys.stderr)
        return 2

    # Grounded mode (see the module docstring): a non-empty Panel 1 Style: field
    # means this story.md was authored against a reference image and every panel
    # shares one visual identity. Two things then change, together: the style text
    # is appended verbatim to every panel's prompt, and the RNG seed is pinned to
    # --seed for every panel. Both are keyed to the file, not to --seed-image, so a
    # single-panel rerun reproduces the batch exactly.
    style = _style_text(panels)
    grounded = bool(style)

    # panel_%02d.png matches bin/ltx-story-manifest's own _PANEL_NUM_RE, so
    # a later `--glob 'panel_*.png'` sorts numerically and never falls back
    # to the (order-fragile) mtime heuristic.
    out_paths = {i: os.path.join(args.out_dir, "panel_%02d.png" % i) for i in selected_indices}

    if args.dry_run:
        if grounded:
            print("style: %s" % style)
            print("seed: pinned to %d for every generated panel (grounded mode)" % args.seed)
        for i in selected_indices:
            if args.seed_image is not None and i == 1:
                print("%d | %s | seed: %s" % (i, out_paths[i], args.seed_image))
            elif grounded:
                print("%d | %s | rng %d | +style | %r"
                      % (i, out_paths[i], _panel_seed(args.seed, i, grounded),
                         _compose_prompt(panels[i - 1]["image"], style)[:100]))
            else:
                print("%d | %s | %r" % (i, out_paths[i], panels[i - 1]["image"][:100]))
        return 0

    os.makedirs(args.out_dir, exist_ok=True)

    # Heavy imports deferred until after all arg/parse validation and the
    # --dry-run exit above, so a --dry-run invocation never touches torch.
    import torch
    import z_image_skill
    from content_safety import ContentSafetyError

    results = []
    any_bad = False
    for i in selected_indices:
        prompt = _compose_prompt(panels[i - 1]["image"], style)
        seed_used = _panel_seed(args.seed, i, grounded)
        path = out_paths[i]

        if args.seed_image is not None and i == 1:
            # Section 3.5: panel 1 takes this path regardless of --force and
            # regardless of an existing panel_01.png -- there is no txt2img output
            # to regenerate for it, so "skipped, exists" would be wrong, not cheap.
            start = time.monotonic()
            try:
                _write_seed_panel(args.seed_image, path, args.width, args.height)
                elapsed = time.monotonic() - start
                print("panel %d -> %s (seed image, %.1fs)" % (i, path, elapsed))
                results.append({"index": i, "path": path, "prompt": prompt,
                                 "status": "ok", "source": "seed",
                                 "seconds": round(elapsed, 1)})
            except Exception as e:
                elapsed = time.monotonic() - start
                print("panel %d ERROR: seed image could not be written: %s" % (i, e),
                      file=sys.stderr)
                results.append({"index": i, "path": path, "prompt": prompt,
                                 "status": "error", "source": "seed",
                                 "seconds": round(elapsed, 1)})
                any_bad = True
            continue

        if os.path.exists(path) and not args.force:
            print("panel %d -> %s (skipped, exists)" % (i, path))
            results.append({"index": i, "path": path, "prompt": prompt, "status": "ok",
                             "source": "generated", "seconds": 0.0})
            continue

        start = time.monotonic()
        try:
            z_image_skill.generate_image(
                prompt,
                output_path=path,
                width=args.width,
                height=args.height,
                generator=torch.Generator("cpu").manual_seed(seed_used),
            )
            elapsed = time.monotonic() - start
            print("panel %d -> %s (seed %d, %.1fs)" % (i, path, seed_used, elapsed))
            results.append({"index": i, "path": path, "prompt": prompt,
                             "status": "ok", "source": "generated",
                             "seconds": round(elapsed, 1)})
        except ContentSafetyError as e:
            # A block on one panel must not lose the rest of a 15-image
            # batch -- record and continue. z_image_skill screens before
            # save, so nothing unsafe is ever written to disk.
            elapsed = time.monotonic() - start
            print("panel %d BLOCKED: %s" % (i, e))
            results.append({"index": i, "path": path, "prompt": prompt,
                             "status": "blocked", "source": "generated",
                             "seconds": round(elapsed, 1)})
            any_bad = True
        except Exception as e:
            elapsed = time.monotonic() - start
            print("panel %d ERROR: %s" % (i, e), file=sys.stderr)
            results.append({"index": i, "path": path, "prompt": prompt,
                             "status": "error", "source": "generated",
                             "seconds": round(elapsed, 1)})
            any_bad = True

    with open(os.path.join(args.out_dir, "images.json"), "w") as f:
        json.dump({
            "schema_version": 1,
            "story_md": os.path.abspath(args.story_md),
            "width": args.width,
            "height": args.height,
            "seed": args.seed,
            "panels": results,
        }, f, indent=2)

    if any_bad:
        bad = [r["index"] for r in results if r["status"] != "ok"]
        print("FAILED/BLOCKED panels: %r" % bad, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
