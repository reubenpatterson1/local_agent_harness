#!/usr/bin/env python3
"""pipeline-stop -- stop every running pipeline phase cleanly and leave a known end state.

  bin/pipeline-stop [--grace SECONDS] [--no-restore] [--dry-run]

Finds the pipeline JOBS (bin/character create/train, bin/action create/train, the
character-train-vlm/action-train-vlm wrappers, bin/ltx-movie, bin/iterate-story) and the GPU
WORKERS they run (the character_dataset.py zimage/qwenedit children, ltx-2-mlx
generate/train/preprocess, mflux-train, bin/ltx-mlx-render, bin/ltx-story-images), then:

  1. SIGTERM to every job, so its own cleanup runs (bin/character and bin/action take their
     Ctrl-C path on SIGTERM: a create kills its image child and restores the story server; a train
     wrapper restores the VLM), and waits up to --grace s (default 180). Not SIGINT: a job started
     in the background by a script ignores it;
  2. SIGTERM again to every job and worker still running and to their descendants, waits 10 s,
     then SIGKILL to whatever is left (orphaned workers included);
  3. unless --no-restore, bin/story-server-restore --wait (story-server mlx-vision in its own
     session, a no-op when it is already serving);
  4. prints what is left, the story server state and the available memory.

The story server and movie-ui (server and job runners) are never signalled: a movie-ui job
whose process exits is recorded as failed by its runner. Exit 0 when no job or worker is left,
1 otherwise. --dry-run only lists what would be stopped. Stdlib only. Spec:
docs/superpowers/specs/2026-10-21-clean-stop-design.md.
"""

import argparse
import os
import signal
import subprocess
import sys
import time

BIN = os.path.dirname(os.path.realpath(__file__))

JOB_SCRIPTS = ("ltx-movie", "iterate-story", "character-train-vlm", "action-train-vlm")
JOB_TOOLS = ("character", "action")          # with a create or train subcommand
WORKER_MARKERS = ("character_dataset.py zimage", "character_dataset.py qwenedit", "mflux-train",
                  "bin/ltx-mlx-render", "bin/ltx-story-images")
NEVER = ("story-server", "mlx_vlm.server", "vllm", "mtplx", "movie-ui")


def process_table():
    """[(pid, ppid, command)] from ps."""
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True,
                         text=True, check=True).stdout
    rows = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3:
            rows.append((int(parts[0]), int(parts[1]), parts[2]))
    return rows


def protected(command):
    """True for the story server and movie-ui. Only the program words count (the first four,
    e.g. "python -m mlx_vlm.server"), never the arguments: a seed image under
    .../movie-ui/uploads/ must not hide the create that uses it."""
    return any(n in os.path.basename(w) for w in command.split()[:4] for n in NEVER)


def classify(command):
    """"job", "worker" or None for one command line."""
    if protected(command):
        return None
    words = command.split()
    for i, word in enumerate(words):
        base = os.path.basename(word)
        if base in JOB_SCRIPTS and "/bin/" in "/" + word:
            return "job"
        if (base in JOB_TOOLS and "/bin/" in "/" + word and i + 1 < len(words)
                and words[i + 1] in ("create", "train")):
            return "job"
    if any(m in command for m in WORKER_MARKERS):
        return "worker"
    if "ltx-2-mlx" in command and any(w in ("generate", "train", "preprocess") for w in words):
        return "worker"
    return None


def targets(rows, me):
    """{pid: (kind, command)} of the jobs and workers in rows, except me and my parent."""
    return {pid: (kind, cmd) for pid, ppid, cmd in rows
            for kind in [classify(cmd)] if kind and pid not in me}


def descendants(rows, roots):
    """Every pid below roots (excluding NEVER processes such as a story server a cleanup
    started)."""
    children = {}
    for pid, ppid, cmd in rows:
        children.setdefault(ppid, []).append((pid, cmd))
    seen, stack = set(), list(roots)
    while stack:
        for pid, cmd in children.get(stack.pop(), []):
            if pid not in seen and not protected(cmd):
                seen.add(pid)
                stack.append(pid)
    return seen


def shown(command):
    """command without a leading python interpreter path, for the listing."""
    words = command.split()
    if words and "ython" in os.path.basename(words[0]):
        words = words[1:]
    return " ".join(words)[:110]


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def signal_all(pids, sig):
    for pid in sorted(pids):
        try:
            os.kill(pid, sig)
        except (ProcessLookupError, PermissionError):
            pass


def wait_gone(pids, seconds, label):
    deadline, next_note = time.monotonic() + seconds, time.monotonic() + 15
    while time.monotonic() < deadline:
        left = [p for p in pids if alive(p)]
        if not left:
            return []
        if time.monotonic() >= next_note:
            print("pipeline-stop: waiting for %d %s to exit" % (len(left), label), flush=True)
            next_note += 15
        time.sleep(0.5)
    return [p for p in pids if alive(p)]


def available_gib():
    try:
        out = subprocess.run(["vm_stat"], capture_output=True, text=True).stdout
    except OSError:
        return None
    pages, size = 0, 16384
    for line in out.splitlines():
        if "page size of" in line:
            size = int(line.split("page size of")[1].split()[0])
        key = line.split(":")[0]
        if key in ("Pages free", "Pages inactive", "Pages speculative"):
            pages += int(line.split(":")[1].strip().rstrip("."))
    return pages * size / 2.0 ** 30


def main(argv=None):
    parser = argparse.ArgumentParser(prog="pipeline-stop", description=__doc__.split("\n")[1])
    parser.add_argument("--grace", type=float, default=180.0, metavar="SECONDS")
    parser.add_argument("--no-restore", dest="restore", action="store_false")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)
    me = {os.getpid(), os.getppid()}

    found = targets(process_table(), me)
    for pid, (kind, cmd) in sorted(found.items()):
        print("pipeline-stop: %-6s %d  %s" % (kind, pid, shown(cmd)))
    if not found:
        print("pipeline-stop: no pipeline job or worker is running")
    if args.dry_run:
        return 0

    jobs = [pid for pid, (kind, _) in found.items() if kind == "job"]
    if jobs:
        print("pipeline-stop: SIGTERM to %d job(s); waiting up to %d s for their cleanup"
              % (len(jobs), args.grace), flush=True)
        signal_all(jobs, signal.SIGTERM)
        wait_gone(jobs, args.grace, "job(s)")

    rows = process_table()
    left = set(targets(rows, me))
    left |= descendants(rows, left)
    if left:
        print("pipeline-stop: SIGTERM to %d process(es): %s"
              % (len(left), " ".join(str(p) for p in sorted(left))), flush=True)
        signal_all(left, signal.SIGTERM)
        stuck = wait_gone(sorted(left), 10, "process(es)")
        if stuck:
            print("pipeline-stop: SIGKILL to %s" % " ".join(str(p) for p in stuck), flush=True)
            signal_all(stuck, signal.SIGKILL)
            wait_gone(stuck, 5, "process(es)")

    if args.restore:
        subprocess.run([os.path.join(BIN, "story-server-restore"), "--wait"])

    remaining = targets(process_table(), me)
    for pid, (kind, cmd) in sorted(remaining.items()):
        print("pipeline-stop: STILL RUNNING %s %d  %s" % (kind, pid, shown(cmd)))
    try:
        status = subprocess.run([os.path.join(BIN, "story-server"), "status"],
                                capture_output=True, text=True, timeout=60).stdout
        state = next((" ".join(l.split()[1:]) for l in status.splitlines()
                      if l.strip().startswith("state:")), "unknown")
    except (OSError, subprocess.SubprocessError):
        state = "unknown"
    gib = available_gib()
    print("pipeline-stop: %s; story server %s; %s GiB available"
          % ("nothing left running" if not remaining else "%d left" % len(remaining),
             state, "?" if gib is None else "%.0f" % gib))
    return 0 if not remaining else 1


if __name__ == "__main__":
    sys.exit(main())
