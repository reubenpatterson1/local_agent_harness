#!/usr/bin/env python3
"""ltx-mlx-render -- turn a generated/stories/<story_id>/manifest.json into
one movie.mp4 by rendering ONE ltx-2-mlx clip per panel and stream-copy
concatenating them with ffmpeg's concat demuxer.

This is the MLX render path. It is deliberately NOT bin/ltx-story-video:

  * It never imports mps_guard, and therefore never runs bin/ltx-host-prep
    or bin/ltx-host-restore, never touches the MTPLX/vLLM servers on
    8177/8178, never runs a ceiling check, an _await_gpu_reclaim, a
    _release_page_cache or a Sentinel abort.
  * It produces one real .mp4 per panel (h264 + aac, written by ltx-2-mlx's
    own ffmpeg child), not a flat list of PNG frames. There is therefore no
    all-frames-in-RAM concat and no MAX_TOTAL_FRAMES cap of any kind: the
    concat demuxer streams.
  * It carries its own trimmed manifest validator. That duplicates ~35 lines
    of bin/ltx-story-video::load_manifest ON PURPOSE -- the two have
    genuinely diverged (that one must enforce the 8k+1 lattice on
    manifest-supplied frame counts, this one overrides them with --frames),
    and importing bin/ltx-story-video to share a validator would drag
    mps_guard into this process. Do not "fix" this by extracting a module.

It does NOT duplicate the story.md parser: this script reads manifest.json
only. bin/ltx-story-manifest remains the single story.md parser in this
workspace (see the load-bearing comment at bin/ltx-story-images:83-87).

See docs/superpowers/specs/2026-09-10-ltx2-mlx-video-pipeline-design.md.
"""

import argparse
import datetime
import glob
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import time
import uuid

WS = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, WS)

import ltx2_mlx_video_skill as SKILL  # noqa: E402

# Measured by acceptance test A1 on this 48 GiB host, 2026-09-11:
# 704x448, 241 frames, --distilled --low-ram, tile_frames=1, tile_spatial=1
# -> 160.18 s per panel, rounded to the nearest 60 s.
SECONDS_PER_PANEL_ESTIMATE = 180   # 3 min

JETSAM_LADDER = """\
This is the signature of a jetsam kill: ltx-2-mlx exited 0 but wrote no
usable mp4, which is what happens when the OS kills the ffmpeg child under
memory pressure. There is no traceback to read. Remediation ladder, applied
as RUN-TIME FLAGS (the --frames 241 default is deliberately not lowered):
  1. --tile-frames 2
  2. --tile-frames 2 --tile-spatial 2
  3. --frames 193   (8.04 s per panel)
  4. --frames 145   (6.04 s per panel)"""

SUMMARY_KEYS = (
    "schema_version", "backend", "story_id", "manifest_path",
    "manifest_schema_version", "model", "width", "height", "frames_per_panel",
    "fps", "low_ram", "tile_frames", "tile_spatial", "requested_units",
    "completed_units", "intended_total_frames", "actual_total_frames", "units",
    "clips", "skipped_panels", "concat_mode", "output_path", "on_panel_failure",
    "stopped_reason",
)

# A chained panel's conditioning frame is rejected as black or flat below these
# signalstats luma levels. Heuristics: limited-range black is Y=16.
CHAIN_SEED_MIN_YAVG = 20
CHAIN_SEED_MIN_YRANGE = 10


class ConcatPreflightError(RuntimeError):
    """Raised when the rendered clips are not uniform enough to stream-copy
    concatenate, naming the offending clip and the exact differing field."""


class _RepeatableLoraAction(argparse.Action):
    """Repeatable --lora: the dest (lora_path / stills_lora_path) keeps the FIRST value as a
    string, exactly like the old single-valued flag; <dest>_specs collects every value in
    command-line order (spec 5.7.1)."""

    def __call__(self, parser, namespace, values, option_string=None):
        specs = list(getattr(namespace, self.dest + "_specs", None) or [])
        specs.append(values)
        setattr(namespace, self.dest + "_specs", specs)
        if getattr(namespace, self.dest, None) is None:
            setattr(namespace, self.dest, values)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ltx-mlx-render",
        description=("Render one ltx-2-mlx clip per manifest panel and "
                     "stream-copy concatenate them into OUTPUT_MP4."),
    )
    parser.add_argument("manifest_path", metavar="MANIFEST")
    parser.add_argument("output_path", metavar="OUTPUT_MP4")
    parser.add_argument("--frames", type=int, default=SKILL.DEFAULT_NUM_FRAMES)
    parser.add_argument("--width", type=int, default=SKILL.DEFAULT_WIDTH)
    parser.add_argument("--height", type=int, default=SKILL.DEFAULT_HEIGHT)
    # There is no --fps: --frame-rate is the single source of truth. It is
    # written to story_summary.json as "fps" so bin/ltx-movie::_report_summary
    # keeps working unchanged.
    parser.add_argument("--frame-rate", dest="frame_rate", type=int,
                        default=SKILL.DEFAULT_FRAME_RATE)
    parser.add_argument("--seed", type=int, default=0,
                        help="base seed; panel i uses seed S+i")
    parser.add_argument("--model", default=SKILL.MODEL_ID)
    parser.add_argument("--gemma", default=SKILL.GEMMA_MODEL_ID)
    parser.add_argument("--lora", dest="lora_path", action=_RepeatableLoraAction, default=None,
                        help="global LoRA for the video DiT (ltx-2-mlx): repeatable; PATH or "
                             "PATH:STRENGTH (0 < STRENGTH <= 2, default 1.0). Every global LoRA "
                             "applies to every panel, ahead of that panel's cast-character LoRAs, "
                             "at its own strength (never reduced automatically).")
    parser.add_argument("--no-low-ram", dest="no_low_ram", action="store_true",
                        default=False)
    parser.add_argument("--tile-frames", dest="tile_frames", type=int, default=1)
    parser.add_argument("--tile-spatial", dest="tile_spatial", type=int, default=1)
    parser.add_argument("--panel-timeout", dest="panel_timeout", type=int, default=7200)
    parser.add_argument("--clips-dir", dest="clips_dir", default=None,
                        help="default: <story_dir>/clips")
    parser.add_argument("--resume", action="store_true", default=False,
                        help="reuse existing clips whose frame count matches --frames")
    parser.add_argument("--force", action="store_true", default=False,
                        help="overwrite OUTPUT_MP4 if it exists; has NO effect on "
                             "clip reuse (that is --resume's job)")
    parser.add_argument("--dry-run", dest="dry_run", action="store_true", default=False)
    parser.add_argument("--on-panel-failure", dest="on_panel_failure",
                        choices=["skip", "stop"], default="stop")
    parser.add_argument("--retry-failed", dest="retry_failed", type=int,
                        choices=[0, 1], default=0)
    parser.add_argument("--retry-idle", dest="retry_idle", type=float, default=120)
    parser.add_argument("--max-consecutive-failures", dest="max_consecutive_failures",
                        type=int, default=3)
    parser.add_argument("--skip-input-screen", dest="skip_input_screen",
                        action="store_true", default=False)
    return parser


def validate_cli_geometry(args):
    """Return None when the geometry/tiling flags are usable, else the error
    message string the caller should print before exiting 2."""
    try:
        SKILL.validate_geometry(args.width, args.height, args.frames)
    except ValueError as e:
        return str(e)
    if args.tile_frames < 1:
        return "tile_frames must be >= 1, got %d" % args.tile_frames
    if args.tile_spatial < 1:
        return "tile_spatial must be >= 1, got %d" % args.tile_spatial
    return None


def story_dir_for(story_id):
    return os.path.join(WS, "generated", "stories", story_id)


def new_run_id():
    """Same shape as bin/ltx-story-video:865-872 so bin/ltx-movie's
    runs/*/story_summary.json glob keeps finding these runs."""
    return "%s-%s" % (
        datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ"),
        uuid.uuid4().hex[:8],
    )


def load_manifest(path):
    """Load and schema-validate a manifest.json for the MLX path.

    Modelled on bin/ltx-story-video::load_manifest (:166-222) with the
    num_frames checks REMOVED: per-panel num_frames is ignored here because
    --frames is authoritative for every panel. In practice they agree,
    because bin/ltx-movie passes --min-frames <frames> --max-frames <frames>
    to bin/ltx-story-manifest, which makes _allocate_frames a no-op.

    A panel whose image_path is None or absent renders text-to-video. An
    EMPTY STRING is not "absent" and is rejected.

    Schema version 3 (bin/ltx-story-manifest --chain) requires a per-panel
    "conditioning" of still (an existing, readable image_path), chain (index >= 2,
    image_path null) or t2v (image_path null). For older schemas conditioning is
    derived: still when the panel has an image_path, else t2v -- so v1/v2 manifests
    behave exactly as before."""
    with open(path) as f:
        data = json.load(f)
    schema_version = data.get("schema_version", 1)

    panels = data.get("panels") or []
    if not panels:
        raise ValueError("manifest has no panels")

    expected_index = 1
    for panel in panels:
        index = panel.get("index")
        if index != expected_index:
            raise ValueError(
                "panels must be indexed contiguously from 1 with no gaps; "
                "expected index %d, got %r" % (expected_index, index))
        expected_index += 1

        if "image_path" not in panel or panel.get("image_path") is None:
            panel["image_path"] = None
        else:
            image_path = panel["image_path"]
            if (not image_path or not os.path.isfile(image_path)
                    or not os.access(image_path, os.R_OK)):
                raise ValueError(
                    "panel %d: image_path does not exist or is not readable: %r"
                    % (index, image_path))

        if schema_version >= 3:
            conditioning = panel.get("conditioning")
            if conditioning not in ("still", "chain", "t2v"):
                raise ValueError("panel %d: conditioning must be one of still/chain/t2v, got %r"
                                 % (index, conditioning))
            if conditioning == "still" and panel["image_path"] is None:
                raise ValueError("panel %d: conditioning 'still' requires an existing, "
                                 "readable image_path" % index)
            if conditioning == "chain" and (index < 2 or panel["image_path"] is not None):
                raise ValueError("panel %d: conditioning 'chain' requires index >= 2 and "
                                 "image_path null" % index)
            if conditioning == "t2v" and panel["image_path"] is not None:
                raise ValueError("panel %d: conditioning 't2v' requires image_path null" % index)
        else:
            panel["conditioning"] = "still" if panel["image_path"] else "t2v"

        if "characters" in panel:
            characters = panel["characters"]
            if not isinstance(characters, list):
                raise ValueError("panel %d: characters must be a list" % index)
            seen = set()
            for entry in characters:
                name = entry.get("name") if isinstance(entry, dict) else None
                if not isinstance(name, str) or not name:
                    raise ValueError("panel %d: every characters entry needs a non-empty name" % index)
                if name in seen:
                    raise ValueError("panel %d: character %s is listed more than once" % (index, name))
                seen.add(name)
                lora = entry.get("video_lora")
                if (not isinstance(lora, str) or not os.path.isabs(lora) or not os.path.isfile(lora)
                        or not os.access(lora, os.R_OK)):
                    raise ValueError("panel %d: character %s's video_lora is not a readable file: %r"
                                     % (index, name, lora))
                strength = entry.get("strength")
                if (isinstance(strength, bool) or not isinstance(strength, (int, float))
                        or not 0 < strength <= 1.0):
                    raise ValueError("panel %d: character %s's strength must be a number in (0, 1], "
                                     "got %r" % (index, name, strength))

        panel_text = panel.get("panel_text")
        if not isinstance(panel_text, str) or not panel_text.strip():
            raise ValueError("panel %d: panel_text is required and must be a "
                             "non-empty string" % index)

    return data


def resolve_prompt(panel):
    """Identical to bin/ltx-story-video::_resolve_motion_prompt (:225-226)."""
    return panel.get("motion_prompt") or panel["panel_text"]


def build_units(panels, seed, clips_dir, run_root=None, global_loras=()):
    """Return the ordered per-panel unit list.

    Each unit: {"index", "label", "seed", "prompt", "image_path", "clip_path",
    "log_path", "conditioning", "chain_source"}. seed is base + i and label is
    "panel-<i>", both identical to bin/ltx-story-video::build_units (:267) so the
    story_summary.json unit labels read the same way in
    bin/ltx-movie::_report_summary.

    A "chain" unit is conditioned on the exact last frame of the previous panel's
    clip: chain_source is that clip, and image_path is <clips_dir>/panel_%02d.chainseed.png,
    extracted at render time. Every other unit keeps the panel's own image_path and
    has chain_source None. panels must carry "conditioning" (load_manifest sets it).

    Every panel shares --frames/--width/--height/--frame-rate/--model and
    the low-ram + tiling settings; that uniformity is exactly what makes
    stream-copy concatenation valid, so it is NOT per-unit state."""
    units = []
    for i, panel in enumerate(panels, start=1):
        conditioning = panel["conditioning"]
        chained = conditioning == "chain"
        unit = {
            "index": i,
            "label": "panel-%d" % i,
            "seed": seed + i,
            "prompt": resolve_prompt(panel),
            "image_path": (os.path.join(clips_dir, "panel_%02d.chainseed.png" % i) if chained
                           else panel.get("image_path")),
            "clip_path": os.path.join(clips_dir, "panel_%02d.mp4" % i),
            "log_path": (os.path.join(run_root, "panel_%02d.log" % i)
                         if run_root else None),
            "conditioning": conditioning,
            "chain_source": (os.path.join(clips_dir, "panel_%02d.mp4" % (i - 1)) if chained
                             else None),
        }
        loras = [{"kind": "global", "name": None, "path": g["path"], "strength": g["strength"]}
                 for g in global_loras]
        loras += [{"kind": "character", "name": c["name"], "path": c["video_lora"],
                   "strength": float(c["strength"])} for c in (panel.get("characters") or [])]
        if loras:
            unit["loras"] = loras
        units.append(unit)
    return units


def clip_frame_count(clip_path):
    """Number of video packets in clip_path, or None if ffprobe cannot say.
    None is deliberately NOT distinguished from a wrong count: anything that
    is not a confident match causes a regenerate."""
    try:
        proc = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0", "-count_packets",
             "-show_entries", "stream=nb_read_packets", "-print_format", "json", clip_path],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    try:
        return int(json.loads(proc.stdout)["streams"][0]["nb_read_packets"])
    except (ValueError, KeyError, IndexError, TypeError):
        return None


def model_identity(model, *, strict=False):
    """Read bundle metadata without loading weights or downloading a model."""
    revision = None
    bundle = model
    resolved = False
    try:
        resolved = os.path.lexists(bundle) or os.path.isabs(bundle)
        if not os.path.isdir(bundle):
            if resolved:
                raise FileNotFoundError("model bundle is unavailable: %s" % bundle)
            repository = os.path.join(SKILL.LTX2_MLX_HF_HOME, "hub", "models--" + model.replace("/", "--"))
            resolved = os.path.lexists(repository) or model == SKILL.MODEL_ID
            with open(os.path.join(repository, "refs", "main"), encoding="utf-8") as handle:
                revision = handle.read().strip()
            resolved = True
            if not revision or any(character not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" for character in revision):
                raise OSError("cached model revision is invalid")
            snapshots_root = os.path.join(repository, "snapshots")
            if os.path.isdir(snapshots_root):
                bundle = os.path.join(snapshots_root, revision)
            else:
                # `hf download --local-dir` writes files flat into the repo root with
                # no snapshots/ tree at all; use the repo root directly rather than
                # failing, since the weight files are genuinely there. A snapshots/
                # tree that exists but is missing this specific revision is a
                # different, still-fatal case (see the "broken existing snapshot"
                # test) and is deliberately left alone below.
                bundle = repository
        bundle = os.path.realpath(bundle)
        if not os.path.isdir(bundle):
            raise FileNotFoundError("resolved model bundle is unavailable: %s" % bundle)
        resolved = True
        files = []
        errors = []
        for directory, _directories, filenames in os.walk(bundle, followlinks=False, onerror=errors.append):
            for name in filenames:
                if not name.endswith((".safetensors", ".json")):
                    continue
                path = os.path.join(directory, name)
                info = os.stat(path)
                if not stat.S_ISREG(info.st_mode):
                    continue
                if not os.access(path, os.R_OK):
                    raise PermissionError("model metadata is unreadable: %s" % path)
                files.append({"path": os.path.relpath(path, bundle).replace(os.sep, "/"),
                              "size": info.st_size, "mtime_ns": info.st_mtime_ns})
        if errors:
            raise errors[0]
        if not files:
            return None
        return {"resolved_path": bundle, "snapshot_revision": revision,
                "files": sorted(files, key=lambda item: item["path"])}
    except OSError:
        if strict and resolved:
            raise
        return None
    except (ValueError, TypeError):
        return None


def file_sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


_LORA_SHA256_CACHE = {}


def lora_sha256(path):
    """file_sha256, memoized on (realpath, size, mtime_ns): a 642 MB LoRA is hashed once per
    process, not three times per panel; a rewritten file changes the key and is re-hashed."""
    info = os.stat(path)
    key = (os.path.realpath(path), info.st_size, info.st_mtime_ns)
    if key not in _LORA_SHA256_CACHE:
        _LORA_SHA256_CACHE[key] = file_sha256(path)
    return _LORA_SHA256_CACHE[key]


def build_clip_provenance(unit, args, *, strict=False):
    """The exact generation identity a reusable clip must match. schema_version 2: every
    pre-redesign clip is deliberately non-reusable (it was conditioned on the old,
    cropped, independent stills). A chain unit is keyed on its SOURCE CLIP's bytes plus
    the frame index taken from it, not on the extracted PNG, so an ffmpeg PNG-encoder
    change cannot cascade a spurious re-render while any real change to clip k-1 does."""
    conditioning = unit["conditioning"]
    provenance = {
        "schema_version": 2,
        "backend": "ltx-2-mlx",
        "model": args.model,
        "model_identity": model_identity(args.model, strict=strict),
        "gemma": args.gemma,
        "lora_path": args.lora_path,
        "prompt_sha256": hashlib.sha256(unit["prompt"].encode("utf-8")).hexdigest(),
        "conditioning": conditioning,
        "image_sha256": file_sha256(unit["image_path"]) if conditioning == "still" else None,
        "chain_source_sha256": (file_sha256(unit["chain_source"]) if conditioning == "chain"
                                else None),
        "chain_frame_index": args.frames - 1 if conditioning == "chain" else None,
        "seed": unit["seed"], "width": args.width, "height": args.height,
        "frames": args.frames, "fps": args.frame_rate, "low_ram": not args.no_low_ram,
        "tile_frames": args.tile_frames, "tile_spatial": args.tile_spatial,
    }
    if unit.get("loras"):
        provenance["loras"] = [{"kind": l["kind"], "path": l["path"],
                                "sha256": lora_sha256(l["path"]), "strength": l["strength"]}
                               for l in unit["loras"]]
    return provenance


def write_clip_provenance(clip_path, provenance):
    path = clip_path + ".provenance.json"
    temporary = path + "." + uuid.uuid4().hex + ".tmp"
    try:
        with open(temporary, "x", encoding="utf-8") as handle:
            json.dump(dict(provenance, output_sha256=file_sha256(clip_path)), handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def clip_is_reusable(clip_path, expected_frames, provenance=None):
    """Reuse requires exact generation identity, clip checksum and frame count."""
    if not provenance or provenance.get("model_identity") is None:
        return False
    try:
        if not os.path.isfile(clip_path) or os.path.getsize(clip_path) == 0:
            return False
        with open(clip_path + ".provenance.json", encoding="utf-8") as handle:
            recorded = json.load(handle)
        expected = dict(provenance, output_sha256=file_sha256(clip_path))
        if json.dumps(recorded, sort_keys=True, separators=(",", ":"), allow_nan=False) != json.dumps(
            expected, sort_keys=True, separators=(",", ":"), allow_nan=False
        ):
            return False
        return clip_frame_count(clip_path) == expected_frames
    except (OSError, ValueError, TypeError):
        return False


def ffprobe_image_size(path):
    """((width, height), None) for an image file, or (None, reason) when ffprobe cannot
    say. ffprobe rather than PIL: this script imports no image library (R2a)."""
    try:
        proc = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height", "-of", "json", path],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, str(e)
    if proc.returncode != 0:
        return None, "rc=%d: %s" % (proc.returncode, proc.stderr.strip())
    try:
        stream = json.loads(proc.stdout)["streams"][0]
        return (int(stream["width"]), int(stream["height"])), None
    except (ValueError, KeyError, IndexError, TypeError) as e:
        return None, "unparseable ffprobe output (%s: %s)" % (type(e).__name__, e)


def extract_last_frame(clip_path, out_png, frames):
    """Write frame index frames-1 of clip_path -- its exact last frame -- to out_png.
    Returns [] on success, else one violation string.

    Selecting by exact index is deterministic because every ok or reused clip has
    already been verified at exactly --frames frames. -sseof is deliberately not used:
    it seeks by time, not to the last frame. The frame is written to a .tmp.png first
    and renamed, so a partial write is never mistaken for a frame."""
    tmp = out_png[:-len(".png")] + ".tmp.png"
    try:
        proc = subprocess.run(
            ["ffmpeg", "-v", "error", "-nostdin", "-y", "-i", clip_path,
             "-vf", "select=eq(n\\,%d)" % (frames - 1), "-fps_mode", "passthrough",
             "-frames:v", "1", tmp],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        return ["clip %s: last-frame extraction failed: %s" % (clip_path, e)]
    if proc.returncode != 0 or not os.path.isfile(tmp) or os.path.getsize(tmp) == 0:
        tail = "\n".join((proc.stderr or "").splitlines()[-5:])
        reason = tail or ("ffmpeg exited %d and wrote no frame %d to %s"
                          % (proc.returncode, frames - 1, tmp))
        return ["clip %s: last-frame extraction failed: %s" % (clip_path, reason)]
    os.replace(tmp, out_png)
    return []


def check_chain_seed(png_path, width, height, source_panel):
    """Validate an extracted chain frame: exactly width x height, and neither black nor
    flat by ffmpeg signalstats luma. source_panel is the panel whose clip the frame came
    from; the remedy names that panel's Motion:. Returns [] or one violation string."""
    size, error = ffprobe_image_size(png_path)
    if error:
        return ["chain frame %s: ffprobe failed: %s" % (png_path, error)]
    if size != (width, height):
        return ["chain frame %s is %dx%d, expected %dx%d"
                % (png_path, size[0], size[1], width, height)]
    try:
        proc = subprocess.run(
            ["ffmpeg", "-v", "error", "-nostdin", "-i", png_path,
             "-vf", "signalstats,metadata=mode=print:file=-", "-f", "null", "-"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return ["chain frame %s: could not measure brightness" % png_path]
    stats = dict(re.findall(r"lavfi\.signalstats\.(YAVG|YMIN|YMAX)=([0-9.]+)",
                            proc.stdout or ""))
    if proc.returncode != 0 or set(stats) != {"YAVG", "YMIN", "YMAX"}:
        return ["chain frame %s: could not measure brightness" % png_path]
    yavg, ymin, ymax = float(stats["YAVG"]), float(stats["YMIN"]), float(stats["YMAX"])
    if yavg < CHAIN_SEED_MIN_YAVG or ymax - ymin < CHAIN_SEED_MIN_YRANGE:
        return ["chain frame %s is degenerate (YAVG=%.1f, YMIN=%.1f, YMAX=%.1f): black or "
                "flat; edit panel %d's Motion: in story.md to change it, then rerun -- the "
                "edited panel and every later panel re-render"
                % (png_path, yavg, ymin, ymax, source_panel)]
    return []


def prepare_chain_seed(unit, args):
    """Extract and validate a chain unit's conditioning frame. Returns [] when
    unit["image_path"] holds a usable frame, else the violations."""
    return (extract_last_frame(unit["chain_source"], unit["image_path"], args.frames)
            or check_chain_seed(unit["image_path"], args.width, args.height,
                                unit["index"] - 1))


_REMEDY = ("re-render that panel with --force (or delete the clip and rerun "
           "with --resume)")


def probe_streams(clip_path):
    """ffprobe -show_streams as a parsed dict. Raises ConcatPreflightError if
    ffprobe cannot read the clip."""
    try:
        proc = subprocess.run(
            ["ffprobe", "-v", "error", "-print_format", "json", "-show_streams", clip_path],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise ConcatPreflightError("clip %s: could not run ffprobe (%s); %s"
                                   % (clip_path, e, _REMEDY))
    if proc.returncode != 0:
        raise ConcatPreflightError(
            "clip %s: ffprobe failed (rc=%d): %s; %s"
            % (clip_path, proc.returncode, proc.stderr.strip(), _REMEDY))
    try:
        return json.loads(proc.stdout)
    except ValueError as e:
        raise ConcatPreflightError("clip %s: ffprobe output is not JSON (%s); %s"
                                   % (clip_path, e, _REMEDY))


def assert_clips_uniform(clip_streams, width, height, frame_rate):
    """clip_streams: ordered [(clip_path, probe_dict)]. Raise
    ConcatPreflightError naming the clip and the exact differing field.

    These properties hold BY CONSTRUCTION -- ltx-2-mlx's video_vae.py:538-561
    hardcodes -c:v libx264 -pix_fmt yuv420p -crf 18 (-c:a aac when audio is
    present), and every clip in one run shares geometry and frame rate. The
    preflight turns that assumption into a checked precondition. A
    concat-filter re-encode fallback is deliberately NOT provided: it would
    be unreachable dead code that, if it ever fired, would paper over a real
    bug at the cost of a crf 18 -> 18 generational quality loss."""
    ref_rate = None
    ref_channels = None
    ref_clip = None
    for clip_path, probe in clip_streams:
        streams = probe.get("streams") or []
        video = [s for s in streams if s.get("codec_type") == "video"]
        audio = [s for s in streams if s.get("codec_type") == "audio"]

        if len(video) != 1:
            raise ConcatPreflightError(
                "clip %s: expected exactly 1 video stream, found %d; %s"
                % (clip_path, len(video), _REMEDY))
        if len(audio) != 1:
            raise ConcatPreflightError(
                "clip %s: expected exactly 1 audio stream, found %d; %s"
                % (clip_path, len(audio), _REMEDY))

        v, a = video[0], audio[0]
        checks = [
            ("video codec_name", v.get("codec_name"), "h264"),
            ("pix_fmt", v.get("pix_fmt"), "yuv420p"),
            ("video width", v.get("width"), width),
            ("video height", v.get("height"), height),
            ("r_frame_rate", v.get("r_frame_rate"), "%d/1" % frame_rate),
            ("audio codec_name", a.get("codec_name"), "aac"),
        ]
        for field, actual, expected in checks:
            if actual != expected:
                raise ConcatPreflightError(
                    "clip %s: %s is %r, expected %r; %s"
                    % (clip_path, field, actual, expected, _REMEDY))

        if ref_clip is None:
            ref_clip = clip_path
            ref_rate = a.get("sample_rate")
            ref_channels = a.get("channels")
        else:
            if a.get("sample_rate") != ref_rate:
                raise ConcatPreflightError(
                    "clip %s: audio sample_rate is %r, expected %r to match %s; %s"
                    % (clip_path, a.get("sample_rate"), ref_rate, ref_clip, _REMEDY))
            if a.get("channels") != ref_channels:
                raise ConcatPreflightError(
                    "clip %s: audio channels is %r, expected %r to match %s; %s"
                    % (clip_path, a.get("channels"), ref_channels, ref_clip, _REMEDY))


def build_concat_list(clip_paths):
    """The concat demuxer's list file. Absolute paths, panel-index order, a
    literal single quote escaped as '\\'' per ffmpeg's quoting rules."""
    out = []
    for clip_path in clip_paths:
        path = os.path.abspath(clip_path)
        if "\n" in path or "\r" in path:
            raise ConcatPreflightError(
                "clip path %r contains a newline; the concat demuxer's list "
                "format cannot represent it -- use a --clips-dir without one" % path)
        out.append("file '%s'\n" % path.replace("'", "'\\''"))
    return "".join(out)


def build_concat_command(list_path, output_path):
    """Stream copy only. Per-segment AAC encoder priming adds ~23 ms of
    lead-in silence at each join, but the concat demuxer re-bases timestamps
    per segment, so it does not accumulate; the worst case is ~23 ms inside
    one panel, landing on what is already a hard cut. ltx-2-mlx deliberately
    omits -shortest (video_vae.py:555-559), so a clip's audio may end a hair
    before its video -- a brief tail silence, not drift."""
    return ["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", list_path,
            "-c", "copy", "-movflags", "+faststart", output_path]


def estimate_seconds_per_panel(story_dir, frames, width, height, low_ram,
                               tile_frames, tile_spatial, model, backend="ltx-2-mlx"):
    """Return (seconds_per_panel, label).

    Precedence: the newest story_summary.json under <story_dir>/runs/ whose
    frames_per_panel/width/height/low_ram/tile_frames/tile_spatial/model all
    match this invocation AND that has at least one unit with status "ok"
    and resumed false -- mean of those units' seconds. Resumed units carry
    seconds 0.0 and would poison the mean, so they are excluded. Otherwise
    the SECONDS_PER_PANEL_ESTIMATE constant.

    A summary file that is valid JSON but the wrong shape (not a dict, a
    non-list "units", a non-dict unit entry) is skipped rather than raising:
    this is an advisory estimate feeding --dry-run, and a malformed old
    summary must never be able to crash the plan review it supports."""
    matches = glob.glob(os.path.join(story_dir, "runs", "*", "story_summary.json"))
    for path in sorted(matches, key=lambda p: (
            os.path.getmtime(p) if os.path.exists(p) else -1.0,
            os.path.dirname(p)), reverse=True):
        try:
            with open(path) as f:
                summary = json.load(f)
        except (OSError, ValueError):
            continue
        if not isinstance(summary, dict):
            continue
        units = summary.get("units")
        if not isinstance(units, list):
            continue
        if (summary.get("backend") != backend
                or summary.get("frames_per_panel") != frames
                or summary.get("width") != width
                or summary.get("height") != height
                or summary.get("low_ram") != low_ram
                or summary.get("tile_frames") != tile_frames
                or summary.get("tile_spatial") != tile_spatial
                or summary.get("model") != model):
            continue
        seconds = [u.get("seconds") for u in units
                   if isinstance(u, dict) and u.get("status") == "ok"
                   and u.get("resumed") is False
                   and isinstance(u.get("seconds"), (int, float))]
        if not seconds:
            continue
        run_id = os.path.basename(os.path.dirname(path))
        return (sum(seconds) / len(seconds),
                "measured (%s, %d panels)" % (run_id, len(seconds)))
    return (float(SECONDS_PER_PANEL_ESTIMATE),
            "default estimate (unmeasured for this configuration)")


def format_estimate_lines(seconds_per_panel, label, to_render, total):
    """The estimate block printed at the bottom of --dry-run. Because
    bin/ltx-movie Phase 3 shells this with --dry-run and streams the output,
    this lands directly above the review prompt with no stdout parsing
    anywhere."""
    lines = ["estimated render time: %d panels x %.1f min = %.1f h  [source: %s]"
             % (to_render, seconds_per_panel / 60.0,
                to_render * seconds_per_panel / 3600.0, label)]
    if to_render != total:
        lines.append("  (%d of %d panels already rendered and will be skipped)"
                     % (total - to_render, total))
    return lines


def print_dry_run(args, manifest, units, story_id, clips_dir):
    """Resolve everything, touch nothing, print the plan, return 0.

    Deliberately does NOT check for the ltx-2-mlx binary or ffmpeg: a dry run
    must be usable on a machine that cannot render.

    The --resume prediction runs IN ORDER: a chained unit is predicted reusable only
    when the unit before it is predicted reusable too -- otherwise its source clip is
    about to be re-rendered -- and only then is its source clip hashed."""
    seconds_per_panel_play = args.frames / float(args.frame_rate)
    total_panels = len(units)

    print("manifest: %s" % os.path.abspath(args.manifest_path))
    print("story id: %s" % story_id)
    print("panels: %d" % total_panels)
    for unit in units:
        if unit["conditioning"] == "chain":
            print("  panel %2d: I2V chained <- last frame (index %d) of %s"
                  % (unit["index"], args.frames - 1, unit["chain_source"]))
        elif unit["image_path"]:
            print("  panel %2d: I2V %s" % (unit["index"], unit["image_path"]))
        else:
            print("  panel %2d: T2V (no conditioning image)" % unit["index"])
        for l in unit.get("loras", []):
            print("            lora: %s @ %s (%s)" % (l["path"], repr(l["strength"]), l["name"] or "global"))
    print("clips dir: %s" % clips_dir)
    print("output: %s" % os.path.abspath(args.output_path))
    print("geometry: %dx%d, %d frames @ %d fps = %.2f s per panel"
          % (args.width, args.height, args.frames, args.frame_rate,
             seconds_per_panel_play))
    print("total: %d panels x %.2f s = %.2f s of finished movie"
          % (total_panels, seconds_per_panel_play,
             total_panels * seconds_per_panel_play))
    print("note: manifest per-panel num_frames is ignored; --frames %d is authoritative"
          % args.frames)

    would_skip = []
    would_render = []
    skipped = set()
    for unit in units:
        reusable = False
        if args.resume and (unit["conditioning"] != "chain" or unit["index"] - 1 in skipped):
            reusable = clip_is_reusable(unit["clip_path"], args.frames,
                                        build_clip_provenance(unit, args))
        if reusable:
            would_skip.append(unit)
            skipped.add(unit["index"])
        else:
            would_render.append(unit)

    if would_render:
        first = would_render[0]
        extra = ({"loras": [(l["path"], l["strength"]) for l in first["loras"]]}
                 if first.get("loras") else {})
        cmd = SKILL.build_command(
            prompt=first["prompt"], output_path=first["clip_path"],
            image_path=first["image_path"], width=args.width, height=args.height,
            num_frames=args.frames, frame_rate=args.frame_rate, seed=first["seed"],
            model=args.model, gemma=args.gemma, lora_path=args.lora_path,
            low_ram=(not args.no_low_ram),
            tile_frames=args.tile_frames, tile_spatial=args.tile_spatial, **extra)
        print("first render command: %s" % shlex.join(cmd))
    else:
        print("first render command: (none; all panels would be skipped)")

    if args.resume:
        print("resume: %d panel(s) would be skipped: %r"
              % (len(would_skip), [u["index"] for u in would_skip]))
        print("resume: %d panel(s) would render: %r"
              % (len(would_render), [u["index"] for u in would_render]))

    secs, label = estimate_seconds_per_panel(
        story_dir_for(story_id), args.frames, args.width, args.height,
        (not args.no_low_ram), args.tile_frames, args.tile_spatial, args.model)
    for line in format_estimate_lines(secs, label, len(would_render), total_panels):
        print(line)

    return 0


def run_input_content_screen(image_paths):
    """Screen every input image in ONE throwaway subprocess, so this process
    never imports content_safety (or torch by extension). Ported from
    bin/ltx-story-video::_run_input_content_screen (:644-670); the only
    change is the skill label in the log line. Prints SCREEN_OK <path> per
    pass; the child exits 3 on the first ContentSafetyError. Returns the
    child's exit code (0 when there is nothing to screen)."""
    if not image_paths:
        return 0
    script = (
        "import sys\n"
        "sys.path.insert(0, %r)\n"
        "import content_safety\n"
        "from PIL import Image\n"
        "for p in sys.argv[1:]:\n"
        "    img = Image.open(p).convert('RGB')\n"
        "    try:\n"
        "        content_safety.assert_image_safe(img, skill='ltx-mlx-render', prompt=p)\n"
        "    except content_safety.ContentSafetyError as e:\n"
        "        print('SCREEN_BLOCKED %%s: %%s' %% (p, e))\n"
        "        sys.exit(3)\n"
        "    print('SCREEN_OK %%s' %% p)\n"
    ) % WS
    proc = subprocess.run(
        [sys.executable, "-c", script] + image_paths,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    print(proc.stdout)
    return proc.returncode


def render_panel(unit, args):
    """Render one panel and return its result dict.

    Keys: unit, status, attempts, seconds, clip, resumed -- plus rc/error/
    jetsam on failure. status is one of "ok", "error", "timeout", "invalid".

    force=True is passed into the skill unconditionally: the render script
    only gets here when it has already DECIDED to regenerate (either
    --resume was off, or the existing clip failed the reuse check), so the
    skill's own overwrite guard must not veto that decision."""
    started = time.monotonic()
    base = {"unit": unit["label"], "attempts": 1, "resumed": False}
    provenance_path = unit["clip_path"] + ".provenance.json"
    try:
        if os.path.lexists(provenance_path):
            os.unlink(provenance_path)
        expected_provenance = build_clip_provenance(unit, args, strict=True)
    except OSError as error:
        print("panel %d FAILED (provenance): %s" % (unit["index"], error), file=sys.stderr)
        base.update({"status": "error", "clip": None, "error": str(error),
                     "seconds": round(time.monotonic() - started, 1)})
        return base
    try:
        extra = ({"loras": [(l["path"], l["strength"]) for l in unit["loras"]]}
                 if unit.get("loras") else {})
        clip = SKILL.generate_video(
            unit["prompt"], unit["clip_path"], image_path=unit["image_path"],
            width=args.width, height=args.height, num_frames=args.frames,
            frame_rate=args.frame_rate, seed=unit["seed"], model=args.model,
            gemma=args.gemma, lora_path=args.lora_path,
            low_ram=(not args.no_low_ram), tile_frames=args.tile_frames,
            tile_spatial=args.tile_spatial, log_path=unit["log_path"],
            timeout_s=args.panel_timeout, force=True, **extra)
    except ValueError as e:
        print("panel %d FAILED (invalid): %s" % (unit["index"], e), file=sys.stderr)
        base.update({"status": "invalid", "clip": None, "error": str(e),
                     "seconds": round(time.monotonic() - started, 1)})
        return base
    except SKILL.Ltx2MlxError as e:
        status = "timeout" if e.timed_out else "error"
        print("panel %d FAILED (%s, rc=%s): %s"
              % (unit["index"], status, e.returncode, e), file=sys.stderr)
        base.update({"status": status, "clip": None, "rc": e.returncode,
                     "error": str(e), "seconds": round(time.monotonic() - started, 1)})
        if getattr(e, "fatal", False):
            base["fatal"] = True
        elif e.returncode == 0 and not e.timed_out:
            base["jetsam"] = True
            print(JETSAM_LADDER, file=sys.stderr)
        return base

    try:
        if clip_frame_count(clip) != args.frames:
            raise ConcatPreflightError("clip %s: frame count did not match %d" % (clip, args.frames))
        assert_clips_uniform([(clip, probe_streams(clip))], args.width, args.height, args.frame_rate)
        provenance = build_clip_provenance(unit, args, strict=True)
        if expected_provenance["model_identity"] is None:
            provenance["model_identity"] = None
        if provenance != expected_provenance:
            raise ConcatPreflightError("generation inputs or model metadata changed during rendering")
        write_clip_provenance(clip, expected_provenance)
    except (ConcatPreflightError, OSError) as error:
        print("panel %d FAILED (verification): %s" % (unit["index"], error), file=sys.stderr)
        base.update({"status": "error", "clip": None, "error": str(error),
                     "seconds": round(time.monotonic() - started, 1)})
        return base

    elapsed = round(time.monotonic() - started, 1)
    print("panel %d ok: %s (%.1fs)" % (unit["index"], clip, elapsed))
    base.update({"status": "ok", "clip": clip, "seconds": elapsed})
    return base


def finish_run(args, raw_argv, manifest, units, unit_results, clips_by_index,
               completed, stopped_reason, run_root, story_id):
    """Retry pass -> concat -> story_summary.json -> exit code.

    story_summary.json is written on every path this function returns
    from -- a failed concat and a run where zero panels completed both
    still write it. The concat block therefore catches OSError as well
    as ConcatPreflightError: a vanished ffmpeg or a full disk must
    degrade to exit 1 with a summary on disk, not to a traceback with
    none. Do not narrow that except clause back.

    The consumer this protects is NOT bin/ltx-movie::_report_summary --
    phase4_render returns the moment the render exits non-zero
    (bin/ltx-movie:681-683) and never reaches the summary read on any
    failure path. It is estimate_seconds_per_panel above, which globs
    <story_dir>/runs/*/story_summary.json regardless of how each run
    exited, so a partial or failed run still teaches the next --dry-run
    its measured per-panel wall clock.

    The invariant is scoped to this function. An exception escaping
    render_panel -- in main's loop or in the retry pass below -- unwinds
    past it before the write. render_panel maps only ValueError and
    Ltx2MlxError, so an OSError, a MemoryError or a Ctrl-C leaves
    run_root without a summary."""
    # --- retry pass (opt-in). Never runs when the main loop already stopped, and never
    # for a chained manifest: its failures were already retried inline, in order.
    failed = [u for u in units
              if unit_results[u["index"]]["status"] not in ("ok", "not_attempted")]
    if (args.retry_failed and failed and stopped_reason is None
            and not any(u.get("conditioning") == "chain" for u in units)):
        print("=== retry pass: %d panel(s) ===" % len(failed))
        print(", ".join(u["label"] for u in failed))
        print("retrying in %.0fs..." % args.retry_idle)
        time.sleep(args.retry_idle)
        for unit in failed:
            i = unit["index"]
            prior_status = unit_results[i]["status"]
            result = render_panel(unit, args)
            result["attempts"] = 2
            result["first_failure"] = prior_status
            unit_results[i] = result
            if result.get("fatal"):
                stopped_reason = "backend_failure"
                break
            if result["status"] == "ok":
                clips_by_index[i] = result["clip"]
                completed += 1

    ordered_clips = [clips_by_index[u["index"]] for u in units
                     if u["index"] in clips_by_index]
    skipped_panels = [u["index"] for u in units if u["index"] not in clips_by_index]

    wrote_output = False
    concat_failed = False
    if ordered_clips:
        list_path = os.path.join(run_root, "concat_list.txt")
        try:
            pairs = [(c, probe_streams(c)) for c in ordered_clips]
            assert_clips_uniform(pairs, args.width, args.height, args.frame_rate)
            with open(list_path, "w") as f:
                f.write(build_concat_list(ordered_clips))
            cmd = build_concat_command(list_path, args.output_path)
            print("Running: %s" % shlex.join(cmd))
            proc = subprocess.run(cmd, stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, text=True)
            if proc.returncode != 0:
                tail = "\n".join((proc.stdout or "").splitlines()[-40:])
                raise ConcatPreflightError(
                    "ffmpeg concat failed (rc=%d); clips and %s are preserved\n%s"
                    % (proc.returncode, list_path, tail))
            wrote_output = True
            size_kb = os.path.getsize(args.output_path) // 1024
            duration = len(ordered_clips) * args.frames / float(args.frame_rate)
            print("MOVIE %d/%d panels, %d frames, %.2fs -> %s (%dKB)"
                  % (completed, len(units), len(ordered_clips) * args.frames,
                     duration, args.output_path, size_kb))
        except (ConcatPreflightError, OSError) as e:
            concat_failed = True
            print("Error: %s" % e, file=sys.stderr)
    else:
        print("No panels completed; no output written.")

    summary = {
        "schema_version": 3,
        "backend": "ltx-2-mlx",
        "story_id": story_id,
        "manifest_path": os.path.abspath(args.manifest_path),
        "manifest_schema_version": manifest.get("schema_version", 1),
        "model": args.model,
        "width": args.width,
        "height": args.height,
        "frames_per_panel": args.frames,
        "fps": args.frame_rate,
        "low_ram": (not args.no_low_ram),
        "tile_frames": args.tile_frames,
        "tile_spatial": args.tile_spatial,
        "requested_units": len(units),
        "completed_units": completed,
        "intended_total_frames": len(units) * args.frames,
        "actual_total_frames": completed * args.frames,
        "units": [unit_results[u["index"]] for u in units],
        "clips": ordered_clips,
        "skipped_panels": skipped_panels,
        "concat_mode": "demux-copy",
        "output_path": os.path.abspath(args.output_path) if wrote_output else None,
        "on_panel_failure": args.on_panel_failure,
        "stopped_reason": stopped_reason,
    }
    with open(os.path.join(run_root, "story_summary.json"), "w") as f:
        json.dump(summary, f, indent=2)

    if concat_failed:
        return 1
    if completed == len(units) and wrote_output:
        print("DONE: all %d panels completed -> %s" % (len(units), args.output_path))
        return 0
    print("STOPPED EARLY: %d/%d panels completed" % (completed, len(units)))
    if stopped_reason in ("consecutive_failures", "chain_broken"):
        print("relaunch: %s %s %s"
              % (sys.executable, os.path.abspath(__file__),
                 " ".join(shlex.quote(a) for a in raw_argv)))
    return 1


def main(argv=None):
    raw_argv = argv if argv is not None else sys.argv[1:]
    args = build_parser().parse_args(argv)

    geo_error = validate_cli_geometry(args)
    if geo_error:
        print("Error: %s" % geo_error, file=sys.stderr)
        return 2

    try:
        manifest = load_manifest(args.manifest_path)
    except (OSError, ValueError, json.JSONDecodeError) as e:
        print("Error: %s" % e, file=sys.stderr)
        return 2
    panels = manifest["panels"]

    # A chained manifest (any panel conditioned on the previous clip's last frame) cannot
    # skip a failed panel: the next one would have no frame to continue from. Checked
    # before the --dry-run short-circuit so the Phase 3 review gate refuses it too.
    chain_manifest = any(p["conditioning"] == "chain" for p in panels)
    if chain_manifest and args.on_panel_failure == "skip":
        print("Error: --on-panel-failure skip is not allowed for a chained manifest: a "
              "skipped panel leaves the next panel with no frame to continue from",
              file=sys.stderr)
        return 2

    specs = getattr(args, "lora_path_specs", None) or []
    try:
        parsed = [SKILL.parse_lora_spec(v) for v in specs]
    except ValueError as e:
        print("Error: --lora: %s" % e, file=sys.stderr)
        return 2
    cast_entries = [(p["index"], c) for p in panels for c in (p.get("characters") or [])]
    args.global_loras = []
    if len(parsed) == 1 and parsed[0][1] == 1.0 and not cast_entries:
        args.lora_path = parsed[0][0]                       # legacy route (5.7.2)
    elif parsed:
        args.lora_path = None
        seen = {}
        for path, strength, _explicit in parsed:
            if not os.path.isfile(path) or not os.access(path, os.R_OK):
                print("Error: --lora %s: not a readable file" % path, file=sys.stderr)
                return 2
            real = os.path.realpath(path)
            if real in seen:
                print("Error: --lora %s is given more than once" % path, file=sys.stderr)
                return 2
            seen[real] = path
            args.global_loras.append({"path": os.path.abspath(path), "strength": strength})
        for index, c in cast_entries:
            real = os.path.realpath(c["video_lora"])
            if real in seen:
                print("Error: --lora %s is also character %s's video LoRA (panel %d); pass it "
                      "once" % (seen[real], c["name"], index), file=sys.stderr)
                return 2

    story_id = manifest.get("story_id") or "story"
    story_dir = story_dir_for(story_id)
    clips_dir = args.clips_dir or os.path.join(story_dir, "clips")

    # Hoisted ABOVE the --dry-run short-circuit on purpose. These three are
    # pure reads -- they touch nothing, so they honor "--dry-run resolves
    # everything, touches nothing" (spec 6.9) -- and --dry-run is the human
    # review gate that bin/ltx-movie Phase 3 shows before Phase 4 renders.
    # A dry run that reports a clean plan and is then followed by an instant
    # exit 2 on an output path it already had in hand is the wrong gate.
    # The ffmpeg/ffprobe and ltx-2-mlx checks below stay BELOW the
    # short-circuit: a dry run must stay usable on a host that cannot render.
    if not args.output_path.endswith(".mp4"):
        print("Error: OUTPUT_MP4 must end in .mp4: %s" % args.output_path, file=sys.stderr)
        return 2
    out_dir = os.path.dirname(os.path.abspath(args.output_path)) or "."
    if not os.path.isdir(out_dir) or not os.access(out_dir, os.W_OK):
        print("Error: output directory not writable: %s" % out_dir, file=sys.stderr)
        return 2
    if os.path.exists(args.output_path) and not args.force:
        print("Error: output already exists: %s (use --force to overwrite)"
              % args.output_path, file=sys.stderr)
        return 2

    if args.dry_run:
        units = build_units(panels, args.seed, clips_dir, global_loras=args.global_loras)
        return print_dry_run(args, manifest, units, story_id, clips_dir)

    for tool in ("ffmpeg", "ffprobe"):
        if shutil.which(tool) is None:
            print("Error: %s not found on PATH" % tool, file=sys.stderr)
            return 2
    resolved_bin = SKILL._resolve_bin()
    if not os.path.isfile(resolved_bin) or not os.access(resolved_bin, os.X_OK):
        print("Error: ltx-2-mlx binary not found or not executable: %s "
              "(set LTX2_MLX_BIN)" % resolved_bin, file=sys.stderr)
        return 2

    # v3 still-aspect preflight: a still whose aspect differs from --width x --height
    # would be center-cropped by ltx-2-mlx's resize_and_center_crop. Refused here,
    # before any GPU time.
    if manifest.get("schema_version", 1) >= 3:
        for panel in panels:
            if panel["conditioning"] != "still":
                continue
            size, error = ffprobe_image_size(panel["image_path"])
            if error:
                print("Error: panel %d's still %s: ffprobe failed: %s"
                      % (panel["index"], panel["image_path"], error), file=sys.stderr)
                return 2
            if size[0] * args.height != size[1] * args.width:
                print("Error: panel %d's still %s is %dx%d; its aspect ratio does not match "
                      "--width x --height (%dx%d), so ltx-2-mlx would crop it"
                      % (panel["index"], panel["image_path"], size[0], size[1],
                         args.width, args.height), file=sys.stderr)
                return 2

    try:
        os.makedirs(clips_dir, exist_ok=True)
    except OSError as e:
        print("Error: cannot create --clips-dir %s: %s" % (clips_dir, e), file=sys.stderr)
        return 2
    if not os.access(clips_dir, os.W_OK):
        print("Error: --clips-dir is not writable: %s" % clips_dir, file=sys.stderr)
        return 2

    if not args.skip_input_screen:
        unique_images = []
        seen = set()
        for panel in panels:
            p = panel.get("image_path")
            if p and p not in seen:
                seen.add(p)
                unique_images.append(p)
        rc = run_input_content_screen(unique_images)
        if rc != 0:
            print("Error: input image content screen failed (rc=%d); refusing to run "
                  "(no GPU time spent). Pass --skip-input-screen to bypass." % rc,
                  file=sys.stderr)
            return 1

    run_id = new_run_id()
    run_root = os.path.join(story_dir, "runs", run_id)
    os.makedirs(run_root)
    print("run root: %s" % run_root)
    print("clips dir: %s" % clips_dir)

    units = build_units(panels, args.seed, clips_dir, run_root, global_loras=args.global_loras)

    # ORDER-SAFE: keyed on unit index, never appended in loop order, because
    # the retry pass fills these in out of order (only failed panels, in
    # their own subset order) -- list-append ordering would silently
    # scramble the movie.
    unit_results = {}
    clips_by_index = {}
    completed = 0
    consecutive_failures = 0
    stopped_reason = None

    for unit in units:
        i = unit["index"]
        if args.resume and clip_is_reusable(
                unit["clip_path"], args.frames, build_clip_provenance(unit, args)):
            print("panel %d: reusing %s (--resume)" % (i, unit["clip_path"]))
            unit_results[i] = {"unit": unit["label"], "status": "ok", "attempts": 0,
                               "seconds": 0.0,
                               "clip": os.path.abspath(unit["clip_path"]),
                               "resumed": True}
            clips_by_index[i] = os.path.abspath(unit["clip_path"])
            completed += 1
            consecutive_failures = 0
            continue

        print("=== panel %d/%d (%s) ===" % (i, len(units), unit["label"]))

        if unit["conditioning"] == "chain":
            seed_violations = prepare_chain_seed(unit, args)
            if seed_violations:
                for v in seed_violations:
                    print("panel %d FAILED (chain seed): %s" % (i, v), file=sys.stderr)
                unit_results[i] = {"unit": unit["label"], "status": "chain_seed_invalid",
                                   "attempts": 0, "seconds": 0.0, "clip": None,
                                   "resumed": False, "error": "; ".join(seed_violations)}
                stopped_reason = "chain_seed_invalid"
                break
            if not args.skip_input_screen:
                screen_rc = run_input_content_screen([unit["image_path"]])
                if screen_rc != 0:
                    error = ("input content screen rejected %s (rc=%d)"
                             % (unit["image_path"], screen_rc))
                    print("panel %d FAILED (chain seed): %s" % (i, error), file=sys.stderr)
                    unit_results[i] = {"unit": unit["label"], "status": "chain_seed_blocked",
                                       "attempts": 0, "seconds": 0.0, "clip": None,
                                       "resumed": False, "error": error}
                    stopped_reason = "chain_seed_blocked"
                    break

        result = render_panel(unit, args)
        unit_results[i] = result

        if result["status"] == "ok":
            clips_by_index[i] = result["clip"]
            completed += 1
            consecutive_failures = 0
            continue

        if result.get("fatal"):
            stopped_reason = "backend_failure"
            break

        if chain_manifest:
            # Every later panel depends on this clip, so a chained failure is retried
            # inline (never deferred to the end-of-run pass) and then stops the run; the
            # skip policy and the consecutive-failure breaker are not consulted.
            if args.retry_failed:
                print("=== inline retry: panel %d (chained; later panels depend on it) ===" % i)
                time.sleep(args.retry_idle)
                retry = render_panel(unit, args)
                retry["attempts"] = 2
                retry["first_failure"] = result["status"]
                unit_results[i] = retry
                if retry.get("fatal"):
                    stopped_reason = "backend_failure"
                    break
                if retry["status"] == "ok":
                    clips_by_index[i] = retry["clip"]
                    completed += 1
                    continue
            stopped_reason = "chain_broken"
            break

        consecutive_failures += 1
        # Checked in the same order as bin/ltx-story-video:927-929: the stop
        # policy wins first, then the consecutive-failure circuit breaker.
        if args.on_panel_failure == "stop":
            stopped_reason = "panel_failure"
            break
        if (args.max_consecutive_failures > 0
                and consecutive_failures >= args.max_consecutive_failures):
            stopped_reason = "consecutive_failures"
            break

    for unit in units:
        if unit["index"] not in unit_results:
            unit_results[unit["index"]] = {
                "unit": unit["label"], "status": "not_attempted", "attempts": 0,
                "seconds": 0.0, "clip": None, "resumed": False}

    return finish_run(args, raw_argv, manifest, units, unit_results, clips_by_index,
                      completed, stopped_reason, run_root, story_id)


if __name__ == "__main__":
    try:
        _rc = main()
    except KeyboardInterrupt:
        _rc = 130
    sys.exit(_rc)
